<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LabelMaker.App</RootNamespace>
    <AssemblyName>LabelAxis</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\installer\assets\icon.ico</ApplicationIcon>
    <Description>LabelAxis desktop application (WPF, Windows).</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LabelMaker.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where this build looks for updates: build\installer.ps1 -UpdateUrl https://… -->
    <AssemblyMetadata Include="UpdateFeed" Value="$(UpdateFeedUrl)" Condition="'$(UpdateFeedUrl)' != ''" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishReadyToRun)' == 'true'">
    <!--
      Compiled ahead of time: LabelAxis's own code and what it draws with, so it starts quickly.
      Left as they are: the large libraries used only when importing Excel files or reading a
      database. They are compiled the moment they are first used, and keeping them small makes
      the download a good deal smaller.
    -->
    <PublishReadyToRunExclude Include="DocumentFormat.OpenXml.dll;DocumentFormat.OpenXml.Framework.dll;ClosedXML.dll;ClosedXML.Parser.dll;ExcelNumberFormat.dll;RBush.dll;SixLabors.Fonts.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Data.SqlClient.dll;Npgsql.dll;MySqlConnector.dll;System.Data.OleDb.dll;System.Data.Odbc.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Identity.Client.dll;Microsoft.IdentityModel.Abstractions.dll;Azure.Identity.dll;Azure.Core.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- Licences that must travel with the app: its own, third-party notices, and every bundled font's. -->
    <None Include="..\..\LICENSE" Link="licenses\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="licenses\THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\OFL-LICENSE.txt" Link="licenses\fonts\PlusJakartaSans-DMMono-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\Arabic\*-OFL.txt" Link="licenses\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The help guide's pages (Help window, F1). -->
    <EmbeddedResource Include="Help\*.md" LogicalName="LabelAxis.Help.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Help\ar\*.md" LogicalName="LabelAxis.Help.ar.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Help\ckb\*.md" LogicalName="LabelAxis.Help.ckb.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Help\fa\*.md" LogicalName="LabelAxis.Help.fa.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Help\fr\*.md" LogicalName="LabelAxis.Help.fr.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Help\es\*.md" LogicalName="LabelAxis.Help.es.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Help\nl\*.md" LogicalName="LabelAxis.Help.nl.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Help\ru\*.md" LogicalName="LabelAxis.Help.ru.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Help\zh-Hans\*.md" LogicalName="LabelAxis.Help.zh-Hans.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Help\hi\*.md" LogicalName="LabelAxis.Help.hi.%(Filename)%(Extension)" />
    <!-- Interface languages: English text → translation (Settings › Language). -->
    <EmbeddedResource Include="Languages\*.json" LogicalName="LabelAxis.Languages.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabelMaker.Core\LabelMaker.Core.csproj" />
    <ProjectReference Include="..\LabelMaker.Export\LabelMaker.Export.csproj" />
    <ProjectReference Include="..\LabelMaker.Data\LabelMaker.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\installer\assets\icon.ico" Condition="Exists('..\..\installer\assets\icon.ico')" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\Fonts\**\*.ttf" Condition="Exists('Assets\Fonts')" />
  </ItemGroup>

</Project>
