<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LabelMaker.App</RootNamespace>
    <AssemblyName>LabelAxis</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\installer\assets\icon.ico</ApplicationIcon>
    <Description>LabelAxis desktop application (WPF, Windows).</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <!-- Licences that must travel with the app: its own, third-party notices, and every bundled font's. -->
    <None Include="..\..\LICENSE" Link="licenses\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="licenses\THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\OFL-LICENSE.txt" Link="licenses\fonts\PlusJakartaSans-DMMono-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\Arabic\*-OFL.txt" Link="licenses\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The help guide's pages (Help window, F1). -->
    <EmbeddedResource Include="Help\*.md" LogicalName="LabelAxis.Help.%(Filename)%(Extension)" />
    <!-- Interface languages: English text → translation (Settings › Language). -->
    <EmbeddedResource Include="Languages\*.json" LogicalName="LabelAxis.Languages.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabelMaker.Core\LabelMaker.Core.csproj" />
    <ProjectReference Include="..\LabelMaker.Export\LabelMaker.Export.csproj" />
    <ProjectReference Include="..\LabelMaker.Data\LabelMaker.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\installer\assets\icon.ico" Condition="Exists('..\..\installer\assets\icon.ico')" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\Fonts\**\*.ttf" Condition="Exists('Assets\Fonts')" />
  </ItemGroup>

</Project>
