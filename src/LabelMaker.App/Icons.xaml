<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shared line-icon pen: simple 24x24-grid stroke icons for the ribbon toolbar. -->
  <Pen x:Key="IconPen" Brush="#FF5A4FE3" Thickness="1.8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
  <SolidColorBrush x:Key="IconFill" Color="#FF5A4FE3" />

  <DrawingImage x:Key="Icon.New">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <PathGeometry Figures="M7,3 L15,3 L19,7 L19,21 L7,21 Z M15,3 L15,7 L19,7 M10,12 L16,12 M10,16 L14,16" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Open">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <PathGeometry Figures="M3,7 L9,7 L11,9 L21,9 L21,19 L3,19 Z" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Save">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <PathGeometry Figures="M4,4 L17,4 L20,7 L20,20 L4,20 Z M7,4 L7,9 L16,9 L16,4 M7,14 L17,14 L17,20" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Undo">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <PathGeometry Figures="M9,5 L4,10 L9,15 M4,10 L15,10 A6,6 0 0 1 15,22 L9,22" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Redo">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <PathGeometry Figures="M15,5 L20,10 L15,15 M20,10 L9,10 A6,6 0 0 0 9,22 L15,22" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Cut">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <GeometryGroup>
            <PathGeometry Figures="M7,6 L20,17 M7,18 L20,7" />
            <EllipseGeometry Center="5.5,6" RadiusX="1.8" RadiusY="1.8" />
            <EllipseGeometry Center="5.5,18" RadiusX="1.8" RadiusY="1.8" />
          </GeometryGroup>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Copy">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <GeometryGroup>
            <RectangleGeometry Rect="3,3,12,12" RadiusX="2" RadiusY="2" />
            <RectangleGeometry Rect="9,9,12,12" RadiusX="2" RadiusY="2" />
          </GeometryGroup>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Paste">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <GeometryGroup>
            <RectangleGeometry Rect="5,4,14,17" RadiusX="2" RadiusY="2" />
            <RectangleGeometry Rect="9,2,6,4" RadiusX="1" RadiusY="1" />
            <PathGeometry Figures="M9,11 L15,11 M9,15 L15,15" />
          </GeometryGroup>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Delete">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <PathGeometry Figures="M4,7 L20,7 M9,4 L15,4 L15,7 M6,7 L7,21 L17,21 L18,7 M10,11 L10,18 M14,11 L14,18" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Text">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <PathGeometry Figures="M5,7 L19,7 M5,12 L19,12 M5,17 L14,17" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Barcode">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <PathGeometry Figures="M4,4 L4,20 M7,4 L7,20 M9,4 L9,20 M12,4 L12,20 M14,4 L14,20 M17,4 L17,20 M19,4 L19,20" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Image">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <GeometryGroup>
            <RectangleGeometry Rect="3,4,18,16" RadiusX="2" RadiusY="2" />
            <EllipseGeometry Center="8,9" RadiusX="1.6" RadiusY="1.6" />
            <PathGeometry Figures="M4,18 L9,12 L13,16 L16,13 L20,18" />
          </GeometryGroup>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Rectangle">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="4,6,16,12" RadiusX="2" RadiusY="2" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Ellipse">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <EllipseGeometry Center="12,12" RadiusX="8" RadiusY="6" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Line">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <GeometryGroup>
            <PathGeometry Figures="M5,19 L19,5" />
            <EllipseGeometry Center="5,19" RadiusX="1.3" RadiusY="1.3" />
            <EllipseGeometry Center="19,5" RadiusX="1.3" RadiusY="1.3" />
          </GeometryGroup>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Import">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <PathGeometry Figures="M12,3 L12,14 M8,10 L12,14 L16,10 M5,18 L5,20 L19,20 L19,18" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Layers">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <PathGeometry Figures="M12,4 L20,8 L12,12 L4,8 Z M4,13 L12,17 L20,13" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Checklist">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <GeometryGroup>
            <RectangleGeometry Rect="5,4,14,16" RadiusX="2" RadiusY="2" />
            <PathGeometry Figures="M7,9 L9,11 L12,7 M13,9 L17,9 M7,15 L9,17 L12,13 M13,15 L17,15" />
          </GeometryGroup>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Eye">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <GeometryGroup>
            <PathGeometry Figures="M2,12 C2,12 6,5 12,5 C18,5 22,12 22,12 C22,12 18,19 12,19 C6,19 2,12 2,12 Z" />
            <EllipseGeometry Center="12,12" RadiusX="2.5" RadiusY="2.5" />
          </GeometryGroup>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Sliders">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Pen="{StaticResource IconPen}">
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M4,7 L20,7 M4,12 L20,12 M4,17 L20,17" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource IconFill}">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <EllipseGeometry Center="9,7" RadiusX="2" RadiusY="2" />
              <EllipseGeometry Center="15,12" RadiusX="2" RadiusY="2" />
              <EllipseGeometry Center="7,17" RadiusX="2" RadiusY="2" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Lock">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <GeometryGroup>
            <RectangleGeometry Rect="5,11,14,10" RadiusX="2" RadiusY="2" />
            <PathGeometry Figures="M8,11 L8,7 A4,4 0 0 1 16,7 L16,11" />
          </GeometryGroup>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Unlock">
