      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <GeometryGroup>
            <RectangleGeometry Rect="5,11,14,10" RadiusX="2" RadiusY="2" />
            <PathGeometry Figures="M8,11 L8,7 A4,4 0 0 1 15.6,5.3" />
          </GeometryGroup>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="Icon.Print">
    <DrawingImage.Drawing>
      <GeometryDrawing Pen="{StaticResource IconPen}">
        <GeometryDrawing.Geometry>
          <PathGeometry Figures="M8,4 L16,4 L16,9 L8,9 Z M5,9 L19,9 L19,16 L5,16 Z M8,16 L16,16 L16,21 L8,21 Z" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
