<Window x:Class="LabelMaker.App.Views.WelcomeWindow"
        xmlns:helpsvc="clr-namespace:LabelMaker.App.Services"
        helpsvc:HelpGuide.Topic="getting-started"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LabelMaker.App.Localization"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="Welcome to LabelAxis" Height="700" Width="1020" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="StartAction" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Card" CornerRadius="10" Padding="14,11" Background="{DynamicResource Br.Bg}"
                    BorderBrush="{DynamicResource Br.Border}" BorderThickness="1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Br.AccentSoft}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- footer -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Br.Bg}"
            BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,1,0,0" Padding="20,11">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Start with a blank label" Style="{StaticResource GhostButton}" IsCancel="True"
                Click="OnBlank" />
        <CheckBox x:Name="ShowAtStartBox" Content="Show this window when LabelAxis starts" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- actions -->
    <Border DockPanel.Dock="Left" Width="340" Background="{DynamicResource Br.Bg}"
            BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="22,22,22,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,22">
          <Image Source="pack://application:,,,/LabelAxis;component/Assets/logo.png" Width="44" Height="44" Margin="0,0,12,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontFamily="{StaticResource Font.UiExtraBold}" FontSize="22" loc:Localizer.Off="True" FlowDirection="LeftToRight">
              <Run Text="Label" /><Run Text="Axis" Foreground="{DynamicResource Br.Accent}" />
            </TextBlock>
            <TextBlock Text="PRECISION LABEL STUDIO" FontSize="9.5" FontFamily="{StaticResource Font.UiSemiBold}"
                       Foreground="{DynamicResource Br.Text2}" Margin="1,0,0,3" />
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource Br.TextMuted}" />
          </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="START" Style="{StaticResource PanelSectionHeader}" />
        <StackPanel>
          <Button Style="{StaticResource StartAction}" Click="OnNewFromDesign" AutomationProperties.AutomationId="Welcome.NewFromDesign">
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Br.AccentSoft}" Margin="0,0,12,0">
                <Image Source="{StaticResource Icon.Sticker}" Width="17" Height="17" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Start from a design…" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="13" />
                <TextBlock Text="Price tags, food, shipping and more" FontSize="11.5" Foreground="{DynamicResource Br.TextMuted}" />
              </StackPanel>
            </DockPanel>
          </Button>
          <Button Style="{StaticResource StartAction}" Click="OnNewFromTemplate">
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Br.AccentSoft}" Margin="0,0,12,0">
                <Image Source="{StaticResource Icon.Sheet}" Width="17" Height="17" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="New from a label sheet…" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="13" />
                <TextBlock Text="Formtec and other A4 sheets" FontSize="11.5" Foreground="{DynamicResource Br.TextMuted}" />
              </StackPanel>
            </DockPanel>
          </Button>
          <Button Style="{StaticResource StartAction}" Click="OnNewThermal">
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Br.AccentSoft}" Margin="0,0,12,0">
                <Image Source="{StaticResource Icon.Barcode}" Width="17" Height="17" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="New thermal label…" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="13" />
                <TextBlock Text="Rolls for Zebra, TSC, Xprinter" FontSize="11.5" Foreground="{DynamicResource Br.TextMuted}" />
              </StackPanel>
            </DockPanel>
          </Button>
          <Button Style="{StaticResource StartAction}" Click="OnOpen">
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Br.AccentSoft}" Margin="0,0,12,0">
                <Image Source="{StaticResource Icon.Open}" Width="17" Height="17" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Open a project…" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="13" />
                <TextBlock Text="A .labelproj file" FontSize="11.5" Foreground="{DynamicResource Br.TextMuted}" />
              </StackPanel>
            </DockPanel>
          </Button>
          <Button Style="{StaticResource StartAction}" Click="OnPublisher">
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Br.AccentSoft}" Margin="0,0,12,0">
                <Image Source="{StaticResource Icon.FileDoc}" Width="17" Height="17" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Import from Publisher…" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="13" />
                <TextBlock Text="Bring in the pages of a .pub file" FontSize="11.5" Foreground="{DynamicResource Br.TextMuted}" />
              </StackPanel>
            </DockPanel>
          </Button>
          <Button Style="{StaticResource StartAction}" Click="OnLabelManager">
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Br.AccentSoft}" Margin="0,0,12,0">
                <Image Source="{StaticResource Icon.Gallery}" Width="17" Height="17" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Browse all templates…" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="13" />
                <TextBlock Text="Brands, sizes and sheet previews" FontSize="11.5" Foreground="{DynamicResource Br.TextMuted}" />
              </StackPanel>
            </DockPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- recent + quick sheets -->
    <Grid Margin="22,22,22,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0">
        <TextBlock DockPanel.Dock="Top" Text="RECENT PROJECTS" Style="{StaticResource PanelSectionHeader}" />
        <Grid>
          <ListBox x:Name="RecentList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                   MouseDoubleClick="OnRecentDoubleClick" KeyDown="OnRecentKeyDown"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Card" CornerRadius="8" Padding="12,9" Background="Transparent">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Card" Property="Background" Value="{DynamicResource Br.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Card" Property="Background" Value="{DynamicResource Br.AccentSoft}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <Image DockPanel.Dock="Left" Source="{StaticResource Icon.FileDoc}" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding When}" FontSize="12" Foreground="{DynamicResource Br.TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Folder}" FontSize="11.5" Foreground="{DynamicResource Br.TextMuted}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="NoRecent" Text="Projects you save or open will be listed here." Visibility="Collapsed"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Br.TextMuted}" />
        </Grid>
      </DockPanel>

      <StackPanel Grid.Row="1" Margin="0,14,0,0">
        <TextBlock Text="START WITH A SHEET" Style="{StaticResource PanelSectionHeader}" />
        <ItemsControl x:Name="QuickSheets">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Margin="0,0,8,0" Cursor="Hand" Click="OnQuickSheet" ToolTip="{Binding Tooltip}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Card" CornerRadius="10" Padding="8" Background="{DynamicResource Br.Bg}"
                            BorderBrush="{DynamicResource Br.Border}" BorderThickness="1">
                      <StackPanel>
                        <Border Height="96" Background="{DynamicResource CanvasBackground}" CornerRadius="6">
                          <ContentControl Content="{Binding Preview}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Code}" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="12" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Size}" FontSize="11" Foreground="{DynamicResource Br.TextMuted}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
