<Window x:Class="LabelMaker.App.Views.PublisherImportWindow"
        xmlns:helpsvc="clr-namespace:LabelMaker.App.Services"
        helpsvc:HelpGuide.Topic="export"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LabelMaker.App.Localization"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="Import from Publisher" Height="680" Width="1000" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>

    <!-- header -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Br.Bg}"
            BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,0,0,1" Padding="18,14">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0"
                Background="{DynamicResource Br.AccentSoft}">
          <Image Source="{DynamicResource Icon.FileDoc}" Width="18" Height="18" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="HeaderTitle" Text="Import from Publisher" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="15" />
          <TextBlock x:Name="HeaderSubtitle" FontSize="12" Foreground="{DynamicResource Br.TextMuted}" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- notes -->
    <Border x:Name="NoteBar" DockPanel.Dock="Top" Background="#FFF6E5" BorderBrush="#F2D29B" BorderThickness="0,0,0,1"
            Padding="18,9" Visibility="Collapsed">
      <TextBlock x:Name="NoteText" TextWrapping="Wrap" FontSize="12" Foreground="#7A4B00" />
    </Border>

    <!-- footer -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Br.Bg}"
            BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,1,0,0" Padding="18,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource PrimaryButton}" IsCancel="True" Margin="12,0,0,0" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Br.Text2}"
                   Text="Tick the text and pictures to bring in. Layout, fonts and positions are not imported." />
      </DockPanel>
    </Border>

    <Grid Margin="18,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <!-- text -->
      <DockPanel Grid.Column="0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="All" Style="{StaticResource GhostButton}" Padding="10,3" Margin="0,0,4,0" Click="OnAllText" />
            <Button Content="None" Style="{StaticResource GhostButton}" Padding="10,3" Click="OnNoText" />
          </StackPanel>
          <TextBlock x:Name="TextHeader" Text="TEXT" Style="{StaticResource PanelSectionHeader}" VerticalAlignment="Center" Margin="0" />
        </DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,10,0,0">
          <StackPanel>
            <WrapPanel>
              <Button Content="Add as text boxes" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Click="OnAddText"
                      ToolTip="One text box on the label for each ticked text box" />
              <Button Content="Use as records" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Click="OnUseRecords"
                      ToolTip="One record per ticked paragraph, for variable-data printing" />
            </WrapPanel>
            <WrapPanel>
              <CheckBox x:Name="SplitTabsBox" Content="Split into fields at tabs" Margin="0,0,16,0" IsChecked="True" />
              <CheckBox x:Name="HeaderRowBox" Content="First paragraph names the fields" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource InsetPanel}" Padding="0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
            <ItemsControl x:Name="StoryList" loc:Localizer.Off="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,12">
                    <CheckBox IsChecked="{Binding IsChecked}" IsThreeState="False" Margin="0,0,0,4">
                      <TextBlock FontFamily="{StaticResource Font.UiSemiBold}" FontSize="12.5">
                        <Run Text="{Binding Title, Mode=OneWay}" />
                        <Run Text="{Binding Summary, Mode=OneWay}" Foreground="{DynamicResource Br.TextMuted}" FontFamily="{StaticResource Font.Ui}" />
                      </TextBlock>
                    </CheckBox>
                    <ItemsControl ItemsSource="{Binding Paragraphs}" Margin="22,0,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2" VerticalContentAlignment="Top">
                            <TextBlock Text="{Binding Display}" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"
                                       FontSize="12.5" ToolTip="{Binding Text}" />
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>

      <!-- pictures -->
      <DockPanel Grid.Column="2">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="All" Style="{StaticResource GhostButton}" Padding="10,3" Margin="0,0,4,0" Click="OnAllPictures" />
            <Button Content="None" Style="{StaticResource GhostButton}" Padding="10,3" Click="OnNoPictures" />
          </StackPanel>
          <TextBlock x:Name="PictureHeader" Text="PICTURES" Style="{StaticResource PanelSectionHeader}" VerticalAlignment="Center" Margin="0" />
        </DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,10,0,0">
          <WrapPanel>
            <Button Content="Add to label" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnAddPictures" />
            <Button Content="Save pictures…" Style="{StaticResource GhostButton}" Click="OnSavePictures"
                    ToolTip="Save the ticked pictures as files in a folder" />
          </WrapPanel>
        </Border>
        <Border Style="{StaticResource InsetPanel}" Padding="0">
          <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
              <ItemsControl x:Name="PictureList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="150" Margin="0,0,10,10" CornerRadius="8" Padding="8" Background="{DynamicResource Br.Bg}"
                            BorderBrush="{DynamicResource Br.Border}" BorderThickness="1">
                      <StackPanel>
                        <Border Height="100" Background="{DynamicResource CanvasBackground}" CornerRadius="4">
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" />
                        </Border>
                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,6,0,0">
                          <TextBlock Text="{Binding Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        </CheckBox>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="NoPictures" Text="No pictures found" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Br.TextMuted}" Visibility="Collapsed" />
          </Grid>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
