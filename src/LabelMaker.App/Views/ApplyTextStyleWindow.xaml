<Window x:Class="LabelMaker.App.Views.ApplyTextStyleWindow"
        xmlns:controls="clr-namespace:LabelMaker.App.Controls"
        xmlns:helpsvc="clr-namespace:LabelMaker.App.Services"
        helpsvc:HelpGuide.Topic="text"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="Apply formatting to other pages" Height="640" Width="500" MinHeight="480" MinWidth="440"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnApply" />
      </StackPanel>
      <TextBlock x:Name="SummaryText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                 FontFamily="{StaticResource Font.UiSemiBold}" FontSize="12.5" Foreground="{DynamicResource Br.Accent}" />
    </DockPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="COPY FROM" Style="{StaticResource PanelSectionHeader}" />
        <Border Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,0,0,14">
          <TextBlock x:Name="SourceText" TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <TextBlock Text="WHAT TO COPY" Style="{StaticResource PanelSectionHeader}" />
        <Border Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,0,0,14">
          <StackPanel>
            <CheckBox x:Name="FontBox" Content="Font" IsChecked="True" Margin="0,3" Click="OnChanged" />
            <CheckBox x:Name="SizeBox" Content="Font size" IsChecked="True" Margin="0,3" Click="OnChanged" />
            <CheckBox x:Name="StyleBox" Content="Bold, italic, underline and strikethrough" IsChecked="True" Margin="0,3" Click="OnChanged" />
            <CheckBox x:Name="ColourBox" Content="Text colour and highlight" IsChecked="True" Margin="0,3" Click="OnChanged" />
            <CheckBox x:Name="AlignmentBox" Content="Alignment (left / centre / right, top / middle / bottom)" Margin="0,3" Click="OnChanged" />
            <CheckBox x:Name="SpacingBox" Content="Line spacing and letter spacing" Margin="0,3" Click="OnChanged" />
          </StackPanel>
        </Border>

        <TextBlock Text="WHICH TEXT BOXES" Style="{StaticResource PanelSectionHeader}" />
        <Border Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,0,0,14">
          <StackPanel>
            <RadioButton x:Name="SameNameBox" GroupName="targets" IsChecked="True" Margin="0,3" Click="OnChanged" />
            <RadioButton x:Name="EveryTextBox" GroupName="targets" Margin="0,3" Click="OnChanged"
                         Content="Every text box on the pages ticked below" />
          </StackPanel>
        </Border>

        <TextBlock Text="WHICH PAGES" Style="{StaticResource PanelSectionHeader}" />
        <Border Style="{StaticResource InsetPanel}" Padding="12,10">
          <controls:PageChecklist x:Name="Pages" Changed="OnChanged" />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
