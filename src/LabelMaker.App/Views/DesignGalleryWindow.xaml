<Window x:Class="LabelMaker.App.Views.DesignGalleryWindow"
        xmlns:helpsvc="clr-namespace:LabelMaker.App.Services"
        xmlns:views="clr-namespace:LabelMaker.App.Views"
        helpsvc:HelpGuide.Topic="getting-started"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="Start from a design" Height="760" Width="1160" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterOwner">
  <Grid>
    <views:DesignGalleryView x:Name="Gallery" />
    <!-- On the gallery's bottom strip, beside the fill choice. -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,14">
        <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="UseButton" Content="Use this design" Style="{StaticResource PrimaryButton}" IsDefault="True"
                Click="OnUse" AutomationProperties.AutomationId="Designs.Use" />
      </StackPanel>
  </Grid>
</Window>
