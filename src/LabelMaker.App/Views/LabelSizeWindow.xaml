<Window x:Class="LabelMaker.App.Views.LabelSizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="Label size" Height="430" Width="430" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="Apply size" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnApply" />
    </StackPanel>

    <StackPanel>
      <TextBlock Text="CURRENT LABEL" Style="{StaticResource PanelSectionHeader}" />
      <Border Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,0,0,14">
        <TextBlock x:Name="CurrentText" TextWrapping="Wrap" FontSize="12.5" />
      </Border>

      <TextBlock Text="NEW SIZE" Style="{StaticResource PanelSectionHeader}" />
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Width" Style="{StaticResource FieldLabel}" Width="46" />
        <TextBox   Grid.Column="1" x:Name="WidthBox" Style="{StaticResource NumberBox}" />
        <TextBlock Grid.Column="3" Text="Height" Style="{StaticResource FieldLabel}" Width="46" />
        <TextBox   Grid.Column="4" x:Name="HeightBox" Style="{StaticResource NumberBox}" />
        <ComboBox  Grid.Column="6" x:Name="UnitBox" Width="72" SelectionChanged="OnUnitChanged" />
      </Grid>

      <CheckBox x:Name="ScaleObjects" Content="Scale the objects to match the new size" Margin="0,0,0,8" />
      <CheckBox x:Name="AllPages" Content="Apply to every page in the project" IsChecked="True" Margin="0,0,0,8" />
      <CheckBox x:Name="RefitSheet" IsChecked="True" Margin="0,0,0,6"
                Content="Re-fit the sheet grid to this label size" />
      <TextBlock x:Name="SheetNote" TextWrapping="Wrap" FontSize="11.5"
                 Foreground="{DynamicResource Br.TextMuted}" Margin="24,0,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
