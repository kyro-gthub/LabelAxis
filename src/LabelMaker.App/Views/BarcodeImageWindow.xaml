<Window x:Class="LabelMaker.App.Views.BarcodeImageWindow"
        xmlns:helpsvc="clr-namespace:LabelMaker.App.Services"
        helpsvc:HelpGuide.Topic="barcodes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="Barcode image generator" Height="440" Width="700" MinWidth="640" WindowStartupLocation="CenterOwner">
  <Grid Margin="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="Symbology" Margin="0,4,10,4" VerticalAlignment="Center" />
    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="SymbologyBox" Margin="0,4" />

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Value" Margin="0,4,10,4" VerticalAlignment="Center" />
    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="ValueBox" Margin="0,4" Text="ABC001459" />

    <TextBlock Grid.Row="2" Grid.Column="0" Text="Module (mm)" Margin="0,4,10,4" VerticalAlignment="Center" />
    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="ModuleBox" Margin="0,4" Text="0.33" />

    <TextBlock Grid.Row="3" Grid.Column="0" Text="Bar height (mm)" Margin="0,4,10,4" VerticalAlignment="Center" />
    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="HeightBox" Margin="0,4" Text="15" />

    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
      <CheckBox x:Name="HriBox" Content="Human-readable text" IsChecked="True" Margin="0,0,12,0" />
      <CheckBox x:Name="TransparentBox" Content="Transparent background" />
    </StackPanel>

    <!-- live preview of the symbol as it will be saved -->
    <Border Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8" BorderBrush="{DynamicResource Br.Border}" BorderThickness="1"
            CornerRadius="8" Background="{DynamicResource CanvasBackground}">
      <DockPanel Margin="10">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Br.TextMuted}" />
        <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="NearestNeighbor" />
      </DockPanel>
    </Border>

    <!-- Wraps onto a second line when the names are long (as in Kurdish). -->
    <WrapPanel Grid.Row="6" Grid.ColumnSpan="2" HorizontalAlignment="Right">
      <StackPanel Orientation="Horizontal" Margin="0,4,8,0">
        <TextBlock Text="PNG quality" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox x:Name="DpiBox" MinWidth="92" ToolTip="Dots per inch of the saved picture: more is sharper and bigger">
          <ComboBoxItem Content="150 dpi" Tag="150" />
          <ComboBoxItem Content="300 dpi" Tag="300" IsSelected="True" />
          <ComboBoxItem Content="600 dpi" Tag="600" />
          <ComboBoxItem Content="1200 dpi" Tag="1200" />
        </ComboBox>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <Button Content="Save PNG…" Padding="14,4" Margin="0,0,8,0" Click="OnSavePng" />
        <Button Content="Save SVG…" Padding="14,4" Click="OnSaveSvg" />
        <Button Content="Save PDF…" Padding="14,4" Margin="8,0,0,0" Click="OnSavePdf" />
        <Button Content="Close" Padding="14,4" Margin="8,0,0,0" IsCancel="True" />
      </StackPanel>
    </WrapPanel>
  </Grid>
</Window>
