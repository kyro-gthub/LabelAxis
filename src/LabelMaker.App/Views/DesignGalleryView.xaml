<UserControl x:Class="LabelMaker.App.Views.DesignGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The ready-made designs: groups and search on one side, a card for each design, and how
       to fill the one chosen. Shown in the New Project window and in "Start from a design". -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Br.Bg}" BorderBrush="{DynamicResource Br.Border}"
            BorderThickness="0,1,0,0" Padding="18,12,300,12">
      <DockPanel>
        <StackPanel VerticalAlignment="Center">
        <RadioButton x:Name="SampleWordsBox" GroupName="fill" IsChecked="True" Margin="0,2"
                     Content="Sample words, ready to type over" />
        <RadioButton x:Name="DataFieldsBox" GroupName="fill" Margin="0,2"
                     Content="Data fields such as {Product} and {Price}, to print from a spreadsheet" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Groups -->
    <Border DockPanel.Dock="Left" Width="250" Background="{DynamicResource Br.Bg}"
            BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource SearchField}" Margin="14,14,14,10">
          <DockPanel>
            <Image DockPanel.Dock="Left" Source="{DynamicResource Icon.Search}" Width="15" Height="15" Margin="2,0,8,0" />
            <TextBox x:Name="SearchBox" Style="{StaticResource PlainTextBox}" Tag="Search designs…"
                     TextChanged="OnSearch" AutomationProperties.AutomationId="Designs.Search" />
          </DockPanel>
        </Border>
        <ListBox x:Name="GroupList" Style="{StaticResource SidebarList}" Margin="8,0,8,8"
                 SelectionChanged="OnGroup" AutomationProperties.AutomationId="Designs.Groups">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource SidebarItem}" />
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource Br.TextMuted}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- The designs -->
    <DockPanel Margin="18,14,8,0">
      <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="16" Margin="2,0,0,2" />
      <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Br.TextMuted}" FontSize="12" Margin="2,0,0,10" TextWrapping="Wrap"
                 Text="Each design opens as a new project on its own label sheet or roll. Change the words, put in your logo, and print." />
      <TextBlock x:Name="NothingText" DockPanel.Dock="Top" Visibility="Collapsed" Margin="2,20,0,0" Foreground="{DynamicResource Br.TextMuted}"
                 Text="No design matches. Try another word, or look in All designs." />
      <ListBox x:Name="DesignList" BorderThickness="0" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnDesignSelected"
               AutomationProperties.AutomationId="Designs.List">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <EventSetter Event="MouseDoubleClick" Handler="OnDesignDoubleClick" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Card" Width="244" CornerRadius="10" Padding="10" Background="{DynamicResource Br.Bg}"
                          BorderBrush="{DynamicResource Br.Border}" BorderThickness="1">
                    <StackPanel>
                      <Border Height="150" CornerRadius="7" Background="{DynamicResource Br.Surface2}" Margin="0,0,0,9">
                        <Image Source="{Binding Thumbnail}" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                      </Border>
                      <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="13" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding SizeText}" FontSize="11.5" Foreground="{DynamicResource Br.Accent}" Margin="0,2,0,3" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource Br.TextMuted}" TextWrapping="Wrap"
                                 Height="32" TextTrimming="WordEllipsis" />
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Br.BorderStrong}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
                      <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                      <Setter TargetName="Card" Property="Padding" Value="9" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
    </DockPanel>
  </DockPanel>
</UserControl>
