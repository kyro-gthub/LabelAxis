<Window x:Class="LabelMaker.App.Views.CustomThemeWindow"
        xmlns:helpsvc="clr-namespace:LabelMaker.App.Services"
        helpsvc:HelpGuide.Topic="getting-started"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LabelMaker.App.Localization"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="Make your own theme" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <!-- The user's own theme: a theme to start from, its colours and glow. Everything in LabelAxis
       changes as the colours do; Cancel puts the theme back as it was. -->
  <DockPanel Margin="18">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <Button x:Name="RemoveButton" DockPanel.Dock="Left" Content="Remove my theme" Style="{StaticResource GhostButton}" Click="OnRemove"
              ToolTip="Delete your own theme and go back to the one it started from" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
        <Button Content="Save theme" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave"
                AutomationProperties.AutomationId="CustomTheme.Save" />
      </StackPanel>
    </DockPanel>

    <StackPanel>
      <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Br.Text2}" Margin="0,0,0,14"
                 Text="Choose the colours: LabelAxis changes as you do, so you can see them at once. Text colours are chosen for you so they always read." />

      <DockPanel Margin="0,0,0,10">
        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Width="130" />
        <TextBox x:Name="NameBox" loc:Localizer.Off="True" />
      </DockPanel>
      <DockPanel Margin="0,0,0,14">
        <TextBlock Text="Start from" Style="{StaticResource FieldLabel}" Width="130" />
        <ComboBox x:Name="BaseBox" ItemTemplate="{StaticResource ThemeRow}" SelectionChanged="OnBase" MinHeight="46"
                  ToolTip="Its text and panel colours are kept; light or dark comes from it" />
      </DockPanel>

      <TextBlock Text="COLOURS" Style="{StaticResource PanelSectionHeader}" />
      <Border Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,0,0,14">
        <StackPanel x:Name="ColourRows" />
      </Border>

      <TextBlock Text="GLOW" Style="{StaticResource PanelSectionHeader}" />
      <Border Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,0,0,8">
        <DockPanel>
          <TextBlock x:Name="GlowText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                     loc:Localizer.Off="True" />
          <Slider x:Name="GlowSlider" Minimum="0" Maximum="150" SmallChange="5" LargeChange="25" ValueChanged="OnGlow"
                  ToolTip="How strong the soft colour glows behind the panels are" />
        </DockPanel>
      </Border>
      <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Br.Danger}" />
    </StackPanel>
  </DockPanel>
</Window>
