<Window x:Class="LabelMaker.App.Views.RemoveFromPagesWindow"
        xmlns:helpsvc="clr-namespace:LabelMaker.App.Services"
        helpsvc:HelpGuide.Topic="pages"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="Remove from all pages" Height="640" Width="540" MinHeight="460" MinWidth="460"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="RemoveButton" AutomationProperties.AutomationId="RemoveFromPages.Remove" Content="Remove"
                Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnRemove" />
      </StackPanel>
      <TextBlock x:Name="SummaryText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                 FontFamily="{StaticResource Font.UiSemiBold}" FontSize="12.5" Foreground="{DynamicResource Br.Accent}" />
    </DockPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="WHICH OBJECTS" Style="{StaticResource PanelSectionHeader}" />
        <Border Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock x:Name="ObjectsText" TextWrapping="Wrap" Margin="0,3" />
            <CheckBox x:Name="ThisPageBox" Content="Also remove it from this page" IsChecked="True" Margin="0,8,0,3" Click="OnChanged" />
            <TextBlock Text="Match each one on the other pages by" Margin="0,10,0,2" FontSize="12" Foreground="{DynamicResource Br.TextMuted}" />
            <RadioButton x:Name="NameThenOrderBox" GroupName="match" IsChecked="True" Margin="0,3" Click="OnChanged"
                         Content="Its name, or else its order (recommended)" />
            <RadioButton x:Name="SameNameBox" GroupName="match" Margin="0,3" Click="OnChanged"
                         Content="Its name (pages copied from this one keep the names)" />
            <RadioButton x:Name="SameOrderBox" GroupName="match" Margin="0,3" Click="OnChanged"
                         Content="Its order: 1st text to 1st text, 2nd barcode to 2nd barcode…" />
            <TextBlock Text="Locked objects are never removed. Undo (Ctrl+Z) puts everything back."
                       TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Br.TextMuted}" />
          </StackPanel>
        </Border>

        <TextBlock Text="WHICH PAGES" Style="{StaticResource PanelSectionHeader}" />
        <Border Style="{StaticResource InsetPanel}" Padding="12,10">
          <StackPanel>
            <StackPanel x:Name="PageList" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Tick all" Style="{StaticResource GhostButton}" Padding="10,3" Margin="0,0,6,0" Click="OnTickAll" />
              <Button Content="Untick all" Style="{StaticResource GhostButton}" Padding="10,3" Click="OnUntickAll" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
