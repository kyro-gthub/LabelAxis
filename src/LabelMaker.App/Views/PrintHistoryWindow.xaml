<Window x:Class="LabelMaker.App.Views.PrintHistoryWindow"
        xmlns:helpsvc="clr-namespace:LabelMaker.App.Services"
        helpsvc:HelpGuide.Topic="printing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="Print history" Height="640" Width="940" MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <SolidColorBrush x:Key="Status.Completed" Color="#1F9D55" />
    <SolidColorBrush x:Key="Status.Cancelled" Color="#D98A00" />
    <SolidColorBrush x:Key="Status.Failed" Color="#D64545" />
  </Window.Resources>

  <DockPanel>

    <!-- header -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Br.Bg}"
            BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,0,0,1" Padding="18,14">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0"
                Background="{DynamicResource Br.AccentSoft}">
          <Image Source="{DynamicResource Icon.Clock}" Width="18" Height="18" />
        </Border>
        <Button DockPanel.Dock="Right" Content="Clear history…" Style="{StaticResource GhostButton}"
                VerticalAlignment="Center" Click="OnClear" />
        <ComboBox x:Name="FilterBox" DockPanel.Dock="Right" Width="150" Margin="0,0,10,0" VerticalAlignment="Center"
                  SelectionChanged="OnFilterChanged">
          <ComboBoxItem Content="All jobs" IsSelected="True" />
          <ComboBoxItem Content="Printed" />
          <ComboBoxItem Content="PDF exports" />
          <ComboBoxItem Content="Stopped or failed" />
        </ComboBox>
        <Border DockPanel.Dock="Right" Style="{StaticResource SearchField}" Width="240" Margin="0,0,10,0"
                VerticalAlignment="Center">
          <DockPanel>
            <Image DockPanel.Dock="Left" Source="{DynamicResource Icon.Search}" Width="15" Height="15" Margin="2,0,8,0" />
            <TextBox x:Name="SearchBox" Style="{StaticResource PlainTextBox}" Tag="Project, printer, sheet…"
                     TextChanged="OnSearchChanged" />
          </DockPanel>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Print history" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="15" />
          <TextBlock x:Name="HeaderSubtitle" FontSize="12" Foreground="{DynamicResource Br.TextMuted}" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- footer -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Br.Bg}"
            BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,1,0,0" Padding="18,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Close" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
          <Button x:Name="RemainingButton" Content="Print remaining sheets…" Style="{StaticResource GhostButton}"
                  Margin="0,0,8,0" Click="OnPrintRemaining"
                  ToolTip="Opens the print dialog set to the sheets this job never sent" />
          <Button x:Name="ReprintButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnReprint"
                  ToolTip="Opens the print dialog with this job's settings">
            <StackPanel Orientation="Horizontal">
              <Image Source="{DynamicResource Icon.PrintWhite}" Width="15" Height="15" Margin="0,0,7,0" />
              <TextBlock Text="Reprint…" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="OpenFileButton" Content="Open PDF" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                  Click="OnOpenFile" />
          <Button x:Name="RemoveButton" Content="Remove from history" Style="{StaticResource GhostButton}"
                  Click="OnRemove" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- details -->
    <Border DockPanel.Dock="Right" Width="320" Background="{DynamicResource Br.Bg}"
            BorderBrush="{DynamicResource Br.Border}" BorderThickness="1,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" x:Name="DetailPanel">
          <TextBlock Text="JOB" Style="{StaticResource PanelSectionHeader}" />
          <Border Style="{StaticResource InsetPanel}" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
              <DockPanel>
                <Ellipse x:Name="DetailDot" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="DetailStatus" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="13" />
              </DockPanel>
              <TextBlock x:Name="DetailError" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                         Foreground="{StaticResource Status.Failed}" />
              <TextBlock x:Name="DetailWhen" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource Br.Text2}" />
            </StackPanel>
          </Border>
          <TextBlock Text="DETAILS" Style="{StaticResource PanelSectionHeader}" />
          <Border Style="{StaticResource InsetPanel}" Padding="14,10">
            <Grid x:Name="DetailGrid">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
            </Grid>
          </Border>
          <TextBlock x:Name="DataWarning" TextWrapping="Wrap" FontSize="12" Margin="2,12,0,0"
                     Foreground="{StaticResource Status.Cancelled}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- job list -->
    <Grid>
      <ListBox x:Name="JobList" BorderThickness="0" Background="Transparent" Padding="10,8"
               HorizontalContentAlignment="Stretch" SelectionChanged="OnSelectionChanged"
               MouseDoubleClick="OnListDoubleClick"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Card" CornerRadius="8" Padding="12,9" Background="Transparent"
                          BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Card" Property="Background" Value="{DynamicResource Br.Hover}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Card" Property="Background" Value="{DynamicResource Br.AccentSoft}" />
                      <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,5,12,0" VerticalAlignment="Top"
                       Fill="{Binding StatusBrush}" />
              <TextBlock DockPanel.Dock="Right" Text="{Binding WhenShort}" FontSize="12" Margin="12,1,0,0"
                         Foreground="{DynamicResource Br.TextMuted}" />
              <StackPanel>
                <TextBlock FontFamily="{StaticResource Font.UiSemiBold}" FontSize="13" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Title, Mode=OneWay}" />
                  <Run Text="{Binding StatusSuffix, Mode=OneWay}" Foreground="{Binding StatusBrush, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Line}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Br.Text2}" />
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
        <Image Source="{DynamicResource Icon.Clock}" Width="34" Height="34" Opacity="0.5" />
        <TextBlock x:Name="EmptyText" Margin="0,10,0,0" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                   MaxWidth="320" Foreground="{DynamicResource Br.TextMuted}" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
