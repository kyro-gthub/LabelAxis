<Window x:Class="LabelMaker.App.Views.FieldAsBarcodeWindow"
        xmlns:helpsvc="clr-namespace:LabelMaker.App.Services"
        helpsvc:HelpGuide.Topic="data"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="Add a field to the label" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="18">
    <TextBlock x:Name="IntroText" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,12" />

    <TextBlock Text="ADD IT AS" Style="{StaticResource PanelSectionHeader}" />
    <Border Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,0,0,14">
      <StackPanel>
        <RadioButton x:Name="BarcodeBox" GroupName="kind" IsChecked="True" Margin="0,3" Click="OnChanged"
                     Content="A barcode" AutomationProperties.AutomationId="FieldAs.Barcode" />
        <DockPanel Margin="24,4,0,3">
          <TextBlock Text="Type" Style="{StaticResource FieldLabel}" Width="44" />
          <ComboBox x:Name="TypeBox" DisplayMemberPath="Display" SelectionChanged="OnChanged"
                    AutomationProperties.AutomationId="FieldAs.Type" />
        </DockPanel>
        <TextBlock x:Name="FitText" Margin="24,4,0,4" TextWrapping="Wrap" FontSize="12" />
        <RadioButton x:Name="AsTextBox" GroupName="kind" Margin="0,6,0,3" Click="OnChanged"
                     Content="Text (the value as it is written)" AutomationProperties.AutomationId="FieldAs.Text" />
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="Add" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnAdd"
              AutomationProperties.AutomationId="FieldAs.Add" />
    </StackPanel>
  </StackPanel>
</Window>
