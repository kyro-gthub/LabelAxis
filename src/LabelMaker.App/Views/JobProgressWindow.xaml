<Window x:Class="LabelMaker.App.Views.JobProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="Working" Height="230" Width="460" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="ToolWindow">
  <DockPanel Margin="20,18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCancel" />
    </StackPanel>
    <StackPanel>
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0"
                Background="{DynamicResource Br.AccentSoft}">
          <Image x:Name="Glyph" Source="{StaticResource Icon.Print}" Width="18" Height="18" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="Heading" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="14" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="Detail" FontSize="12" Foreground="{DynamicResource Br.TextMuted}" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>
      <ProgressBar x:Name="Bar" Height="8" Margin="0,18,0,6" Minimum="0" Maximum="1" />
      <TextBlock x:Name="Remaining" FontSize="11.5" Foreground="{DynamicResource Br.TextMuted}" />
    </StackPanel>
  </DockPanel>
</Window>
