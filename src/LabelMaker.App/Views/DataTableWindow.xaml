<Window x:Class="LabelMaker.App.Views.DataTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="Data table" Height="560" Width="900" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <Border DockPanel.Dock="Top" Padding="0,0,0,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Ellipse Width="8" Height="8" Fill="{DynamicResource Br.Ok}" VerticalAlignment="Center" Margin="0,0,7,0" />
          <TextBlock x:Name="Summary" VerticalAlignment="Center" FontSize="12.5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Content="Import CSV/XLSX…" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnImport" />
          <Button Content="Add field…" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnAddField" />
          <Button Content="Generate barcodes…" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnBulkBarcode" />
          <Button Content="Go to record" Style="{StaticResource GhostButton}" Click="OnGoToRecord" />
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Close" Style="{StaticResource PrimaryButton}" IsCancel="True" />
    </StackPanel>

    <Grid>
      <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                CanUserAddRows="False" SelectionMode="Single"
                Background="Transparent" BorderThickness="1"
                BorderBrush="{DynamicResource Br.Border}">
        <DataGrid.InputBindings>
          <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding GoToRecord, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataGrid.InputBindings>
      </DataGrid>
      <TextBlock x:Name="Empty" Text="No data source connected — use Import CSV/XLSX to load records."
                 Foreground="{DynamicResource Br.TextMuted}" FontSize="12.5"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
  </DockPanel>
</Window>
