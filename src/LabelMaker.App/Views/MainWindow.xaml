<Window x:Class="LabelMaker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LabelMaker.App.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctl="clr-namespace:LabelMaker.App.Controls"
        xmlns:local="clr-namespace:LabelMaker.App.Views"
        Title="LabelAxis" Height="860" Width="1480" MinHeight="560" MinWidth="880"
        Icon="pack://application:,,,/LabelAxis;component/Assets/icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource LA.Brush.Background}"
        TextElement.Foreground="{DynamicResource Br.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>

  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
    <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateCommand}" />
    <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
    <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutCommand}" />
    <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
    <KeyBinding Key="G" Modifiers="Control" Command="{Binding GroupCommand}" />
    <KeyBinding Key="G" Modifiers="Control+Shift" Command="{Binding UngroupCommand}" />
    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
    <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}" />
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding FindCommand}" />
    <KeyBinding Key="T" Modifiers="Control+Shift" Command="{Binding FreeTransformCommand}" />
    <KeyBinding Key="H" Modifiers="Control" Command="{Binding FindReplaceCommand}" />
    <KeyBinding Key="T" Modifiers="Control" Command="{Binding DataTableCommand}" />
    <KeyBinding Key="F5" Command="{Binding RefreshDataCommand}" />
    <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}" />
    <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}" />
    <KeyBinding Key="PageDown" Modifiers="Control" Command="{Binding NextTabCommand}" />
    <KeyBinding Key="PageUp" Modifiers="Control" Command="{Binding PreviousTabCommand}" />
    <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}" />
    <KeyBinding Key="F4" Modifiers="Control" Command="{Binding CloseTabCommand}" />
    <KeyBinding Key="F2" Command="{Binding RenamePageCommand}" />
    <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding PrintPreviewCommand}" />
    <KeyBinding Key="L" Modifiers="Control" Command="{Binding ToggleObjectLockCommand}" />
    <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
    <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ZoomActualCommand}" />
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ZoomFitCommand}" />
    <KeyBinding Key="B" Modifiers="Control" Command="{Binding BringToFrontCommand}" />
    <KeyBinding Key="B" Modifiers="Control+Shift" Command="{Binding SendToBackCommand}" />
  </Window.InputBindings>

  <Grid>
  <!-- Soft glows of the theme's colours behind everything: what the see-through panels frost over. -->
  <Grid IsHitTestVisible="False" ClipToBounds="True">
    <Ellipse Width="720" Height="720" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,120,0,0"
             Fill="{DynamicResource LA.Brush.Orb1}" Opacity="{DynamicResource LA.OrbOpacity}" />
    <Ellipse Width="460" Height="460" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-160,0,0"
             Fill="{DynamicResource LA.Brush.Orb3}" Opacity="{DynamicResource LA.OrbOpacitySoft}" />
    <Ellipse Width="800" Height="800" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-360"
             Fill="{DynamicResource LA.Brush.Orb2}" Opacity="{DynamicResource LA.OrbOpacity}" />
  </Grid>
  <DockPanel x:Name="Root">

    <!-- ═════════════ Title bar ═════════════ -->
    <Border DockPanel.Dock="Top" Height="46" Background="Transparent">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <!-- The product logo itself, not a stand-in glyph on a gradient tile. -->
          <Image Source="pack://application:,,,/LabelAxis;component/Assets/logo.png" Width="28" Height="28" Margin="0,0,10,0"
                 RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
          <TextBlock VerticalAlignment="Center" FontSize="15.5" Margin="0,0,22,0" loc:Localizer.Off="True" FlowDirection="LeftToRight">
            <!-- One line: a line break between the runs would put a space in the name. -->
            <Run Text="Label" FontFamily="{StaticResource Font.UiExtraBold}" Foreground="{DynamicResource Br.Text}" /><Run Text="Axis" FontFamily="{StaticResource Font.UiExtraBold}" Foreground="{DynamicResource Br.Accent}" />
          </TextBlock>

          <Menu Background="Transparent" VerticalAlignment="Center">
            <MenuItem AutomationProperties.AutomationId="Menu.File" Header="_File">
              <MenuItem AutomationProperties.AutomationId="Menu.NewProject" Header="_New Project…" InputGestureText="Ctrl+N" Command="{Binding NewCommand}" />
              <MenuItem AutomationProperties.AutomationId="Menu.NewFromDesign" Header="New from a _design…" Command="{Binding NewFromDesignCommand}" />
              <MenuItem Header="New _thermal label…" Command="{Binding NewThermalLabelCommand}" />
              <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" />
              <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentProjects}">
                <MenuItem.ItemContainerStyle>
                  <Style TargetType="MenuItem">
                    <Setter Property="loc:Localizer.Off" Value="True" />
                    <Setter Property="Header" Value="{Binding Title}" />
                    <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Setter Property="CommandParameter" Value="{Binding Path}" />
                  </Style>
                </MenuItem.ItemContainerStyle>
              </MenuItem>
              <Separator />
              <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
              <MenuItem Header="Save _As…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
              <MenuItem AutomationProperties.AutomationId="Menu.SaveAsDesign" Header="Save page as _my design…"
                        Command="{Binding SaveAsDesignCommand}"
                        ToolTip="Keep this page to start new labels from: it appears first in New Project, under My designs" />
              <Separator />
              <MenuItem Header="Open _Publisher file (all pages)…" Command="{Binding OpenPublisherPagesCommand}" />
              <MenuItem Header="_Import text and pictures from Publisher…" Command="{Binding ImportPublisherCommand}" />
              <Separator />
              <MenuItem AutomationProperties.AutomationId="Menu.LabelManager" Header="_Label manager…" Command="{Binding TemplateManagerCommand}" />
              <MenuItem Header="Label si_ze…" Command="{Binding LabelSizeCommand}" />
              <Separator />
              <MenuItem AutomationProperties.AutomationId="Menu.Settings" Header="Se_ttings…" Command="{Binding SettingsCommand}" />
              <Separator />
              <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>

            <MenuItem AutomationProperties.AutomationId="Menu.Edit" Header="_Edit">
              <MenuItem AutomationProperties.AutomationId="Menu.Undo" Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
              <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
              <Separator />
              <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Command="{Binding CutCommand}" />
              <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}" />
              <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" />
              <MenuItem Header="_Duplicate" InputGestureText="Ctrl+D" Command="{Binding DuplicateCommand}" />
              <MenuItem Header="De_lete" InputGestureText="Del" Command="{Binding DeleteCommand}" />
              <MenuItem Header="Select _all" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
              <Separator />
              <MenuItem Header="_Find…" InputGestureText="Ctrl+F" Command="{Binding FindCommand}" />
              <MenuItem AutomationProperties.AutomationId="Menu.FindReplace" Header="Find and _replace…" InputGestureText="Ctrl+H" Command="{Binding FindReplaceCommand}" />
              <MenuItem Header="Apply text _formatting to other pages…" Command="{Binding ApplyTextStyleCommand}" />
              <MenuItem AutomationProperties.AutomationId="Menu.PageFormat" Header="Apply page f_ormat to other pages…" Command="{Binding ApplyLayoutCommand}"
                        ToolTip="Give the objects on other pages the place, size and look they have on this page" />
              <MenuItem AutomationProperties.AutomationId="Menu.RemoveFromPages" Header="Remove from all _pages…" Command="{Binding RemoveFromAllPagesCommand}"
                        ToolTip="Take the selected objects, such as a barcode or a named text box, off this page and the other pages" />
              <Separator />
              <MenuItem Header="_Group" InputGestureText="Ctrl+G" Command="{Binding GroupCommand}" />
              <MenuItem Header="U_ngroup" InputGestureText="Ctrl+Shift+G" Command="{Binding UngroupCommand}" />
              <MenuItem Header="_Lock / unlock" InputGestureText="Ctrl+L" Command="{Binding ToggleObjectLockCommand}" />
              <Separator />
              <MenuItem Header="Rotate 90° _right" Command="{Binding RotateCommand}" CommandParameter="90" />
              <MenuItem Header="Rotate 90° _left" Command="{Binding RotateCommand}" CommandParameter="-90" />
              <MenuItem Header="Flip _horizontal" Command="{Binding FlipHorizontalCommand}" />
              <MenuItem Header="Flip _vertical" Command="{Binding FlipVerticalCommand}" />
            </MenuItem>

            <MenuItem AutomationProperties.AutomationId="Menu.Data" Header="D_ata">
              <MenuItem Header="_Import CSV / Excel…" Command="{Binding ImportDataCommand}" />
              <MenuItem Header="Connect to _database…" Command="{Binding ConnectDatabaseCommand}" />
              <MenuItem Header="_Edit connection…" Command="{Binding EditConnectionCommand}" />
              <MenuItem Header="_Refresh records" InputGestureText="F5" Command="{Binding RefreshDataCommand}" />
              <MenuItem Header="_Records…" InputGestureText="Ctrl+T" Command="{Binding DataTableCommand}" />
              <MenuItem Header="_Clear data source" Command="{Binding ClearDataCommand}" />
              <Separator />
              <MenuItem Header="Manage _sequences…" Command="{Binding SequencesCommand}" />
              <MenuItem Header="Duplicate _check…" Command="{Binding DuplicateCheckCommand}" />
              <Separator />
              <MenuItem Header="_Bulk Barcode Generator…" Command="{Binding BulkBarcodeCommand}" />
              <MenuItem Header="Barcode i_mage…" Command="{Binding BarcodeImageCommand}" />
              <MenuItem AutomationProperties.AutomationId="Menu.BarcodeCheck" Header="Chec_k a printed barcode (camera or photo)…"
                        Command="{Binding BarcodeCheckCommand}"
                        ToolTip="Grade a printed barcode A to F from a webcam, a photo or a scan, and see what to change" />
              <MenuItem AutomationProperties.AutomationId="Menu.Gs1" Header="_GS1 barcode builder (expiry, batch, UDI)…"
                        Command="{Binding Gs1BuilderCommand}"
                        ToolTip="GS1-128, GS1 DataMatrix and GS1 QR codes for food, medicines, medical devices and shipping, checked as you type" />
              <Separator />
              <MenuItem Header="Add _data field…" Command="{Binding AddDataFieldCommand}" />
              <MenuItem Header="Add date / time field" Command="{Binding AddDateFieldCommand}" />
            </MenuItem>

            <MenuItem AutomationProperties.AutomationId="Menu.Print" Header="_Print">
              <MenuItem AutomationProperties.AutomationId="Menu.PrintDialog" Header="_Print…" InputGestureText="Ctrl+P" Command="{Binding PrintCommand}" />
              <MenuItem Header="_Advanced Print Settings…" Command="{Binding PrintSettingsCommand}" />
              <MenuItem Header="Print Pre_view…" Command="{Binding PrintPreviewCommand}" />
              <MenuItem Header="Print _History…" Command="{Binding PrintHistoryCommand}" />
              <MenuItem AutomationProperties.AutomationId="Menu.Automation" Header="Print requests from other _programs…"
                        Command="{Binding AutomationCommand}"
                        ToolTip="Let a till, an online shop or a spreadsheet print labels: a watch folder and a web link on this PC" />
              <MenuItem Header="_Thermal print (ZPL / TSPL)…" Command="{Binding ThermalPrintCommand}" />
              <MenuItem Header="Printer _Calibration Wizard…" Command="{Binding CalibrationCommand}" />
              <Separator />
              <MenuItem Header="Pre_flight check…" Command="{Binding PreflightCommand}" />
              <Separator />
              <MenuItem Header="_Export">
                <MenuItem Header="Sheet to PDF…" Command="{Binding ExportSheetPdfCommand}" />
                <MenuItem Header="Current label to PNG…" Command="{Binding ExportLabelPngCommand}" />
                <MenuItem Header="Current label to SVG…" Command="{Binding ExportLabelSvgCommand}" />
              </MenuItem>
            </MenuItem>

            <MenuItem Header="_Scale">
              <MenuItem Header="Zoom in" Command="{Binding ZoomInCommand}" />
              <MenuItem Header="Zoom out" Command="{Binding ZoomOutCommand}" />
              <MenuItem Header="Fit label" Command="{Binding ZoomFitCommand}" />
              <MenuItem Header="Actual size (100%)" Command="{Binding ZoomActualCommand}" />
              <Separator />
              <MenuItem Header="_Rulers" IsCheckable="True" IsChecked="{Binding ShowRulers}" />
              <MenuItem Header="_Guides" IsCheckable="True" IsChecked="{Binding ShowGuides}" />
              <MenuItem Header="_Lock guides" IsCheckable="True" IsChecked="{Binding LockGuides}" />
              <MenuItem Header="Clear guides" Command="{Binding ClearGuidesCommand}" />
              <Separator />
              <MenuItem Header="Show grid" IsCheckable="True" IsChecked="{Binding ShowGrid}" />
              <MenuItem Header="Snap to grid" IsCheckable="True" IsChecked="{Binding SnapToGrid}" />
              <MenuItem Header="Snap to guides" IsCheckable="True" IsChecked="{Binding SnapToGuides}" />
              <MenuItem Header="Snap to objects" IsCheckable="True" IsChecked="{Binding SnapToObjects}" />
            </MenuItem>

            <MenuItem AutomationProperties.AutomationId="Menu.Help" Header="_Help">
              <MenuItem AutomationProperties.AutomationId="Menu.HelpGuide" Header="_Help guide" InputGestureText="F1" Command="{Binding HelpCommand}" CommandParameter="" />
              <MenuItem Header="_Your first label" Command="{Binding HelpCommand}" CommandParameter="getting-started" />
              <MenuItem Header="_Keyboard shortcuts" Command="{Binding HelpCommand}" CommandParameter="shortcuts" />
              <MenuItem Header="T_roubleshooting" Command="{Binding HelpCommand}" CommandParameter="troubleshooting" />
              <Separator />
              <MenuItem AutomationProperties.AutomationId="Menu.CheckForUpdates" Header="Check for _updates…" Command="{Binding CheckForUpdatesCommand}" />
              <MenuItem AutomationProperties.AutomationId="Menu.About" Header="_About LabelAxis" Command="{Binding AboutCommand}" />
            </MenuItem>
          </Menu>
        </StackPanel>

        <!-- window buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <!-- The theme in use; a click lists all eight. -->
          <Button x:Name="ThemeButton" Click="OnThemeMenu" ToolTip="Theme" Margin="0,0,8,0" Cursor="Hand"
                  AutomationProperties.AutomationId="Main.Theme" Focusable="False">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="bd" Height="30" CornerRadius="9" Padding="8,0,10,0" BorderThickness="1"
                        Background="{DynamicResource LA.Brush.GlassFill}" BorderBrush="{DynamicResource LA.Brush.GlassBorder}">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="14" Height="14" Fill="{DynamicResource Br.AccentGradient}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ThemeName}" FontSize="12" Foreground="{DynamicResource Br.Text2}" VerticalAlignment="Center"
                               loc:Localizer.Off="True" />
                    <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource Br.TextMuted}" StrokeThickness="1.4" Margin="8,1,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource LA.Brush.GlassFillHover}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Button Style="{StaticResource WindowChromeButton}" Click="OnMinimise" ToolTip="Minimise"
                  AutomationProperties.Name="Minimise">
            <Path Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
          </Button>
          <Button x:Name="MaxButton" Style="{StaticResource WindowChromeButton}" Click="OnMaximise" ToolTip="Maximise"
                  AutomationProperties.Name="Maximise">
            <Path x:Name="MaxGlyph" Data="M 0,0 L 9,0 L 9,9 L 0,9 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
          </Button>
          <Button Style="{StaticResource WindowCloseButton}" Click="OnClose" ToolTip="Close"
                  AutomationProperties.Name="Close">
            <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═════════════ Tool bar ═════════════ -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Shell.Glass}" Margin="10,0,10,10" Padding="6">
      <Grid>
        <!-- Two columns, so the tools never slide under Preview and Print: in a narrow window
             the tools scroll sideways instead. -->
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,10,0">
        <StackPanel Orientation="Horizontal">
          <RadioButton Style="{StaticResource ToolTile}" IsChecked="True" GroupName="tool" ToolTip="Select / move objects">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{DynamicResource Icon.Select}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Select" /></StackPanel>
          </RadioButton>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding AddTextCommand}" AutomationProperties.AutomationId="Tool.AddText" ToolTip="Add a text box">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{DynamicResource Icon.Text}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Text" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding AddImageCommand}" AutomationProperties.AutomationId="Tool.AddImage" ToolTip="Add an image">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{DynamicResource Icon.Image}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Image" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding AddBarcodeCommand}" AutomationProperties.AutomationId="Tool.AddBarcode" ToolTip="Add a barcode">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{DynamicResource Icon.Barcode}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Barcode" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding AddQrCodeCommand}" AutomationProperties.AutomationId="Tool.AddQrCode" ToolTip="Add a QR code">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{DynamicResource Icon.QrCode}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="QR Code" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding AddTableCommand}" AutomationProperties.AutomationId="Tool.AddTable" ToolTip="Add a table">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{DynamicResource Icon.Table}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Table" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" ToolTip="Add a shape" Click="OnAlignMenu" AutomationProperties.AutomationId="Tool.Shapes">
            <StackPanel Orientation="Horizontal">
              <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{DynamicResource Icon.Shape}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Shapes" /></StackPanel>
              <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource Br.TextMuted}" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="_Rectangle" Command="{Binding AddShapeCommand}" CommandParameter="rectangle" />
                <MenuItem Header="R_ounded rectangle" Command="{Binding AddShapeCommand}" CommandParameter="round" />
                <MenuItem Header="_Ellipse / circle" Command="{Binding AddShapeCommand}" CommandParameter="ellipse" />
                <Separator />
                <MenuItem Header="_Triangle" Command="{Binding AddShapeCommand}" CommandParameter="triangle" />
                <MenuItem Header="_Diamond" Command="{Binding AddShapeCommand}" CommandParameter="diamond" />
                <MenuItem Header="_Pentagon" Command="{Binding AddShapeCommand}" CommandParameter="pentagon" />
                <MenuItem Header="_Hexagon" Command="{Binding AddShapeCommand}" CommandParameter="hexagon" />
                <MenuItem Header="Oc_tagon" Command="{Binding AddShapeCommand}" CommandParameter="octagon" />
                <Separator />
                <MenuItem Header="5-point _star" Command="{Binding AddShapeCommand}" CommandParameter="star5" />
                <MenuItem Header="6-point star" Command="{Binding AddShapeCommand}" CommandParameter="star6" />
                <MenuItem Header="_Burst (12 points)" Command="{Binding AddShapeCommand}" CommandParameter="burst" />
                <Separator />
                <MenuItem Header="Dashed _box" Command="{Binding AddShapeCommand}" CommandParameter="dashedbox" />
                <MenuItem Header="_Custom shape (draw with dots)…"
                          ToolTip="Click dots on the label; they are joined into a shape. Click the first dot or press Enter to finish."
                          Command="{Binding DrawCustomShapeCommand}" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" ToolTip="Add a line" Click="OnAlignMenu" AutomationProperties.AutomationId="Tool.Lines">
            <StackPanel Orientation="Horizontal">
              <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{DynamicResource Icon.Line}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Lines" /></StackPanel>
              <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource Br.TextMuted}" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="_Solid line" Command="{Binding AddShapeCommand}" CommandParameter="line" />
                <MenuItem Header="_Hairline (0.1 mm)" Command="{Binding AddShapeCommand}" CommandParameter="hairline" />
                <Separator />
                <MenuItem Header="_Dashed line" Command="{Binding AddShapeCommand}" CommandParameter="dashed" />
                <MenuItem Header="D_otted line" Command="{Binding AddShapeCommand}" CommandParameter="dotted" />
                <MenuItem Header="Dash-dot line" Command="{Binding AddShapeCommand}" CommandParameter="dashdot" />
                <Separator />
                <MenuItem Header="_Arrow" Command="{Binding AddShapeCommand}" CommandParameter="arrow" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>

          <Rectangle Style="{StaticResource ToolDivider}" />

          <Button Style="{StaticResource ToolTileButton}" ToolTip="Align selected objects" Click="OnAlignMenu">
            <StackPanel Orientation="Horizontal">
              <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{DynamicResource Icon.Align}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Align" /></StackPanel>
              <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource Br.TextMuted}" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Align left" Command="{Binding AlignLeftCommand}" />
                <MenuItem Header="Align centre" Command="{Binding CenterHorizontalCommand}" />
                <MenuItem Header="Align right" Command="{Binding AlignRightCommand}" />
                <Separator />
                <MenuItem Header="Align top" Command="{Binding AlignTopCommand}" />
                <MenuItem Header="Align middle" Command="{Binding CenterVerticalCommand}" />
                <MenuItem Header="Align bottom" Command="{Binding AlignBottomCommand}" />
                <Separator />
                <MenuItem Header="Distribute horizontally" Command="{Binding DistributeHorizontallyCommand}"
                          ToolTip="Equal gaps between three or more objects" />
                <MenuItem Header="Distribute vertically" Command="{Binding DistributeVerticallyCommand}" />
                <Separator />
                <MenuItem Header="Match width" Command="{Binding MatchWidthCommand}" ToolTip="Use the first selected object's width" />
                <MenuItem Header="Match height" Command="{Binding MatchHeightCommand}" />
                <MenuItem Header="Match size" Command="{Binding MatchSizeCommand}" />
                <Separator />
                <MenuItem Header="Align to label" IsCheckable="True" IsChecked="{Binding AlignToLabel}"
                          ToolTip="Off: one object aligns to the label, several align to each other" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" ToolTip="Arrange z-order" Click="OnAlignMenu">
            <StackPanel Orientation="Horizontal">
              <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{DynamicResource Icon.Arrange}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Arrange" /></StackPanel>
              <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource Br.TextMuted}" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Bring to front" Command="{Binding BringToFrontCommand}" />
                <MenuItem Header="Bring forward" Command="{Binding BringForwardCommand}" />
                <MenuItem Header="Send backward" Command="{Binding SendBackwardCommand}" />
                <MenuItem Header="Send to back" Command="{Binding SendToBackCommand}" />
                <Separator />
                <MenuItem Header="Rotate 90° right" Command="{Binding RotateCommand}" CommandParameter="90" />
                <MenuItem Header="Rotate 90° left" Command="{Binding RotateCommand}" CommandParameter="-90" />
                <MenuItem Header="Rotate 180°" Command="{Binding RotateCommand}" CommandParameter="180" />
                <Separator />
                <MenuItem Header="Flip horizontal" Command="{Binding FlipHorizontalCommand}" />
                <MenuItem Header="Flip vertical" Command="{Binding FlipVerticalCommand}" />
                <Separator />
                <MenuItem Header="Free transform" InputGestureText="Ctrl+Shift+T" Command="{Binding FreeTransformCommand}"
                          ToolTip="Corners resize, side handles skew, the knob rotates" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>

          <Rectangle Style="{StaticResource ToolDivider}" />

          <Button Style="{StaticResource ToolTileButton}" Command="{Binding GroupCommand}" ToolTip="Group (Ctrl+G)">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{DynamicResource Icon.Group}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Group" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding UngroupCommand}" ToolTip="Ungroup (Ctrl+Shift+G)">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{DynamicResource Icon.Ungroup}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Ungroup" /></StackPanel>
          </Button>

          <Rectangle Style="{StaticResource ToolDivider}" />

          <Button Style="{StaticResource ToolTileButton}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{DynamicResource Icon.ZoomOut}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Zoom Out" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding ZoomActualCommand}" ToolTip="Actual size">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{DynamicResource Icon.ZoomFit}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="100%" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding ZoomInCommand}" ToolTip="Zoom in">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{DynamicResource Icon.ZoomIn}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Zoom In" /></StackPanel>
          </Button>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource GhostButton}" Command="{Binding PrintPreviewCommand}" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <Image Source="{DynamicResource Icon.Eye}" Width="16" Height="16" Margin="0,0,8,0" />
              <TextBlock Text="Preview" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding PrintCommand}">
            <StackPanel Orientation="Horizontal">
              <Image Source="{DynamicResource Icon.PrintWhite}" Width="16" Height="16" Margin="0,0,8,0" />
              <TextBlock Text="Print" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═════════════ Update bar: a newer version is available ═════════════ -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Br.AccentSoft}" BorderBrush="{DynamicResource LA.Brush.AccentBorder}"
            BorderThickness="1" CornerRadius="14" Margin="10,0,10,10" Padding="16,8" AutomationProperties.AutomationId="Main.UpdateBar"
            Visibility="{Binding UpdateBarVisible, Converter={StaticResource BoolVisConv}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Update now" Style="{StaticResource AccentButton}" Padding="14,4" Margin="8,0,0,0"
                  Command="{Binding InstallUpdateCommand}" AutomationProperties.AutomationId="Main.UpdateNow" />
          <Button Content="What's new" Padding="12,4" Margin="8,0,0,0" Command="{Binding UpdateNotesCommand}" />
          <Button Content="Later" Padding="12,4" Margin="8,0,0,0" Command="{Binding DismissUpdateCommand}" AutomationProperties.AutomationId="Main.UpdateLater" />
          <Button Content="Skip this version" Padding="12,4" Margin="8,0,0,0" Command="{Binding SkipUpdateCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding UpdateBarText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   FontFamily="{StaticResource Font.UiSemiBold}" Foreground="{DynamicResource Br.Text}" />
      </DockPanel>
    </Border>

    <!-- ═════════════ Status bar ═════════════ -->
    <!-- One row of columns, so nothing can slide over anything else: the sheet name takes the
         room that is left and is shortened with "…" when the window is narrow. -->
    <Border DockPanel.Dock="Bottom" Background="Transparent" Padding="18,4,14,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MinWidth="60" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="{DynamicResource Icon.Check}" Width="15" Height="15" Margin="0,0,7,0" />
          <TextBlock Text="{Binding SaveStateText}" Style="{StaticResource StatusText}" Margin="0,0,14,0" />
          <Rectangle Style="{StaticResource StatusDivider}" Margin="0,0,14,0" />
        </StackPanel>

        <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
          <Image Source="{DynamicResource Icon.Sheet}" Width="15" Height="15" Margin="0,0,7,0" />
          <TextBlock Text="{Binding SheetSummary}" Style="{StaticResource StatusText}" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding SheetSummary}" />
        </DockPanel>

        <!-- Steps the canvas through the merged records; only there when records are loaded. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
          <Rectangle Style="{StaticResource StatusDivider}" Margin="0,0,10,0" />
          <Image Source="{DynamicResource Icon.Database}" Width="15" Height="15" Margin="0,0,4,0" />
          <Button Content="⏮" Style="{StaticResource IconGhost}" MinWidth="24" ToolTip="First record"
                  Command="{Binding FirstRecordCommand}" />
          <Button Content="◀" Style="{StaticResource IconGhost}" MinWidth="24" ToolTip="Previous record"
                  Command="{Binding PrevRecordCommand}" />
          <TextBlock Text="{Binding RecordText}" Style="{StaticResource StatusText}" VerticalAlignment="Center"
                     MinWidth="58" TextAlignment="Center" />
          <Button Content="▶" Style="{StaticResource IconGhost}" MinWidth="24" ToolTip="Next record"
                  Command="{Binding NextRecordCommand}" />
          <Button Content="⏭" Style="{StaticResource IconGhost}" MinWidth="24" ToolTip="Last record"
                  Command="{Binding LastRecordCommand}" Margin="0,0,14,0" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Rectangle Style="{StaticResource StatusDivider}" Margin="0,0,14,0" />
          <Image Source="{DynamicResource Icon.Search}" Width="15" Height="15" Margin="0,0,7,0" />
          <TextBlock Text="{Binding ZoomText}" Style="{StaticResource StatusText}" Margin="0,0,14,0" />
        </StackPanel>

        <Border Grid.Column="4" Background="{DynamicResource Br.Surface2}" BorderBrush="{DynamicResource Br.Border}" BorderThickness="1"
                CornerRadius="8" Padding="10,3" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource Icon.Print}" Width="14" Height="14" Margin="0,0,7,0" />
            <TextBlock Text="{Binding PrinterName}" Style="{StaticResource StatusText}" MaxWidth="240"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding PrinterName}" />
            <Rectangle Style="{StaticResource StatusDivider}" Margin="10,0" />
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource LA.Brush.AccentTertiary}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCalibrated}" Value="True">
                      <Setter Property="Fill" Value="{DynamicResource Br.Ok}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding CalibrationStatus}" Style="{StaticResource StatusText}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ═════════════ Workspace ═════════════ -->
    <Grid Margin="10,0,10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="308" MinWidth="220" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" MinWidth="340" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="344" MinWidth="260" />
      </Grid.ColumnDefinitions>

      <!-- ───────── Left panel ───────── -->
      <Border Grid.Column="0" Style="{StaticResource Shell.Glass}" Margin="0,0,0,2">
        <DockPanel>
          <Border DockPanel.Dock="Top" Style="{StaticResource LA.Segmented.Track}" Margin="10,10,10,0">
            <UniformGrid Rows="1">
              <RadioButton GroupName="LeftTab" Content="Pages" Style="{StaticResource LA.Segmented.Item}"
                           IsChecked="{Binding SelectedLeftTab, Converter={StaticResource IntEquals}, ConverterParameter=1}" />
              <RadioButton GroupName="LeftTab" Content="Data" Style="{StaticResource LA.Segmented.Item}"
                           IsChecked="{Binding SelectedLeftTab, Converter={StaticResource IntEquals}, ConverterParameter=2}" />
            </UniformGrid>
          </Border>

          <!--
            Both tab bodies share one Grid cell. They used to be siblings of a
            DockPanel, where only the last child fills and the others dock to the
            left at their own content width, so the panel changed size depending on
            which tab (and how much content) was showing.
          -->
          <Grid>

          <!-- Pages tab: the pages of the project and the objects on the page -->
          <DockPanel Visibility="{Binding SelectedLeftTab, Converter={StaticResource IntEqualsVis}, ConverterParameter=1}"
                     Margin="14,12,14,14">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="PAGES" Style="{StaticResource PanelSectionHeader}" VerticalAlignment="Center" Margin="0" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button ToolTip="Previous page (↑)" Command="{Binding PreviousPageCommand}" Style="{StaticResource IconGhost}" MinWidth="24">
                  <Path Data="M 0,6 L 5,0 L 10,6" Stroke="{DynamicResource Br.Text2}" StrokeThickness="1.5" />
                </Button>
                <Button ToolTip="Next page (↓)" Command="{Binding NextPageCommand}" Style="{StaticResource IconGhost}" MinWidth="24" Margin="0,0,6,0">
                  <Path Data="M 0,0 L 5,6 L 10,0" Stroke="{DynamicResource Br.Text2}" StrokeThickness="1.5" />
                </Button>
                <Button Content="+" ToolTip="Add page" Command="{Binding AddPageCommand}" Style="{StaticResource IconGhost}" AutomationProperties.AutomationId="Pages.Add" />
                <Button Content="⧉" ToolTip="Duplicate page" Command="{Binding DuplicatePageCommand}" Style="{StaticResource IconGhost}" />
                <Button Content="✕" ToolTip="Remove page" Command="{Binding RemovePageCommand}" Style="{StaticResource IconGhost}" AutomationProperties.AutomationId="Pages.Remove" />
                <Button ToolTip="Sort and arrange pages" Style="{StaticResource IconGhost}" MinWidth="24" Click="OnAlignMenu">
                  <Path Data="M 0,1 L 10,1 M 0,5 L 7,5 M 0,9 L 4,9" Stroke="{DynamicResource Br.Text2}" StrokeThickness="1.5" />
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Sort by name, _A to Z" Command="{Binding SortPagesCommand}" CommandParameter="name" />
                      <MenuItem Header="Sort by name, _Z to A" Command="{Binding SortPagesCommand}" CommandParameter="name-desc" />
                      <MenuItem Header="_Reverse order" Command="{Binding SortPagesCommand}" CommandParameter="reverse" />
                      <Separator />
                      <MenuItem Header="Move page _up" InputGestureText="Ctrl+↑" Command="{Binding MovePageUpCommand}" />
                      <MenuItem Header="Move page _down" InputGestureText="Ctrl+↓" Command="{Binding MovePageDownCommand}" />
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
              </StackPanel>
            </Grid>
            <Border DockPanel.Dock="Top" Style="{StaticResource InsetPanel}" Height="170" Margin="0,0,0,14">
              <ListBox x:Name="PageList" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                       BorderThickness="0" Background="Transparent" PreviewKeyDown="OnPageListKeyDown"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Resources>
                  <!-- Up and down arrows on the list's scroll bar, for scrolling a long list of pages. -->
                  <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBarWithArrows}" />
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <TextBlock x:Name="PageCaption" Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBox x:Name="PageRenameBox" Visibility="Collapsed" Margin="-4,-2,0,-2"
                               KeyDown="OnPageRenameKeyDown" LostKeyboardFocus="OnPageRenameLostFocus" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <!-- Right-click selects first, so the menu always acts on the row under the cursor. -->
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnListItemRightClick" />
                    <!-- On the row itself: the row handles the click, so a binding on the list never saw it. -->
                    <EventSetter Event="MouseDoubleClick" Handler="OnPageDoubleClick" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="_Add page" Command="{Binding AddPageCommand}" />
                    <MenuItem Header="_Duplicate page" Command="{Binding DuplicatePageCommand}" />
                    <Separator />
                    <MenuItem Header="_Rename" InputGestureText="Double-click, F2" Command="{Binding RenamePageCommand}" />
                    <MenuItem Header="Label _size…" Command="{Binding LabelSizeCommand}" />
                    <MenuItem Header="Apply this page's _format to other pages…" Command="{Binding ApplyLayoutCommand}" />
                    <MenuItem Header="Save as _my design…" Command="{Binding SaveAsDesignCommand}" />
                    <Separator />
                    <MenuItem Header="Move page _up" InputGestureText="Ctrl+↑" Command="{Binding MovePageUpCommand}" />
                    <MenuItem Header="Move page do_wn" InputGestureText="Ctrl+↓" Command="{Binding MovePageDownCommand}" />
                    <MenuItem Header="Sort by name, A to Z" Command="{Binding SortPagesCommand}" CommandParameter="name" />
                    <MenuItem Header="Sort by name, Z to A" Command="{Binding SortPagesCommand}" CommandParameter="name-desc" />
                    <MenuItem Header="Reverse order" Command="{Binding SortPagesCommand}" CommandParameter="reverse" />
                    <Separator />
                    <MenuItem Header="_Remove page" Command="{Binding RemovePageCommand}" />
                  </ContextMenu>
                </ListBox.ContextMenu>
              </ListBox>
            </Border>

            <TextBlock DockPanel.Dock="Top" Text="OBJECTS ON PAGE" Style="{StaticResource PanelSectionHeader}" />
            <TextBlock DockPanel.Dock="Bottom" FontSize="11" Margin="2,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Br.TextMuted}"
                       Text="Drag rows to change which object is in front. Double-click or F2 renames. Shift+click selects a range, Ctrl+click adds one." />
            <Border Style="{StaticResource InsetPanel}">
              <ListBox x:Name="ObjectListBox" ItemsSource="{Binding ObjectList}" SelectionMode="Extended"
                       BorderThickness="0" Background="Transparent" SelectionChanged="OnObjectListSelectionChanged"
                       AllowDrop="True" PreviewMouseLeftButtonDown="OnObjectListMouseDown" PreviewMouseLeftButtonUp="OnObjectListMouseUp" PreviewMouseMove="OnObjectListMouseMove"
                       DragOver="OnObjectListDragOver" DragLeave="OnObjectListDragLeave" Drop="OnObjectListDrop"
                       PreviewKeyDown="OnObjectListKeyDown">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}" />
                    <EventSetter Event="MouseDoubleClick" Handler="OnObjectRowDoubleClick" />
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnObjectRowRightClick" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="_Rename" InputGestureText="F2" Click="OnRenameObjectMenu" />
                    <Separator />
                    <MenuItem Header="Bring to _front" Command="{Binding BringToFrontCommand}" />
                    <MenuItem Header="Bring _forward" InputGestureText="Ctrl+↑" Command="{Binding BringForwardCommand}" />
                    <MenuItem Header="Send _backward" InputGestureText="Ctrl+↓" Command="{Binding SendBackwardCommand}" />
                    <MenuItem Header="Send to bac_k" Command="{Binding SendToBackCommand}" />
                    <Separator />
                    <MenuItem Header="_Group" Command="{Binding GroupCommand}" />
                    <MenuItem Header="_Ungroup" Command="{Binding UngroupCommand}" />
                    <Separator />
                    <MenuItem Header="_Delete" InputGestureText="Del" Command="{Binding DeleteCommand}" />
                    <MenuItem Header="Remove from all _pages…" Command="{Binding RemoveFromAllPagesCommand}" />
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel x:Name="Row">
                      <Button DockPanel.Dock="Right" Style="{StaticResource IconGhost}" MinWidth="22" Padding="2"
                              ToolTip="Lock so it cannot be moved or changed on the canvas"
                              Command="{Binding DataContext.ToggleObjectLockCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              CommandParameter="{Binding}">
                        <Image Width="13" Height="13" Source="{Binding Locked, Converter={StaticResource LockIcon}}" />
                      </Button>
                      <Image x:Name="GroupIcon" DockPanel.Dock="Left" Source="{DynamicResource Icon.Group}" Width="14" Height="14"
                             Margin="0,0,6,0" Visibility="Collapsed" />
                      <Grid>
                        <TextBlock x:Name="Caption" Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Display}" />
                        <TextBox x:Name="RenameBox" Text="{Binding EditName, Mode=OneWay}" Visibility="Collapsed" Margin="-4,-2,0,-2"
                                 KeyDown="OnRenameBoxKeyDown" LostKeyboardFocus="OnRenameBoxLostFocus" IsVisibleChanged="OnRenameBoxShown" />
                      </Grid>
                    </DockPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsGroup}" Value="True">
                        <Setter TargetName="GroupIcon" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Caption" Property="FontFamily" Value="{StaticResource Font.UiSemiBold}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsGroupMember}" Value="True">
                        <Setter TargetName="Row" Property="Margin" Value="20,0,0,0" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsEditing}" Value="True">
                        <Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Caption" Property="Visibility" Value="Hidden" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </DockPanel>

          <!-- Data tab: search across the project -->
          <DockPanel Visibility="{Binding SelectedLeftTab, Converter={StaticResource IntEqualsVis}, ConverterParameter=2}"
                     Margin="14,12,14,14">
            <Border DockPanel.Dock="Top" Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="DATA SOURCE" Style="{StaticResource PanelSectionHeader}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding DataSourceSummary}" FontSize="12.5" Margin="0,0,0,10" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                  <Button Content="Import file…" Command="{Binding ImportDataCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6" />
                  <Button Content="Database…" Command="{Binding ConnectDatabaseCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                          ToolTip="Read records from SQLite, SQL Server, MySQL, PostgreSQL, Access or ODBC" />
                  <Button Content="Records…" Command="{Binding DataTableCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                          ToolTip="See, edit, filter and print chosen records (Ctrl+T)" />
                  <Button Content="Refresh" Command="{Binding RefreshDataCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                          ToolTip="Read the file or database again (F5)" />
                  <Button Content="Clear" Command="{Binding ClearDataCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,6" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <DockPanel DockPanel.Dock="Top">
              <Button DockPanel.Dock="Right" Content="Find &amp; replace…" Style="{StaticResource GhostButton}"
                      Padding="10,4" Margin="0,0,0,6" Command="{Binding FindReplaceCommand}"
                      ToolTip="Replace text, barcode values and table cells across every page (Ctrl+H)" />
              <TextBlock Text="SEARCH PROJECT" Style="{StaticResource PanelSectionHeader}" VerticalAlignment="Center" />
            </DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource SearchField}" Margin="0,0,0,10">
              <DockPanel>
                <Image DockPanel.Dock="Left" Source="{DynamicResource Icon.Search}" Width="15" Height="15" Margin="2,0,8,0" />
                <TextBox Style="{StaticResource PlainTextBox}" Tag="Search text, barcodes, records…"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
              </DockPanel>
            </Border>
            <Border Style="{StaticResource InsetPanel}">
              <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" loc:Localizer.Off="True"
                       DisplayMemberPath="Display" BorderThickness="0" Background="Transparent" />
            </Border>
          </DockPanel>

          </Grid>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

      <!-- ───────── Centre: document tabs + canvas + data table ───────── -->
      <DockPanel Grid.Column="2">
        <!-- document tab strip -->
        <Border DockPanel.Dock="Top" Background="Transparent" Padding="4,0,4,6">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,4">
              <Button Style="{StaticResource IconGhost}" MinWidth="28" Command="{Binding OpenCommand}"
                      ToolTip="Open a project in a new tab (Ctrl+O)">
                <Image Source="{DynamicResource Icon.Open}" Width="14" Height="14" />
              </Button>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly">
              <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="Tab" CornerRadius="10" BorderThickness="1" Padding="12,6,6,6"
                              Margin="0,0,4,0" MaxWidth="240" Cursor="Hand" ToolTip="{Binding ToolTip}"
                              Background="Transparent" BorderBrush="Transparent"
                              MouseLeftButtonDown="OnTabMouseDown" MouseUp="OnTabMouseUp">
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="_Close" InputGestureText="Ctrl+W"
                                      Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="Close _others"
                                      Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <Border.Tag>
                          <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                        </Border.Tag>
                        <DockPanel>
                          <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconGhost}"
                                  MinWidth="20" Padding="4,0" Margin="8,0,0,0" ToolTip="Close (Ctrl+W)"
                                  Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" Opacity="0.55" />
                          <Ellipse x:Name="Dirty" DockPanel.Dock="Right" Width="7" Height="7" Margin="8,0,0,0"
                                   Fill="{DynamicResource Br.Accent}" VerticalAlignment="Center" Visibility="Collapsed"
                                   ToolTip="Unsaved changes" />
                          <Image DockPanel.Dock="Left" Source="{DynamicResource Icon.FileDoc}" Width="13" Height="13"
                                 Margin="0,0,7,0" VerticalAlignment="Center" Opacity="0.7" />
                          <TextBlock x:Name="Caption" Text="{Binding Title}" VerticalAlignment="Center"
                                     FontSize="12.5" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource Br.Text2}" />
                        </DockPanel>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter TargetName="Tab" Property="Background" Value="{DynamicResource LA.Brush.GlassFillHover}" />
                          <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource LA.Brush.GlassBorder}" />
                          <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource Br.Accent}" />
                          <Setter TargetName="Caption" Property="FontFamily" Value="{StaticResource Font.UiSemiBold}" />
                          <Setter TargetName="CloseButton" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                          <Setter TargetName="Dirty" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger SourceName="Tab" Property="IsMouseOver" Value="True">
                          <Setter TargetName="CloseButton" Property="Opacity" Value="1" />
                        </Trigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource IconGhost}" MinWidth="28" Margin="2,0,0,4" Command="{Binding NewCommand}"
                        ToolTip="New project in a new tab (Ctrl+N)" VerticalAlignment="Center">
                  <Image Source="{DynamicResource Icon.Plus}" Width="14" Height="14" />
                </Button>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>


        <!-- canvas view options -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Shell.Glass}" CornerRadius="14" Margin="0,0,0,10" Padding="8,4">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
              <ToggleButton Content="Rulers" Style="{StaticResource ChipToggle}" IsChecked="{Binding ShowRulers}"
                            ToolTip="Show or hide the rulers along the top and left of the canvas" />
              <Rectangle Style="{StaticResource ToolDivider}" Margin="6,4" />
              <ToggleButton Content="Guides" Style="{StaticResource ChipToggle}" IsChecked="{Binding ShowGuides}"
                            ToolTip="Show or hide guide lines. Drag from a ruler to add one; drag it back onto the ruler to remove it." />
              <ToggleButton Content="Same on every page" Style="{StaticResource ChipToggle}" IsChecked="{Binding SharedGuides}"
                            ToolTip="On: every page shows and snaps to the same guides. Off: each page keeps its own guides." />
              <ToggleButton Content="Lock" Style="{StaticResource ChipToggle}" IsChecked="{Binding LockGuides}"
                            ToolTip="Lock guides so they cannot be dragged by accident" />
              <Button Content="Clear" Style="{StaticResource IconGhost}" FontSize="12" Command="{Binding ClearGuidesCommand}"
                      ToolTip="Remove the guides from this page (or from every page when they are shared)" />
              <Rectangle Style="{StaticResource ToolDivider}" Margin="6,4" />
              <ToggleButton Content="Grid" Style="{StaticResource ChipToggle}" IsChecked="{Binding ShowGrid}"
                            ToolTip="Show or hide the grid" />
              <Button Style="{StaticResource IconGhost}" MinWidth="22" Command="{Binding GridSmallerCommand}" ToolTip="Smaller grid">
                <Path Data="M 0,0 L 8,0" Stroke="{DynamicResource Br.Text2}" StrokeThickness="1.6" Margin="0,5" />
              </Button>
              <TextBlock Text="{Binding GridSizeText}" VerticalAlignment="Center" MinWidth="46" TextAlignment="Center"
                         FontSize="12" Foreground="{DynamicResource Br.Text2}" ToolTip="Grid spacing" />
              <Button Style="{StaticResource IconGhost}" MinWidth="22" Command="{Binding GridLargerCommand}" ToolTip="Larger grid">
                <Path Data="M 0,4 L 8,4 M 4,0 L 4,8" Stroke="{DynamicResource Br.Text2}" StrokeThickness="1.6" Margin="0,1" />
              </Button>
              <Rectangle Style="{StaticResource ToolDivider}" Margin="6,4" />
              <TextBlock Text="Snap to" VerticalAlignment="Center" FontSize="12" Margin="2,0,6,0" Foreground="{DynamicResource Br.TextMuted}" />
              <ToggleButton Content="Grid" Style="{StaticResource ChipToggle}" IsChecked="{Binding SnapToGrid}"
                            ToolTip="Moving and resizing steps along the grid" />
              <ToggleButton Content="Guides" Style="{StaticResource ChipToggle}" IsChecked="{Binding SnapToGuides}"
                            ToolTip="Edges and centres stick to visible guide lines" />
              <ToggleButton Content="Objects" Style="{StaticResource ChipToggle}" IsChecked="{Binding SnapToObjects}"
                            ToolTip="Edges and centres line up with other objects and the label" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- canvas -->
        <Border Background="{DynamicResource LA.Brush.CanvasWell}" BorderBrush="{DynamicResource LA.Brush.GlassBorder}" BorderThickness="1"
                CornerRadius="18" Margin="0,0,0,2">
          <Border x:Name="CanvasHost" ClipToBounds="True" FlowDirection="LeftToRight" />
        </Border>
      </DockPanel>

      <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

      <!-- ───────── Right panel ───────── -->
      <Border Grid.Column="4" Style="{StaticResource Shell.Glass}" Margin="0,0,0,2">
        <DockPanel>
          <Border DockPanel.Dock="Top" Style="{StaticResource LA.Segmented.Track}" Margin="10,10,10,0">
            <UniformGrid Rows="1">
              <RadioButton GroupName="RightTab" Content="Properties" Style="{StaticResource LA.Segmented.Item}"
                           IsChecked="{Binding SelectedRightTab, Converter={StaticResource IntEquals}, ConverterParameter=0}" />
              <RadioButton GroupName="RightTab" Content="Layers" Style="{StaticResource LA.Segmented.Item}"
                           IsChecked="{Binding SelectedRightTab, Converter={StaticResource IntEquals}, ConverterParameter=1}" />
              <RadioButton GroupName="RightTab" Content="Page" Style="{StaticResource LA.Segmented.Item}"
                           IsChecked="{Binding SelectedRightTab, Converter={StaticResource IntEquals}, ConverterParameter=2}" />
            </UniformGrid>
          </Border>

          <!-- One cell for all three tab bodies (see the left panel for why). -->
          <Grid>

          <!-- Layers tab -->
          <DockPanel Visibility="{Binding SelectedRightTab, Converter={StaticResource IntEqualsVis}, ConverterParameter=1}"
                     Margin="14,12,14,14">
            <TextBlock DockPanel.Dock="Top" Text="OBJECTS, FRONT TO BACK" Style="{StaticResource PanelSectionHeader}" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Bring forward" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Command="{Binding BringForwardCommand}" />
              <Button Content="Send backward" Style="{StaticResource GhostButton}" Command="{Binding SendBackwardCommand}" />
            </StackPanel>
            <Border Style="{StaticResource InsetPanel}">
              <ListBox ItemsSource="{Binding ObjectList}" SelectionMode="Extended" DisplayMemberPath="Display"
                       BorderThickness="0" Background="Transparent" SelectionChanged="OnObjectListSelectionChanged">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}" />
                  </Style>
                </ListBox.ItemContainerStyle>
              </ListBox>
            </Border>
          </DockPanel>

          <!-- Page tab -->
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding SelectedRightTab, Converter={StaticResource IntEqualsVis}, ConverterParameter=2}">
            <StackPanel Margin="14,12,14,14">
              <TextBlock Text="LABEL SHEET" Style="{StaticResource PanelSectionHeader}" />
              <Border Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,0,0,12">
                <TextBlock Text="{Binding TemplateSummary}" TextWrapping="Wrap" FontSize="12.5" />
              </Border>
              <Button Content="Change template…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                      Command="{Binding TemplateManagerCommand}" Margin="0,0,0,14" />

              <TextBlock Text="CURRENT PAGE" Style="{StaticResource PanelSectionHeader}" />
              <Border Style="{StaticResource InsetPanel}" Padding="12,10">
                <StackPanel>
                  <TextBlock Text="{Binding ActivePageName}" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="13" />
                  <TextBlock Text="{Binding SelectionInfo}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                             Foreground="{DynamicResource Br.TextMuted}" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
              <Button Content="Apply page format to other pages…" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                      Margin="0,10,0,0" Command="{Binding ApplyLayoutCommand}"
                      ToolTip="Give the text, barcodes, images and so on of other pages the place, size and look they have on this page" />
            </StackPanel>
          </ScrollViewer>

          <!-- Properties tab (PropertiesPanel.xaml) -->
          <local:PropertiesPanel Visibility="{Binding SelectedRightTab, Converter={StaticResource IntEqualsVis}, ConverterParameter=0}" />

          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
  </Grid>
</Window>
