<Window x:Class="LabelMaker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Label Maker" Height="860" Width="1480" MinHeight="620" MinWidth="1040"
        Icon="/Assets/icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}"
        TextElement.Foreground="{DynamicResource Br.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>

  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
    <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateCommand}" />
    <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
    <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutCommand}" />
    <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
    <KeyBinding Key="G" Modifiers="Control" Command="{Binding GroupCommand}" />
    <KeyBinding Key="G" Modifiers="Control+Shift" Command="{Binding UngroupCommand}" />
    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
    <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}" />
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding FindCommand}" />
    <KeyBinding Key="T" Modifiers="Control+Shift" Command="{Binding FreeTransformCommand}" />
    <KeyBinding Key="H" Modifiers="Control" Command="{Binding FindReplaceCommand}" />
    <KeyBinding Key="T" Modifiers="Control" Command="{Binding DataTableCommand}" />
    <KeyBinding Key="F5" Command="{Binding RefreshDataCommand}" />
    <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}" />
    <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}" />
    <KeyBinding Key="PageDown" Modifiers="Control" Command="{Binding NextTabCommand}" />
    <KeyBinding Key="PageUp" Modifiers="Control" Command="{Binding PreviousTabCommand}" />
    <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}" />
    <KeyBinding Key="F4" Modifiers="Control" Command="{Binding CloseTabCommand}" />
    <KeyBinding Key="F2" Command="{Binding RenamePageCommand}" />
    <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding PrintPreviewCommand}" />
    <KeyBinding Key="L" Modifiers="Control" Command="{Binding ToggleObjectLockCommand}" />
    <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
    <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ZoomActualCommand}" />
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ZoomFitCommand}" />
    <KeyBinding Key="B" Modifiers="Control" Command="{Binding BringToFrontCommand}" />
    <KeyBinding Key="B" Modifiers="Control+Shift" Command="{Binding SendToBackCommand}" />
  </Window.InputBindings>

  <DockPanel>

    <!-- ═════════════ Title bar ═════════════ -->
    <Border DockPanel.Dock="Top" Height="46" Background="{DynamicResource Br.TitleBarGradient}"
            BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <!-- The product logo itself, not a stand-in glyph on a gradient tile. -->
          <Image Source="/Assets/logo.png" Width="28" Height="28" Margin="0,0,10,0"
                 RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
          <TextBlock VerticalAlignment="Center" FontSize="15.5" Margin="0,0,22,0">
            <Run Text="Label" FontFamily="{StaticResource Font.UiExtraBold}" Foreground="{DynamicResource Br.Text}" />
            <Run Text="Maker" FontFamily="{StaticResource Font.UiExtraBold}" Foreground="{DynamicResource Br.Accent}" />
          </TextBlock>

          <Menu Background="Transparent" VerticalAlignment="Center">
            <MenuItem Header="_File">
              <MenuItem Header="_New Project…" InputGestureText="Ctrl+N" Command="{Binding NewCommand}" />
              <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" />
              <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentProjects}">
                <MenuItem.ItemContainerStyle>
                  <Style TargetType="MenuItem">
                    <Setter Property="Header" Value="{Binding Title}" />
                    <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Setter Property="CommandParameter" Value="{Binding Path}" />
                  </Style>
                </MenuItem.ItemContainerStyle>
              </MenuItem>
              <Separator />
              <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
              <MenuItem Header="Save _As…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
              <Separator />
              <MenuItem Header="_Label manager…" Command="{Binding TemplateManagerCommand}" />
              <MenuItem Header="Label si_ze…" Command="{Binding LabelSizeCommand}" />
              <Separator />
              <MenuItem Header="Se_ttings…" Command="{Binding SettingsCommand}" />
              <MenuItem Header="_About Label Maker" Command="{Binding AboutCommand}" />
              <Separator />
              <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>

            <MenuItem Header="_Edit">
              <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
              <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
              <Separator />
              <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Command="{Binding CutCommand}" />
              <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}" />
              <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" />
              <MenuItem Header="_Duplicate" InputGestureText="Ctrl+D" Command="{Binding DuplicateCommand}" />
              <MenuItem Header="De_lete" InputGestureText="Del" Command="{Binding DeleteCommand}" />
              <MenuItem Header="Select _all" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
              <Separator />
              <MenuItem Header="_Find…" InputGestureText="Ctrl+F" Command="{Binding FindCommand}" />
              <MenuItem Header="Find and _replace…" InputGestureText="Ctrl+H" Command="{Binding FindReplaceCommand}" />
              <Separator />
              <MenuItem Header="_Group" InputGestureText="Ctrl+G" Command="{Binding GroupCommand}" />
              <MenuItem Header="U_ngroup" InputGestureText="Ctrl+Shift+G" Command="{Binding UngroupCommand}" />
              <MenuItem Header="_Lock / unlock" InputGestureText="Ctrl+L" Command="{Binding ToggleObjectLockCommand}" />
              <Separator />
              <MenuItem Header="Rotate 90° _right" Command="{Binding RotateCommand}" CommandParameter="90" />
              <MenuItem Header="Rotate 90° _left" Command="{Binding RotateCommand}" CommandParameter="-90" />
              <MenuItem Header="Flip _horizontal" Command="{Binding FlipHorizontalCommand}" />
              <MenuItem Header="Flip _vertical" Command="{Binding FlipVerticalCommand}" />
            </MenuItem>

            <MenuItem Header="D_ata">
              <MenuItem Header="_Import CSV / Excel…" Command="{Binding ImportDataCommand}" />
              <MenuItem Header="Connect to _database…" Command="{Binding ConnectDatabaseCommand}" />
              <MenuItem Header="_Edit connection…" Command="{Binding EditConnectionCommand}" />
              <MenuItem Header="_Refresh records" InputGestureText="F5" Command="{Binding RefreshDataCommand}" />
              <MenuItem Header="_Records…" InputGestureText="Ctrl+T" Command="{Binding DataTableCommand}" />
              <MenuItem Header="_Clear data source" Command="{Binding ClearDataCommand}" />
              <Separator />
              <MenuItem Header="Manage _sequences…" Command="{Binding SequencesCommand}" />
              <MenuItem Header="Duplicate _check…" Command="{Binding DuplicateCheckCommand}" />
              <Separator />
              <MenuItem Header="_Bulk Barcode Generator…" Command="{Binding BulkBarcodeCommand}" />
              <MenuItem Header="Barcode i_mage…" Command="{Binding BarcodeImageCommand}" />
              <Separator />
              <MenuItem Header="Add _data field…" Command="{Binding AddDataFieldCommand}" />
              <MenuItem Header="Add date / time field" Command="{Binding AddDateFieldCommand}" />
            </MenuItem>

            <MenuItem Header="_Print">
              <MenuItem Header="_Print…" InputGestureText="Ctrl+P" Command="{Binding PrintCommand}" />
              <MenuItem Header="_Advanced Print Settings…" Command="{Binding PrintSettingsCommand}" />
              <MenuItem Header="Print Pre_view…" Command="{Binding PrintPreviewCommand}" />
              <MenuItem Header="Print _History…" Command="{Binding PrintHistoryCommand}" />
              <MenuItem Header="Printer _Calibration Wizard…" Command="{Binding CalibrationCommand}" />
              <Separator />
              <MenuItem Header="Pre_flight check…" Command="{Binding PreflightCommand}" />
              <Separator />
              <MenuItem Header="_Export">
                <MenuItem Header="Sheet to PDF…" Command="{Binding ExportSheetPdfCommand}" />
                <MenuItem Header="Current label to PNG…" Command="{Binding ExportLabelPngCommand}" />
                <MenuItem Header="Current label to SVG…" Command="{Binding ExportLabelSvgCommand}" />
              </MenuItem>
            </MenuItem>

            <MenuItem Header="_Scale">
              <MenuItem Header="Zoom in" Command="{Binding ZoomInCommand}" />
              <MenuItem Header="Zoom out" Command="{Binding ZoomOutCommand}" />
              <MenuItem Header="Fit label" Command="{Binding ZoomFitCommand}" />
              <MenuItem Header="Actual size (100%)" Command="{Binding ZoomActualCommand}" />
              <Separator />
              <MenuItem Header="_Rulers" IsCheckable="True" IsChecked="{Binding ShowRulers}" />
              <MenuItem Header="_Guides" IsCheckable="True" IsChecked="{Binding ShowGuides}" />
              <MenuItem Header="_Lock guides" IsCheckable="True" IsChecked="{Binding LockGuides}" />
              <MenuItem Header="Clear guides" Command="{Binding ClearGuidesCommand}" />
              <Separator />
              <MenuItem Header="Show grid" IsCheckable="True" IsChecked="{Binding ShowGrid}" />
              <MenuItem Header="Snap to grid" IsCheckable="True" IsChecked="{Binding SnapToGrid}" />
              <MenuItem Header="Snap to guides" IsCheckable="True" IsChecked="{Binding SnapToGuides}" />
              <MenuItem Header="Snap to objects" IsCheckable="True" IsChecked="{Binding SnapToObjects}" />
            </MenuItem>
          </Menu>
        </StackPanel>

        <!-- window buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource WindowChromeButton}" Click="OnMinimise" ToolTip="Minimise">
            <Path Data="M 0,0 L 10,0" Stroke="{DynamicResource Br.Text2}" StrokeThickness="1.2" />
          </Button>
          <Button Style="{StaticResource WindowChromeButton}" Click="OnMaximise" ToolTip="Maximise">
            <Path Data="M 0,0 L 9,0 L 9,9 L 0,9 Z" Stroke="{DynamicResource Br.Text2}" StrokeThickness="1.2" />
          </Button>
          <Button Style="{StaticResource WindowCloseButton}" Click="OnClose" ToolTip="Close">
            <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{DynamicResource Br.Text2}" StrokeThickness="1.2" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═════════════ Tool bar ═════════════ -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Br.Bg}"
            BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,0,0,1">
      <Grid Margin="10,8">
        <StackPanel Orientation="Horizontal">
          <RadioButton Style="{StaticResource ToolTile}" IsChecked="True" GroupName="tool" ToolTip="Select / move objects">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{StaticResource Icon.Select}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Select" /></StackPanel>
          </RadioButton>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding AddTextCommand}" ToolTip="Add a text box">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{StaticResource Icon.Text}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Text" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding AddImageCommand}" ToolTip="Add an image">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{StaticResource Icon.Image}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Image" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding AddBarcodeCommand}" ToolTip="Add a barcode">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{StaticResource Icon.Barcode}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Barcode" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding AddQrCodeCommand}" ToolTip="Add a QR code">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{StaticResource Icon.QrCode}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="QR Code" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding AddTableCommand}" ToolTip="Add a table">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{StaticResource Icon.Table}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Table" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" ToolTip="Add a shape" Click="OnAlignMenu">
            <StackPanel Orientation="Horizontal">
              <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{StaticResource Icon.Shape}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Shapes" /></StackPanel>
              <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource Br.TextMuted}" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="_Rectangle" Command="{Binding AddShapeCommand}" CommandParameter="rectangle" />
                <MenuItem Header="R_ounded rectangle" Command="{Binding AddShapeCommand}" CommandParameter="round" />
                <MenuItem Header="_Ellipse / circle" Command="{Binding AddShapeCommand}" CommandParameter="ellipse" />
                <Separator />
                <MenuItem Header="_Triangle" Command="{Binding AddShapeCommand}" CommandParameter="triangle" />
                <MenuItem Header="_Diamond" Command="{Binding AddShapeCommand}" CommandParameter="diamond" />
                <MenuItem Header="_Pentagon" Command="{Binding AddShapeCommand}" CommandParameter="pentagon" />
                <MenuItem Header="_Hexagon" Command="{Binding AddShapeCommand}" CommandParameter="hexagon" />
                <MenuItem Header="Oc_tagon" Command="{Binding AddShapeCommand}" CommandParameter="octagon" />
                <Separator />
                <MenuItem Header="5-point _star" Command="{Binding AddShapeCommand}" CommandParameter="star5" />
                <MenuItem Header="6-point star" Command="{Binding AddShapeCommand}" CommandParameter="star6" />
                <MenuItem Header="_Burst (12 points)" Command="{Binding AddShapeCommand}" CommandParameter="burst" />
                <Separator />
                <MenuItem Header="Dashed _box" Command="{Binding AddShapeCommand}" CommandParameter="dashedbox" />
                <MenuItem Header="_Custom polygon…" ToolTip="Adds a polygon; set the point count and star ratio in Shape Settings"
                          Command="{Binding AddShapeCommand}" CommandParameter="pentagon" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" ToolTip="Add a line" Click="OnAlignMenu">
            <StackPanel Orientation="Horizontal">
              <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{StaticResource Icon.Line}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Lines" /></StackPanel>
              <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource Br.TextMuted}" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="_Solid line" Command="{Binding AddShapeCommand}" CommandParameter="line" />
                <MenuItem Header="_Hairline (0.1 mm)" Command="{Binding AddShapeCommand}" CommandParameter="hairline" />
                <Separator />
                <MenuItem Header="_Dashed line" Command="{Binding AddShapeCommand}" CommandParameter="dashed" />
                <MenuItem Header="D_otted line" Command="{Binding AddShapeCommand}" CommandParameter="dotted" />
                <MenuItem Header="Dash-dot line" Command="{Binding AddShapeCommand}" CommandParameter="dashdot" />
                <Separator />
                <MenuItem Header="_Arrow" Command="{Binding AddShapeCommand}" CommandParameter="arrow" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>

          <Rectangle Style="{StaticResource ToolDivider}" />

          <Button Style="{StaticResource ToolTileButton}" ToolTip="Align selected objects" Click="OnAlignMenu">
            <StackPanel Orientation="Horizontal">
              <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{StaticResource Icon.Align}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Align" /></StackPanel>
              <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource Br.TextMuted}" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Align left" Command="{Binding AlignLeftCommand}" />
                <MenuItem Header="Align centre" Command="{Binding CenterHorizontalCommand}" />
                <MenuItem Header="Align right" Command="{Binding AlignRightCommand}" />
                <Separator />
                <MenuItem Header="Align top" Command="{Binding AlignTopCommand}" />
                <MenuItem Header="Align middle" Command="{Binding CenterVerticalCommand}" />
                <MenuItem Header="Align bottom" Command="{Binding AlignBottomCommand}" />
                <Separator />
                <MenuItem Header="Distribute horizontally" Command="{Binding DistributeHorizontallyCommand}"
                          ToolTip="Equal gaps between three or more objects" />
                <MenuItem Header="Distribute vertically" Command="{Binding DistributeVerticallyCommand}" />
                <Separator />
                <MenuItem Header="Match width" Command="{Binding MatchWidthCommand}" ToolTip="Use the first selected object's width" />
                <MenuItem Header="Match height" Command="{Binding MatchHeightCommand}" />
                <MenuItem Header="Match size" Command="{Binding MatchSizeCommand}" />
                <Separator />
                <MenuItem Header="Align to label" IsCheckable="True" IsChecked="{Binding AlignToLabel}"
                          ToolTip="Off: one object aligns to the label, several align to each other" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" ToolTip="Arrange z-order" Click="OnAlignMenu">
            <StackPanel Orientation="Horizontal">
              <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{StaticResource Icon.Arrange}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Arrange" /></StackPanel>
              <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource Br.TextMuted}" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Bring to front" Command="{Binding BringToFrontCommand}" />
                <MenuItem Header="Bring forward" Command="{Binding BringForwardCommand}" />
                <MenuItem Header="Send backward" Command="{Binding SendBackwardCommand}" />
                <MenuItem Header="Send to back" Command="{Binding SendToBackCommand}" />
                <Separator />
                <MenuItem Header="Rotate 90° right" Command="{Binding RotateCommand}" CommandParameter="90" />
                <MenuItem Header="Rotate 90° left" Command="{Binding RotateCommand}" CommandParameter="-90" />
                <MenuItem Header="Rotate 180°" Command="{Binding RotateCommand}" CommandParameter="180" />
                <Separator />
                <MenuItem Header="Flip horizontal" Command="{Binding FlipHorizontalCommand}" />
                <MenuItem Header="Flip vertical" Command="{Binding FlipVerticalCommand}" />
                <Separator />
                <MenuItem Header="Free transform" InputGestureText="Ctrl+Shift+T" Command="{Binding FreeTransformCommand}"
                          ToolTip="Corners resize, side handles skew, the knob rotates" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>

          <Rectangle Style="{StaticResource ToolDivider}" />

          <Button Style="{StaticResource ToolTileButton}" Command="{Binding GroupCommand}" ToolTip="Group (Ctrl+G)">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{StaticResource Icon.Group}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Group" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding UngroupCommand}" ToolTip="Ungroup (Ctrl+Shift+G)">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{StaticResource Icon.Ungroup}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Ungroup" /></StackPanel>
          </Button>

          <Rectangle Style="{StaticResource ToolDivider}" />

          <Button Style="{StaticResource ToolTileButton}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{StaticResource Icon.ZoomOut}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Zoom Out" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding ZoomActualCommand}" ToolTip="Actual size">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{StaticResource Icon.ZoomFit}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="100%" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolTileButton}" Command="{Binding ZoomInCommand}" ToolTip="Zoom in">
            <StackPanel><Image Style="{StaticResource ToolTileIcon}" Source="{StaticResource Icon.ZoomIn}" /><TextBlock Style="{StaticResource ToolTileLabel}" Text="Zoom In" /></StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource GhostButton}" Command="{Binding PrintPreviewCommand}" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource Icon.Eye}" Width="16" Height="16" Margin="0,0,8,0" />
              <TextBlock Text="Preview" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding PrintCommand}">
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource Icon.PrintWhite}" Width="16" Height="16" Margin="0,0,8,0" />
              <TextBlock Text="Print" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═════════════ Status bar ═════════════ -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Br.Bg}"
            BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,1,0,0" Padding="14,7">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="{StaticResource Icon.Check}" Width="15" Height="15" Margin="0,0,7,0" />
          <TextBlock Text="{Binding SaveStateText}" Style="{StaticResource StatusText}" Margin="0,0,16,0" />
          <Rectangle Style="{StaticResource StatusDivider}" />
          <Image Source="{StaticResource Icon.FileDoc}" Width="15" Height="15" Margin="0,0,7,0" />
          <TextBlock Text="{Binding DocumentTabTitle}" Style="{StaticResource StatusText}" Margin="0,0,16,0" />
          <Rectangle Style="{StaticResource StatusDivider}" />
          <Image Source="{StaticResource Icon.Sheet}" Width="15" Height="15" Margin="0,0,7,0" />
          <TextBlock Text="{Binding SheetSummary}" Style="{StaticResource StatusText}" Margin="0,0,16,0" />
          <Rectangle Style="{StaticResource StatusDivider}" />
          <Image Source="{StaticResource Icon.Search}" Width="15" Height="15" Margin="0,0,7,0" />
          <TextBlock Text="{Binding ZoomText}" Style="{StaticResource StatusText}" Margin="0,0,16,0" />
          <Rectangle Style="{StaticResource StatusDivider}" />

          <!-- Steps the canvas through the merged records, one at a time. -->
          <Image Source="{StaticResource Icon.Database}" Width="15" Height="15" Margin="0,0,7,0" />
          <Button Content="⏮" Style="{StaticResource IconGhost}" MinWidth="24" ToolTip="First record"
                  Command="{Binding FirstRecordCommand}" />
          <Button Content="◀" Style="{StaticResource IconGhost}" MinWidth="24" ToolTip="Previous record"
                  Command="{Binding PrevRecordCommand}" />
          <TextBlock Text="{Binding RecordText}" Style="{StaticResource StatusText}" VerticalAlignment="Center"
                     MinWidth="58" TextAlignment="Center" />
          <Button Content="▶" Style="{StaticResource IconGhost}" MinWidth="24" ToolTip="Next record"
                  Command="{Binding NextRecordCommand}" />
          <Button Content="⏭" Style="{StaticResource IconGhost}" MinWidth="24" ToolTip="Last record"
                  Command="{Binding LastRecordCommand}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="{DynamicResource Br.Surface2}" BorderBrush="{DynamicResource Br.Border}" BorderThickness="1"
                  CornerRadius="8" Padding="10,4" Margin="0,0,14,0">
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource Icon.Print}" Width="14" Height="14" Margin="0,0,7,0" />
              <TextBlock Text="{Binding PrinterName}" Style="{StaticResource StatusText}" />
            </StackPanel>
          </Border>
          <Ellipse Width="8" Height="8" Fill="{DynamicResource Br.Ok}" VerticalAlignment="Center" Margin="0,0,7,0" />
          <TextBlock Text="{Binding CalibrationStatus}" Style="{StaticResource StatusText}" Margin="0,0,16,0" />
          <Image Source="{StaticResource Icon.Database}" Width="15" Height="15" Margin="0,0,7,0" />
          <TextBlock Text="{Binding RecordsReadyText}" Style="{StaticResource StatusText}" Margin="0,0,14,0" />
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding PrintCommand}" Padding="16,6">
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource Icon.PrintWhite}" Width="15" Height="15" Margin="0,0,7,0" />
              <TextBlock Text="Print All" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═════════════ Workspace ═════════════ -->
    <Grid Background="{DynamicResource Br.Surface}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="308" MinWidth="240" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="344" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <!-- ───────── Left panel ───────── -->
      <Border Grid.Column="0" Background="{DynamicResource Br.Bg}"
              BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="16,10,16,0">
              <RadioButton GroupName="LeftTab" Content="Templates" Style="{StaticResource PanelTab}" Margin="0,0,22,0"
                           IsChecked="{Binding SelectedLeftTab, Converter={StaticResource IntEquals}, ConverterParameter=0}" />
              <RadioButton GroupName="LeftTab" Content="Assets" Style="{StaticResource PanelTab}" Margin="0,0,22,0"
                           IsChecked="{Binding SelectedLeftTab, Converter={StaticResource IntEquals}, ConverterParameter=1}" />
              <RadioButton GroupName="LeftTab" Content="Data" Style="{StaticResource PanelTab}"
                           IsChecked="{Binding SelectedLeftTab, Converter={StaticResource IntEquals}, ConverterParameter=2}" />
            </StackPanel>
          </Border>

          <!--
            All three tab bodies share one Grid cell. They used to be siblings of a
            DockPanel, where only the last child fills and the others dock to the
            left at their own content width, so the panel changed size depending on
            which tab (and how much content) was showing.
          -->
          <Grid>

          <!-- Templates tab -->
          <DockPanel Visibility="{Binding SelectedLeftTab, Converter={StaticResource IntEqualsVis}, ConverterParameter=0}">
            <Border DockPanel.Dock="Top" Style="{StaticResource SearchField}" Margin="14,14,14,10">
              <DockPanel>
                <Image DockPanel.Dock="Left" Source="{StaticResource Icon.Search}" Width="15" Height="15" Margin="2,0,8,0" />
                <TextBox Style="{StaticResource PlainTextBox}" Tag="Search templates…"
                         Text="{Binding TemplateSearchText, UpdateSourceTrigger=PropertyChanged}" />
              </DockPanel>
            </Border>

            <!-- Browses the sheets that are actually installed; there is no online gallery. -->
            <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                    Padding="12,8" Margin="14,10,14,14" Command="{Binding TemplateManagerCommand}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Browse all templates" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Image Source="{StaticResource Icon.ArrowRightWhite}" Width="15" Height="15" />
              </StackPanel>
            </Button>

            <ListBox ItemsSource="{Binding TemplateCategories}" SelectedItem="{Binding SelectedCategory}"
                     Style="{StaticResource SidebarList}" Margin="8,0,8,0">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SidebarItem}" />
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9"
                            Background="{DynamicResource Br.AccentSoft}" Margin="0,0,11,0">
                      <Image Width="17" Height="17" Source="{Binding IconKey, Converter={StaticResource IconLookup}}" />
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.UiSemiBold}" FontSize="12.5"
                               Foreground="{DynamicResource Br.TextMuted}" Margin="8,0,2,0" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="13"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource Br.TextMuted}"
                                 TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <!-- Assets tab: the objects on this page, plus page management -->
          <DockPanel Visibility="{Binding SelectedLeftTab, Converter={StaticResource IntEqualsVis}, ConverterParameter=1}"
                     Margin="14,12,14,14">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="PAGES" Style="{StaticResource PanelSectionHeader}" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="+" ToolTip="Add page" Command="{Binding AddPageCommand}" Style="{StaticResource IconGhost}" />
                <Button Content="⧉" ToolTip="Duplicate page" Command="{Binding DuplicatePageCommand}" Style="{StaticResource IconGhost}" />
                <Button Content="✕" ToolTip="Remove page" Command="{Binding RemovePageCommand}" Style="{StaticResource IconGhost}" />
              </StackPanel>
            </Grid>
            <Border DockPanel.Dock="Top" Style="{StaticResource InsetPanel}" Height="150" Margin="0,0,0,14">
              <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" DisplayMemberPath="Display"
                       BorderThickness="0" Background="Transparent">
                <ListBox.InputBindings>
                  <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding RenamePageCommand}" />
                </ListBox.InputBindings>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <!-- Right-click selects first, so the menu always acts on the row under the cursor. -->
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnListItemRightClick" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="_Add page" Command="{Binding AddPageCommand}" />
                    <MenuItem Header="_Duplicate page" Command="{Binding DuplicatePageCommand}" />
                    <Separator />
                    <MenuItem Header="_Rename…" InputGestureText="Double-click" Command="{Binding RenamePageCommand}" />
                    <MenuItem Header="Label _size…" Command="{Binding LabelSizeCommand}" />
                    <Separator />
                    <MenuItem Header="_Remove page" Command="{Binding RemovePageCommand}" />
                  </ContextMenu>
                </ListBox.ContextMenu>
              </ListBox>
            </Border>

            <TextBlock DockPanel.Dock="Top" Text="OBJECTS ON PAGE" Style="{StaticResource PanelSectionHeader}" />
            <Border Style="{StaticResource InsetPanel}">
              <ListBox ItemsSource="{Binding ObjectList}" SelectedItem="{Binding SelectedObjectItem}"
                       BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource IconGhost}" MinWidth="22" Padding="2"
                              ToolTip="Lock this object so it stays fixed across labels"
                              Command="{Binding DataContext.ToggleObjectLockCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              CommandParameter="{Binding}">
                        <Image Width="13" Height="13" Source="{Binding Object.Locked, Converter={StaticResource LockIcon}}" />
                      </Button>
                      <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </DockPanel>

          <!-- Data tab: search across the project -->
          <DockPanel Visibility="{Binding SelectedLeftTab, Converter={StaticResource IntEqualsVis}, ConverterParameter=2}"
                     Margin="14,12,14,14">
            <Border DockPanel.Dock="Top" Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="DATA SOURCE" Style="{StaticResource PanelSectionHeader}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding DataSourceSummary}" FontSize="12.5" Margin="0,0,0,10" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                  <Button Content="Import file…" Command="{Binding ImportDataCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6" />
                  <Button Content="Database…" Command="{Binding ConnectDatabaseCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                          ToolTip="Read records from SQLite, SQL Server, MySQL, PostgreSQL, Access or ODBC" />
                  <Button Content="Records…" Command="{Binding DataTableCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                          ToolTip="See, edit, filter and print chosen records (Ctrl+T)" />
                  <Button Content="Refresh" Command="{Binding RefreshDataCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                          ToolTip="Read the file or database again (F5)" />
                  <Button Content="Clear" Command="{Binding ClearDataCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,6" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <DockPanel DockPanel.Dock="Top">
              <Button DockPanel.Dock="Right" Content="Find &amp; replace…" Style="{StaticResource GhostButton}"
                      Padding="10,4" Margin="0,0,0,6" Command="{Binding FindReplaceCommand}"
                      ToolTip="Replace text, barcode values and table cells across every page (Ctrl+H)" />
              <TextBlock Text="SEARCH PROJECT" Style="{StaticResource PanelSectionHeader}" VerticalAlignment="Center" />
            </DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource SearchField}" Margin="0,0,0,10">
              <DockPanel>
                <Image DockPanel.Dock="Left" Source="{StaticResource Icon.Search}" Width="15" Height="15" Margin="2,0,8,0" />
                <TextBox Style="{StaticResource PlainTextBox}" Tag="Search text, barcodes, records…"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
              </DockPanel>
            </Border>
            <Border Style="{StaticResource InsetPanel}">
              <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}"
                       DisplayMemberPath="Display" BorderThickness="0" Background="Transparent" />
            </Border>
          </DockPanel>

          </Grid>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

      <!-- ───────── Centre: document tabs + canvas + data table ───────── -->
      <DockPanel Grid.Column="2">
        <!-- document tab strip -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Br.Surface2}"
                BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,0,0,1" Padding="10,6,10,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,4">
              <Button Style="{StaticResource IconGhost}" MinWidth="28" Command="{Binding OpenCommand}"
                      ToolTip="Open a project in a new tab (Ctrl+O)">
                <Image Source="{StaticResource Icon.Open}" Width="14" Height="14" />
              </Button>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly">
              <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="Tab" CornerRadius="9,9,0,0" BorderThickness="1,1,1,0" Padding="12,7,6,7"
                              Margin="0,0,4,0" MaxWidth="240" Cursor="Hand" ToolTip="{Binding ToolTip}"
                              Background="Transparent" BorderBrush="Transparent"
                              MouseLeftButtonDown="OnTabMouseDown" MouseUp="OnTabMouseUp">
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="_Close" InputGestureText="Ctrl+W"
                                      Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="Close _others"
                                      Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <Border.Tag>
                          <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                        </Border.Tag>
                        <DockPanel>
                          <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconGhost}"
                                  MinWidth="20" Padding="4,0" Margin="8,0,0,0" ToolTip="Close (Ctrl+W)"
                                  Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" Opacity="0.55" />
                          <Ellipse x:Name="Dirty" DockPanel.Dock="Right" Width="7" Height="7" Margin="8,0,0,0"
                                   Fill="{DynamicResource Br.Accent}" VerticalAlignment="Center" Visibility="Collapsed"
                                   ToolTip="Unsaved changes" />
                          <Image DockPanel.Dock="Left" Source="{StaticResource Icon.FileDoc}" Width="13" Height="13"
                                 Margin="0,0,7,0" VerticalAlignment="Center" Opacity="0.7" />
                          <TextBlock x:Name="Caption" Text="{Binding Title}" VerticalAlignment="Center"
                                     FontSize="12.5" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource Br.Text2}" />
                        </DockPanel>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Br.Bg}" />
                          <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Br.Border}" />
                          <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource Br.Accent}" />
                          <Setter TargetName="Caption" Property="FontFamily" Value="{StaticResource Font.UiSemiBold}" />
                          <Setter TargetName="CloseButton" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                          <Setter TargetName="Dirty" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger SourceName="Tab" Property="IsMouseOver" Value="True">
                          <Setter TargetName="CloseButton" Property="Opacity" Value="1" />
                        </Trigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource IconGhost}" MinWidth="28" Margin="2,0,0,4" Command="{Binding NewCommand}"
                        ToolTip="New project in a new tab (Ctrl+N)" VerticalAlignment="Center">
                  <Image Source="{StaticResource Icon.Plus}" Width="14" Height="14" />
                </Button>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>


        <!-- canvas -->
        <Border Background="{DynamicResource CanvasBackground}" ClipToBounds="True">
          <Border x:Name="CanvasHost" ClipToBounds="True" />
        </Border>
      </DockPanel>

      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" />

      <!-- ───────── Right panel ───────── -->
      <Border Grid.Column="4" Background="{DynamicResource Br.Bg}"
              BorderBrush="{DynamicResource Br.Border}" BorderThickness="1,0,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="16,10,16,0">
              <RadioButton GroupName="RightTab" Content="Properties" Style="{StaticResource PanelTab}" Margin="0,0,22,0"
                           IsChecked="{Binding SelectedRightTab, Converter={StaticResource IntEquals}, ConverterParameter=0}" />
              <RadioButton GroupName="RightTab" Content="Layers" Style="{StaticResource PanelTab}" Margin="0,0,22,0"
                           IsChecked="{Binding SelectedRightTab, Converter={StaticResource IntEquals}, ConverterParameter=1}" />
              <RadioButton GroupName="RightTab" Content="Page" Style="{StaticResource PanelTab}"
                           IsChecked="{Binding SelectedRightTab, Converter={StaticResource IntEquals}, ConverterParameter=2}" />
            </StackPanel>
          </Border>

          <!-- One cell for all three tab bodies (see the left panel for why). -->
          <Grid>

          <!-- Layers tab -->
          <DockPanel Visibility="{Binding SelectedRightTab, Converter={StaticResource IntEqualsVis}, ConverterParameter=1}"
                     Margin="14,12,14,14">
            <TextBlock DockPanel.Dock="Top" Text="OBJECTS, FRONT TO BACK" Style="{StaticResource PanelSectionHeader}" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Bring forward" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Command="{Binding BringForwardCommand}" />
              <Button Content="Send backward" Style="{StaticResource GhostButton}" Command="{Binding SendBackwardCommand}" />
            </StackPanel>
            <Border Style="{StaticResource InsetPanel}">
              <ListBox ItemsSource="{Binding ObjectList}" SelectedItem="{Binding SelectedObjectItem}"
                       DisplayMemberPath="Display" BorderThickness="0" Background="Transparent" />
            </Border>
          </DockPanel>

          <!-- Page tab -->
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding SelectedRightTab, Converter={StaticResource IntEqualsVis}, ConverterParameter=2}">
            <StackPanel Margin="14,12,14,14">
              <TextBlock Text="LABEL SHEET" Style="{StaticResource PanelSectionHeader}" />
              <Border Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,0,0,12">
                <TextBlock Text="{Binding TemplateSummary}" TextWrapping="Wrap" FontSize="12.5" />
              </Border>
              <Button Content="Change template…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                      Command="{Binding TemplateManagerCommand}" Margin="0,0,0,14" />

              <TextBlock Text="CURRENT PAGE" Style="{StaticResource PanelSectionHeader}" />
              <Border Style="{StaticResource InsetPanel}" Padding="12,10">
                <StackPanel>
                  <TextBlock Text="{Binding ActivePageName}" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="13" />
                  <TextBlock Text="{Binding SelectionInfo}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                             Foreground="{DynamicResource Br.TextMuted}" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Properties tab -->
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding SelectedRightTab, Converter={StaticResource IntEqualsVis}, ConverterParameter=0}">
            <StackPanel Margin="14,12,14,16" DataContext="{Binding Properties}">

              <!-- Object Properties -->
              <ToggleButton x:Name="Sec1" Style="{StaticResource SectionHeader}" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <Image Source="{StaticResource Icon.Sliders}" Width="16" Height="16" Margin="0,0,9,0" />
                  <TextBlock Text="Object Properties" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <StackPanel Style="{StaticResource SectionBody}" Visibility="{Binding IsChecked, ElementName=Sec1, Converter={StaticResource BoolToVis}}">
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource InverseBool}}">
                  <TextBlock Text="No object selected" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="13" />
                  <TextBlock Text="Select an object on the canvas to edit its properties."
                             TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Br.TextMuted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                  <DockPanel Margin="0,2"><TextBlock Text="Name" Style="{StaticResource FieldLabel}" Width="86" /><TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                  <DockPanel Margin="0,6,0,2">
                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBlock Text="{Binding TypeName}" VerticalAlignment="Center" FontFamily="{StaticResource Font.UiMedium}" />
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox Content="Locked" IsChecked="{Binding Locked}" Margin="0,0,16,0" />
                    <CheckBox Content="Visible" IsChecked="{Binding Visible}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <!-- Text Settings -->
              <ToggleButton x:Name="Sec2" Style="{StaticResource SectionHeader}"
                            IsChecked="{Binding IsText, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                  <Image Source="{StaticResource Icon.Text}" Width="16" Height="16" Margin="0,0,9,0" />
                  <TextBlock Text="Text Settings" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <StackPanel Style="{StaticResource SectionBody}" Visibility="{Binding IsChecked, ElementName=Sec2, Converter={StaticResource BoolToVis}}">
                <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                  <TextBox Text="{Binding TextContent, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True"
                           MinHeight="54" TextWrapping="Wrap" Margin="0,0,0,4" />
                  <TextBlock FontSize="11.5" Foreground="{DynamicResource Br.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"
                             Text="Double-click the text on the canvas to edit it in place and format single words." />
                  <TextBlock FontSize="11.5" Foreground="{DynamicResource Br.Accent}" TextWrapping="Wrap" Margin="0,0,0,8"
                             Visibility="{Binding HasMixedFormatting, Converter={StaticResource BoolToVis}}"
                             Text="Some words have their own formatting. Changing a style below applies it to the whole box." />

                  <DockPanel Margin="0,3">
                    <TextBlock Text="Font" Style="{StaticResource FieldLabel}" Width="86" />
                    <ComboBox IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding FontFamilies}"
                              SelectedItem="{Binding FontFamily}" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Size (pt)" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBox DockPanel.Dock="Right" Width="58" Style="{StaticResource NumberBox}"
                             Text="{Binding FontSizePt, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" />
                    <Slider Minimum="4" Maximum="72" Value="{Binding FontSizePt, Delay=250}" Margin="0,0,8,0" />
                  </DockPanel>

                  <!-- style toggles -->
                  <WrapPanel Margin="86,6,0,4">
                    <ToggleButton Content="B" FontFamily="{StaticResource Font.UiSemiBold}" Style="{StaticResource StyleToggle}"
                                  IsChecked="{Binding Bold}" ToolTip="Bold" />
                    <ToggleButton Content="I" FontStyle="Italic" Style="{StaticResource StyleToggle}"
                                  IsChecked="{Binding Italic}" ToolTip="Italic" />
                    <ToggleButton Style="{StaticResource StyleToggle}" IsChecked="{Binding Underline}" ToolTip="Underline">
                      <TextBlock Text="U" TextDecorations="Underline" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource StyleToggle}" IsChecked="{Binding Strikethrough}" ToolTip="Strikethrough">
                      <TextBlock Text="S" TextDecorations="Strikethrough" />
                    </ToggleButton>
                  </WrapPanel>

                  <!-- colours -->
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Colour" Style="{StaticResource FieldLabel}" Width="86" />
                    <Button DockPanel.Dock="Right" Content="…" MinWidth="30" Padding="6,4" Margin="6,0,0,0"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            CommandParameter="text" />
                    <Border Width="26" Background="{Binding TextColorBrush}" CornerRadius="6" Margin="0,0,6,0"
                            BorderBrush="{DynamicResource Br.BorderStrong}" BorderThickness="1" />
                    <TextBox Text="{Binding TextColorHex, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Font.Mono}" />
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Swatches}" Margin="86,2,0,4">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Width="18" Height="18" Margin="0,0,4,4" Padding="0"
                                Background="{Binding Converter={StaticResource HexBrush}}"
                                BorderBrush="{DynamicResource Br.BorderStrong}" BorderThickness="1" ToolTip="{Binding}"
                                Command="{Binding DataContext.ApplySwatchCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                CommandParameter="{Binding StringFormat=text|{0}}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Highlight" Style="{StaticResource FieldLabel}" Width="86" />
                    <Button DockPanel.Dock="Right" Content="…" MinWidth="30" Padding="6,4" Margin="6,0,0,0"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            CommandParameter="highlight" />
                    <Border Width="26" Background="{Binding HighlightBrush}" CornerRadius="6" Margin="0,0,6,0"
                            BorderBrush="{DynamicResource Br.BorderStrong}" BorderThickness="1" />
                    <TextBox Text="{Binding HighlightHex, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Font.Mono}" />
                  </DockPanel>

                  <!-- layout -->
                  <DockPanel Margin="0,8,0,3">
                    <TextBlock Text="Align" Style="{StaticResource FieldLabel}" Width="86" />
                    <ComboBox ItemsSource="{Binding HorizontalAlignments}" SelectedItem="{Binding TextAlign}" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Vertical" Style="{StaticResource FieldLabel}" Width="86" />
                    <ComboBox ItemsSource="{Binding VerticalAlignments}" SelectedItem="{Binding TextVerticalAlign}" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Line spacing" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBlock DockPanel.Dock="Right" Width="38" TextAlignment="Right" FontSize="11.5"
                               Foreground="{DynamicResource Br.TextMuted}" Text="{Binding LineSpacing, StringFormat=0.00}" />
                    <Slider Minimum="0.5" Maximum="3" Value="{Binding LineSpacing, Delay=250}" Margin="0,0,8,0" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Letter spacing" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBlock DockPanel.Dock="Right" Width="38" TextAlignment="Right" FontSize="11.5"
                               Foreground="{DynamicResource Br.TextMuted}" Text="{Binding LetterSpacingEm, StringFormat=0.00}" />
                    <Slider Minimum="-0.2" Maximum="1" Value="{Binding LetterSpacingEm, Delay=250}" Margin="0,0,8,0" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Padding" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding UnitSymbol}" Width="24" Margin="6,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Br.TextMuted}" FontSize="11.5" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding TextPadding, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Direction" Style="{StaticResource FieldLabel}" Width="86" />
                    <ComboBox ItemsSource="{Binding TextDirections}" SelectedItem="{Binding TextDirectionValue}" />
                  </DockPanel>

                  <!-- fitting -->
                  <CheckBox Content="Wrap long lines" IsChecked="{Binding WordWrap}" Margin="0,8,0,3" />
                  <DockPanel Margin="0,3">
                    <TextBlock Text="When it overflows" Style="{StaticResource FieldLabel}" Width="86" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding AutoFitModes}" SelectedItem="{Binding AutoFit}"
                              ToolTip="None clips; ShrinkToFit reduces the size; ResizeBox grows the box" />
                  </DockPanel>
                  <DockPanel Margin="0,3" Visibility="{Binding IsShrinkToFit, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Smallest (pt)" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding MinAutoFitPt, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" />
                  </DockPanel>

                  <TextBlock Text="Use {Field} tokens for variable data." Foreground="{DynamicResource Br.TextMuted}"
                             TextWrapping="Wrap" FontSize="11.5" Margin="0,8,0,0" />
                </StackPanel>
                <TextBlock Text="Select a text object to edit its typography."
                           Visibility="{Binding IsText, Converter={StaticResource InverseBool}}"
                           Foreground="{DynamicResource Br.TextMuted}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>

              <!-- Barcode Settings -->
              <ToggleButton x:Name="Sec3" Style="{StaticResource SectionHeader}" IsChecked="{Binding IsBarcode, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                  <Image Source="{StaticResource Icon.Barcode}" Width="16" Height="16" Margin="0,0,9,0" />
                  <TextBlock Text="Barcode Settings" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <StackPanel Style="{StaticResource SectionBody}" Visibility="{Binding IsChecked, ElementName=Sec3, Converter={StaticResource BoolToVis}}">
                <StackPanel Visibility="{Binding IsBarcode, Converter={StaticResource BoolToVis}}">
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Barcode Type" Style="{StaticResource FieldLabel}" Width="86" />
                    <ComboBox ItemsSource="{Binding Symbologies}" SelectedItem="{Binding Symbology}" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Value" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBox Text="{Binding BarcodeData, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Font.Mono}" />
                  </DockPanel>
                  <!-- digits under / above the bars (linear codes only) -->
                  <DockPanel Margin="0,8,0,3" Visibility="{Binding IsLinear, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Digits" Style="{StaticResource FieldLabel}" Width="86" />
                    <ComboBox ItemsSource="{Binding HriPositions}" SelectedItem="{Binding HriPosition}" />
                  </DockPanel>
                  <StackPanel Visibility="{Binding ShowHumanReadable, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,3" Visibility="{Binding IsLinear, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="Digit font" Style="{StaticResource FieldLabel}" Width="86" />
                      <ComboBox IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding FontFamilies}"
                                SelectedItem="{Binding HriFontFamily}" />
                    </DockPanel>
                    <DockPanel Margin="0,3" Visibility="{Binding IsLinear, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="Text size (pt)" Style="{StaticResource FieldLabel}" Width="86" />
                      <TextBox Style="{StaticResource NumberBox}" Text="{Binding HriFontSizePt, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" />
                    </DockPanel>
                  </StackPanel>

                  <!-- colours -->
                  <DockPanel Margin="0,6,0,3">
                    <TextBlock Text="Bar colour" Style="{StaticResource FieldLabel}" Width="86" />
                    <Button DockPanel.Dock="Right" Content="…" MinWidth="30" Padding="6,4" Margin="6,0,0,0" Style="{StaticResource GhostButton}"
                            Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="bar" />
                    <Border Width="26" Background="{Binding BarColorBrush}" CornerRadius="6" Margin="0,0,6,0"
                            BorderBrush="{DynamicResource Br.BorderStrong}" BorderThickness="1" />
                    <TextBox Text="{Binding BarColorHex, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Font.Mono}" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Background" Style="{StaticResource FieldLabel}" Width="86" />
                    <Button DockPanel.Dock="Right" Content="…" MinWidth="30" Padding="6,4" Margin="6,0,0,0" Style="{StaticResource GhostButton}"
                            Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="barbg" />
                    <Border Width="26" Background="{Binding BarBackgroundBrush}" CornerRadius="6" Margin="0,0,6,0"
                            BorderBrush="{DynamicResource Br.BorderStrong}" BorderThickness="1" />
                    <TextBox Text="{Binding BarBackgroundHex, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Font.Mono}" />
                  </DockPanel>
                  <TextBlock FontSize="11.5" Foreground="{DynamicResource Br.TextMuted}" TextWrapping="Wrap" Margin="86,2,0,4"
                             Text="Dark bars on a light background scan most reliably." />

                  <!-- encoding options -->
                  <DockPanel Margin="0,6,0,3">
                    <TextBlock Text="Quiet zone" Style="{StaticResource FieldLabel}" Width="86" ToolTip="Blank margin each side, in modules" />
                    <TextBlock DockPanel.Dock="Right" Width="38" TextAlignment="Right" FontSize="11.5"
                               Foreground="{DynamicResource Br.TextMuted}" Text="{Binding QuietZoneModules, StringFormat=0}" />
                    <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding QuietZoneModules, Delay=250}" Margin="0,0,8,0" />
                  </DockPanel>
                  <CheckBox Content="Add check digit" IsChecked="{Binding AddCheckDigit}" Margin="0,4,0,3"
                            Visibility="{Binding CheckDigitIsOptional, Converter={StaticResource BoolToVis}}"
                            ToolTip="Code 39, Interleaved 2 of 5 and MSI make the check digit optional" />
                  <CheckBox Content="GS1 mode — treat (nn) groups as Application Identifiers" IsChecked="{Binding Gs1Mode}"
                            Margin="0,4,0,3" Visibility="{Binding IsLinear, Converter={StaticResource BoolToVis}}" />
                  <DockPanel Margin="0,3" Visibility="{Binding IsQr, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Error correction" Style="{StaticResource FieldLabel}" Width="86" TextWrapping="Wrap"
                               ToolTip="Higher levels survive more damage but make the code denser" />
                    <ComboBox ItemsSource="{Binding QrLevels}" SelectedItem="{Binding QrEcLevel}" />
                  </DockPanel>
                  <DockPanel Margin="0,3" Visibility="{Binding IsPdf417, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Columns" Style="{StaticResource FieldLabel}" Width="86" ToolTip="0 = automatic" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding Pdf417Columns, StringFormat=0, UpdateSourceTrigger=LostFocus}" />
                  </DockPanel>
                  <DockPanel Margin="0,3" Visibility="{Binding Is2D, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Encoding" Style="{StaticResource FieldLabel}" Width="86" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding Encodings}" Text="{Binding CharacterEncoding, UpdateSourceTrigger=LostFocus}" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Barcode height" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding BarHeightMm, StringFormat=0.# mm, UpdateSourceTrigger=LostFocus}" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Module width" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding ModuleWidthMm, StringFormat=0.## mm, UpdateSourceTrigger=LostFocus}" />
                  </DockPanel>
                  <CheckBox Content="Auto-size to symbol" IsChecked="{Binding BarcodeAutoSize}" Margin="0,8,0,0" />
                  <TextBlock Text="{Binding BarcodeValidationMessage}" Foreground="{DynamicResource Br.Danger}"
                             TextWrapping="Wrap" FontSize="11.5" Margin="0,8,0,0" />
                </StackPanel>
                <TextBlock Text="Select a barcode or QR code to edit its symbology and value."
                           Visibility="{Binding IsBarcode, Converter={StaticResource InverseBool}}"
                           Foreground="{DynamicResource Br.TextMuted}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>

              <!-- Table Settings -->
              <ToggleButton x:Name="SecTable" Style="{StaticResource SectionHeader}" IsChecked="{Binding IsTable, Mode=OneWay}"
                            Visibility="{Binding IsTable, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                  <Image Source="{StaticResource Icon.Table}" Width="16" Height="16" Margin="0,0,9,0" />
                  <TextBlock Text="Table Settings" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <StackPanel Style="{StaticResource SectionBody}" Visibility="{Binding IsChecked, ElementName=SecTable, Converter={StaticResource BoolToVis}}">
                <StackPanel Visibility="{Binding IsTable, Converter={StaticResource BoolToVis}}">
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" />
                      <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Rows" Style="{StaticResource FieldLabel}" Width="40" />
                    <TextBox Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding TableRows, StringFormat=0, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="3" Text="Columns" Style="{StaticResource FieldLabel}" Width="54" />
                    <TextBox Grid.Column="4" Style="{StaticResource NumberBox}" Text="{Binding TableColumns, StringFormat=0, UpdateSourceTrigger=LostFocus}" />
                  </Grid>

                  <TextBlock Text="CELLS" Style="{StaticResource PanelSectionHeader}" Margin="0,6,0,4" />
                  <ItemsControl ItemsSource="{Binding TableCells}" Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.TableColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" Margin="0,0,3,3" FontSize="11.5"
                                 ToolTip="Cell text — {Field} tokens work here too" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <CheckBox Content="First row is a header" IsChecked="{Binding TableHeader}" Margin="0,6,0,3" />
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Header fill" Style="{StaticResource FieldLabel}" Width="86" />
                    <Button DockPanel.Dock="Right" Content="…" MinWidth="30" Padding="6,4" Margin="6,0,0,0" Style="{StaticResource GhostButton}"
                            Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="tablefill" />
                    <TextBox Text="{Binding TableHeaderFillHex, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Font.Mono}" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Border" Style="{StaticResource FieldLabel}" Width="86" />
                    <Button DockPanel.Dock="Right" Content="…" MinWidth="30" Padding="6,4" Margin="6,0,0,0" Style="{StaticResource GhostButton}"
                            Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="tableborder" />
                    <TextBox Text="{Binding TableBorderHex, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Font.Mono}" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Border width" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding TableBorderWidth, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Font" Style="{StaticResource FieldLabel}" Width="86" />
                    <ComboBox IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding TableFontFamily}" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Size (pt)" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding TableFontSize, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Align" Style="{StaticResource FieldLabel}" Width="86" />
                    <ComboBox ItemsSource="{Binding HorizontalAlignments}" SelectedItem="{Binding TableAlign}" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Cell padding" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding TablePadding, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                  </DockPanel>
                </StackPanel>
              </StackPanel>

              <!-- Image Settings -->
              <ToggleButton x:Name="Sec4" Style="{StaticResource SectionHeader}" IsChecked="{Binding IsImage, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                  <Image Source="{StaticResource Icon.Image}" Width="16" Height="16" Margin="0,0,9,0" />
                  <TextBlock Text="Image Settings" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <StackPanel Style="{StaticResource SectionBody}" Visibility="{Binding IsChecked, ElementName=Sec4, Converter={StaticResource BoolToVis}}">
                <StackPanel Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                  <DockPanel Margin="0,2">
                    <TextBlock Text="Source" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBlock Text="{Binding ImageSourceFileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <TextBlock Text="{Binding ImageResolution}" FontSize="11.5" Margin="86,2,0,0"
                             Foreground="{DynamicResource Br.TextMuted}" TextWrapping="Wrap" />
                  <Button Content="Replace image…" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8"
                          Command="{Binding DataContext.ReplaceImageCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />

                  <!-- Crop -->
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Crop" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBlock Text="{Binding CropSummary}" VerticalAlignment="Center" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" Margin="86,4,0,6">
                    <Button Content="Crop…" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                            Command="{Binding DataContext.CropImageCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                    <Button Content="Reset" Style="{StaticResource GhostButton}"
                            IsEnabled="{Binding HasCrop}"
                            Command="{Binding DataContext.ClearCropCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                  </StackPanel>

                  <DockPanel Margin="0,3">
                    <TextBlock Text="Crop to shape" Style="{StaticResource FieldLabel}" Width="86" />
                    <ComboBox ItemsSource="{Binding ClipShapes}" SelectedItem="{Binding ClipShape}"
                              ToolTip="Clips the image to a circle or a rounded box" />
                  </DockPanel>
                  <DockPanel Margin="0,3" Visibility="{Binding IsRoundedClip, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Clip radius" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBox DockPanel.Dock="Right" Width="52" Style="{StaticResource NumberBox}"
                             Text="{Binding ClipCornerRadiusMm, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" />
                    <Slider Minimum="0" Maximum="20" Value="{Binding ClipCornerRadiusMm}" Margin="0,0,8,0" />
                  </DockPanel>

                  <DockPanel Margin="0,3"><TextBlock Text="Fit" Style="{StaticResource FieldLabel}" Width="86" /><ComboBox ItemsSource="{Binding ImageFitModes}" SelectedItem="{Binding FitMode}" /></DockPanel>
                  <CheckBox Content="Allow stretching (ignore aspect ratio)" IsChecked="{Binding AllowStretch}" Margin="0,6,0,3"
                            ToolTip="Off keeps the image's proportions when the box is resized" />

                  <DockPanel Margin="0,3">
                    <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBox DockPanel.Dock="Right" Width="52" Style="{StaticResource NumberBox}"
                             Text="{Binding ImageOpacity, StringFormat=0.00, UpdateSourceTrigger=LostFocus}" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding ImageOpacity}" Margin="0,0,8,0" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Brightness" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBox DockPanel.Dock="Right" Width="52" Style="{StaticResource NumberBox}"
                             Text="{Binding Brightness, StringFormat=0.00, UpdateSourceTrigger=LostFocus}" />
                    <Slider Minimum="-1" Maximum="1" Value="{Binding Brightness}" Margin="0,0,8,0" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Contrast" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBox DockPanel.Dock="Right" Width="52" Style="{StaticResource NumberBox}"
                             Text="{Binding Contrast, StringFormat=0.00, UpdateSourceTrigger=LostFocus}" />
                    <Slider Minimum="-1" Maximum="1" Value="{Binding Contrast}" Margin="0,0,8,0" />
                  </DockPanel>
                  <CheckBox Content="Grayscale" IsChecked="{Binding Grayscale}" Margin="0,8,0,3" />
                  <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Flip horizontal" IsChecked="{Binding FlipHorizontal}" Margin="0,0,16,0" />
                    <CheckBox Content="Flip vertical" IsChecked="{Binding FlipVertical}" />
                  </StackPanel>
                </StackPanel>
                <TextBlock Text="Select an image to adjust fit, opacity and colour."
                           Visibility="{Binding IsImage, Converter={StaticResource InverseBool}}"
                           Foreground="{DynamicResource Br.TextMuted}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>

              <!-- Shape Settings -->
              <ToggleButton x:Name="Sec5" Style="{StaticResource SectionHeader}" IsChecked="{Binding IsShape, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                  <Image Source="{StaticResource Icon.Shape}" Width="16" Height="16" Margin="0,0,9,0" />
                  <TextBlock Text="Shape Settings" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <StackPanel Style="{StaticResource SectionBody}" Visibility="{Binding IsChecked, ElementName=Sec5, Converter={StaticResource BoolToVis}}">
                <StackPanel Visibility="{Binding IsShape, Converter={StaticResource BoolToVis}}">
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Shape" Style="{StaticResource FieldLabel}" Width="86" />
                    <ComboBox ItemsSource="{Binding ShapeKinds}" SelectedItem="{Binding ShapeKindValue}" />
                  </DockPanel>

                  <!-- Fill -->
                  <DockPanel Margin="0,8,0,3">
                    <TextBlock Text="Fill" Style="{StaticResource FieldLabel}" Width="86" />
                    <Button DockPanel.Dock="Right" Content="…" MinWidth="30" Padding="6,4" Margin="6,0,0,0"
                            Style="{StaticResource GhostButton}" ToolTip="Colour picker, sliders and eyedropper"
                            Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            CommandParameter="fill" />
                    <Border Width="26" Background="{Binding FillBrush}" CornerRadius="6" Margin="0,0,6,0"
                            BorderBrush="{DynamicResource Br.BorderStrong}" BorderThickness="1" />
                    <TextBox Text="{Binding FillHex, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Font.Mono}" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Fill opacity" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBlock Text="{Binding FillAlpha, StringFormat={}{0:0}%}" Width="38" TextAlignment="Right"
                               DockPanel.Dock="Right" Foreground="{DynamicResource Br.TextMuted}" FontSize="11.5" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding FillAlpha}" />
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Swatches}" Margin="86,2,0,6">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Width="18" Height="18" Margin="0,0,4,4" Padding="0"
                                Background="{Binding Converter={StaticResource HexBrush}}"
                                BorderBrush="{DynamicResource Br.BorderStrong}" BorderThickness="1"
                                ToolTip="{Binding}"
                                Command="{Binding DataContext.ApplySwatchCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                CommandParameter="{Binding StringFormat=fill|{0}}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Gradient -->
                  <CheckBox Content="Gradient fill" IsChecked="{Binding UseGradient}" Margin="0,4,0,3" />
                  <StackPanel Visibility="{Binding UseGradient, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,3">
                      <TextBlock Text="To colour" Style="{StaticResource FieldLabel}" Width="86" />
                      <Button DockPanel.Dock="Right" Content="…" MinWidth="30" Padding="6,4" Margin="6,0,0,0"
                              Style="{StaticResource GhostButton}"
                              Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                              CommandParameter="gradient" />
                      <TextBox Text="{Binding GradientToHex, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Font.Mono}" />
                    </DockPanel>
                    <DockPanel Margin="0,3">
                      <TextBlock Text="Angle" Style="{StaticResource FieldLabel}" Width="86" />
                      <TextBlock DockPanel.Dock="Right" Width="38" TextAlignment="Right" FontSize="11.5"
                                 Foreground="{DynamicResource Br.TextMuted}" Text="{Binding GradientAngle, StringFormat={}{0:0}°}" />
                      <Slider Minimum="0" Maximum="360" Value="{Binding GradientAngle}" Margin="0,0,8,0" />
                    </DockPanel>
                    <Border Height="26" CornerRadius="7" Margin="86,2,0,6" Background="{Binding GradientPreview}"
                            BorderBrush="{DynamicResource Br.BorderStrong}" BorderThickness="1" />
                  </StackPanel>

                  <!-- Stroke -->
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Stroke" Style="{StaticResource FieldLabel}" Width="86" />
                    <Button DockPanel.Dock="Right" Content="…" MinWidth="30" Padding="6,4" Margin="6,0,0,0"
                            Style="{StaticResource GhostButton}" ToolTip="Colour picker, sliders and eyedropper"
                            Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            CommandParameter="stroke" />
                    <Border Width="26" Background="{Binding StrokeBrush}" CornerRadius="6" Margin="0,0,6,0"
                            BorderBrush="{DynamicResource Br.BorderStrong}" BorderThickness="1" />
                    <TextBox Text="{Binding StrokeHex, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Font.Mono}" />
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Swatches}" Margin="86,2,0,6">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Width="18" Height="18" Margin="0,0,4,4" Padding="0"
                                Background="{Binding Converter={StaticResource HexBrush}}"
                                BorderBrush="{DynamicResource Br.BorderStrong}" BorderThickness="1"
                                ToolTip="{Binding}"
                                Command="{Binding DataContext.ApplySwatchCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                CommandParameter="{Binding StringFormat=stroke|{0}}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <DockPanel Margin="0,3">
                    <TextBlock Text="Stroke width" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBox DockPanel.Dock="Right" Width="58" Style="{StaticResource NumberBox}"
                             Text="{Binding StrokeWidthMm, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                    <Slider Minimum="0" Maximum="5" Value="{Binding StrokeWidthMm}" Margin="0,0,8,0" />
                  </DockPanel>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="Line style" Style="{StaticResource FieldLabel}" Width="86" />
                    <ComboBox ItemsSource="{Binding DashStyles}" SelectedItem="{Binding DashStyleValue}" />
                  </DockPanel>

                  <DockPanel Margin="0,3" Visibility="{Binding IsRoundRect, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Corner radius" Style="{StaticResource FieldLabel}" Width="86" />
                    <TextBox DockPanel.Dock="Right" Width="58" Style="{StaticResource NumberBox}"
                             Text="{Binding CornerRadiusMm, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" />
                    <Slider Minimum="0" Maximum="20" Value="{Binding CornerRadiusMm}" Margin="0,0,8,0" />
                  </DockPanel>

                  <StackPanel Visibility="{Binding IsPolygon, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,3">
                      <TextBlock Text="Points" Style="{StaticResource FieldLabel}" Width="86" />
                      <TextBlock DockPanel.Dock="Right" Width="38" TextAlignment="Right" FontSize="11.5"
                                 Foreground="{DynamicResource Br.TextMuted}" Text="{Binding PolygonPoints, StringFormat=0}" />
                      <Slider Minimum="3" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"
                              Value="{Binding PolygonPoints}" Margin="0,0,8,0" />
                    </DockPanel>
                    <DockPanel Margin="0,3">
                      <TextBlock Text="Star depth" Style="{StaticResource FieldLabel}" Width="86" />
                      <TextBlock DockPanel.Dock="Right" Width="38" TextAlignment="Right" FontSize="11.5"
                                 Foreground="{DynamicResource Br.TextMuted}" Text="{Binding StarInnerRatio, StringFormat=0.00}" />
                      <Slider Minimum="0" Maximum="0.95" Value="{Binding StarInnerRatio}" Margin="0,0,8,0"
                              ToolTip="0 keeps a regular polygon; higher values pull the inner points in" />
                    </DockPanel>
                  </StackPanel>
                </StackPanel>
                <TextBlock Text="Select a shape, line or arrow to edit its fill, stroke and geometry."
                           Visibility="{Binding IsShape, Converter={StaticResource InverseBool}}"
                           Foreground="{DynamicResource Br.TextMuted}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>

              <!-- Position & Size -->
              <ToggleButton x:Name="Sec6" Style="{StaticResource SectionHeader}" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <Image Source="{StaticResource Icon.Arrange}" Width="16" Height="16" Margin="0,0,9,0" />
                  <TextBlock Text="Position &amp; Size" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <StackPanel Style="{StaticResource SectionBody}" Visibility="{Binding IsChecked, ElementName=Sec6, Converter={StaticResource BoolToVis}}">
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Skew" Style="{StaticResource FieldLabel}" Width="22"
                               ToolTip="Horizontal / vertical shear in degrees (Ctrl+Alt+drag a side handle, or Free transform)" />
                    <TextBox   Grid.Row="3" Grid.Column="1" Style="{StaticResource NumberBox}" ToolTip="Horizontal skew (°)"
                               Text="{Binding SkewX, StringFormat=0.0, UpdateSourceTrigger=LostFocus}" />
                    <TextBox   Grid.Row="3" Grid.Column="4" Style="{StaticResource NumberBox}" ToolTip="Vertical skew (°)"
                               Text="{Binding SkewY, StringFormat=0.0, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Style="{StaticResource FieldLabel}" Width="22" />
                    <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding X, StringFormat=0.00, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Y" Style="{StaticResource FieldLabel}" Width="22" />
                    <TextBox   Grid.Row="0" Grid.Column="4" Style="{StaticResource NumberBox}" Text="{Binding Y, StringFormat=0.00, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="W" Style="{StaticResource FieldLabel}" Width="22" />
                    <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding Width, StringFormat=0.00, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="H" Style="{StaticResource FieldLabel}" Width="22" />
                    <TextBox   Grid.Row="1" Grid.Column="4" Style="{StaticResource NumberBox}" Text="{Binding Height, StringFormat=0.00, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Rot" Style="{StaticResource FieldLabel}" Width="22" />
                    <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding RotationDegrees, StringFormat=0.0, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="°" Style="{StaticResource FieldLabel}" Width="22" />
                  </Grid>

                  <CheckBox Content="Keep proportions" IsChecked="{Binding LockAspect}" Margin="0,8,0,0"
                            ToolTip="Typing a width also updates the height, like holding Shift while resizing" />

                  <DockPanel Margin="0,10,0,0">
                    <TextBlock Text="Units" Style="{StaticResource FieldLabel}" Width="52" />
                    <ComboBox ItemsSource="{Binding DataContext.DisplayUnits, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                              SelectedItem="{Binding DataContext.DisplayUnit, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                  </DockPanel>
                  <TextBlock Foreground="{DynamicResource Br.TextMuted}" FontSize="11.5" Margin="0,6,0,0"
                             Text="{Binding UnitSymbol, StringFormat=All values shown in {0}. Files always store millimetres.}" />
                </StackPanel>
                <TextBlock Text="Select an object to set exact coordinates."
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBool}}"
                           Foreground="{DynamicResource Br.TextMuted}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>

              <!-- Print Calibration -->
              <ToggleButton x:Name="Sec7" Style="{StaticResource SectionHeader}" IsChecked="False">
                <StackPanel Orientation="Horizontal">
                  <Image Source="{StaticResource Icon.Sliders}" Width="16" Height="16" Margin="0,0,9,0" />
                  <TextBlock Text="Print Calibration" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <StackPanel Style="{StaticResource SectionBody}" Visibility="{Binding IsChecked, ElementName=Sec7, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Br.Text2}"
                           Text="Printers drift by a millimetre or two. The wizard prints a test sheet and stores an X/Y offset per printer so labels land where they should." />
                <Button Content="Calibration wizard…" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        Command="{Binding DataContext.CalibrationCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
              </StackPanel>

              <!-- Export Settings -->
              <ToggleButton x:Name="Sec8" Style="{StaticResource SectionHeader}" IsChecked="False">
                <StackPanel Orientation="Horizontal">
                  <Image Source="{StaticResource Icon.FileDoc}" Width="16" Height="16" Margin="0,0,9,0" />
                  <TextBlock Text="Export Settings" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <StackPanel Style="{StaticResource SectionBody}" Visibility="{Binding IsChecked, ElementName=Sec8, Converter={StaticResource BoolToVis}}">
                <Button Content="Sheet to PDF…" Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                        Command="{Binding DataContext.ExportSheetPdfCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                <Button Content="Label to PNG (300 DPI)…" Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                        Command="{Binding DataContext.ExportLabelPngCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                <Button Content="Label to SVG…" Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                        Command="{Binding DataContext.ExportLabelSvgCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
