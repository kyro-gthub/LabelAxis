<Window x:Class="LabelMaker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Label Maker" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
    <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateCommand}" />
    <KeyBinding Key="G" Modifiers="Control" Command="{Binding GroupCommand}" />
    <KeyBinding Key="G" Modifiers="Control+Shift" Command="{Binding UngroupCommand}" />
    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New Project…" InputGestureText="Ctrl+N" Command="{Binding NewCommand}" />
        <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" />
        <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentProjects}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem">
              <Setter Property="Header" Value="{Binding Title}" />
              <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Setter Property="CommandParameter" Value="{Binding Path}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
        <MenuItem Header="Save _As…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <Separator />
        <MenuItem Header="_Print…" InputGestureText="Ctrl+P" Command="{Binding PrintCommand}" />
        <MenuItem Header="Print Pre_view…" Command="{Binding PrintPreviewCommand}" />
        <MenuItem Header="Printer _Calibration Wizard…" Command="{Binding CalibrationCommand}" />
        <Separator />
        <MenuItem Header="_Export">
          <MenuItem Header="Sheet to PDF…" Command="{Binding ExportSheetPdfCommand}" />
          <MenuItem Header="Current label to PNG…" Command="{Binding ExportLabelPngCommand}" />
          <MenuItem Header="Current label to SVG…" Command="{Binding ExportLabelSvgCommand}" />
        </MenuItem>
        <Separator />
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
        <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
        <Separator />
        <MenuItem Header="_Duplicate" InputGestureText="Ctrl+D" Command="{Binding DuplicateCommand}" />
        <MenuItem Header="_Delete" InputGestureText="Del" Command="{Binding DeleteCommand}" />
        <Separator />
        <MenuItem Header="_Group" InputGestureText="Ctrl+G" Command="{Binding GroupCommand}" />
        <MenuItem Header="_Ungroup" InputGestureText="Ctrl+Shift+G" Command="{Binding UngroupCommand}" />
      </MenuItem>
      <MenuItem Header="_Insert">
        <MenuItem Header="_Text box" Command="{Binding AddTextCommand}" />
        <MenuItem Header="_Barcode / QR" Command="{Binding AddBarcodeCommand}" />
        <MenuItem Header="_Image…" Command="{Binding AddImageCommand}" />
        <MenuItem Header="_Rectangle" Command="{Binding AddRectangleCommand}" />
        <MenuItem Header="R_ounded rectangle" Command="{Binding AddRoundRectCommand}" />
        <MenuItem Header="_Ellipse" Command="{Binding AddEllipseCommand}" />
        <MenuItem Header="_Line" Command="{Binding AddLineCommand}" />
        <MenuItem Header="_Data field…" Command="{Binding AddDataFieldCommand}" />
        <MenuItem Header="Date / time field" Command="{Binding AddDateFieldCommand}" />
      </MenuItem>
      <MenuItem Header="_Arrange">
        <MenuItem Header="Bring to _front" Command="{Binding BringToFrontCommand}" />
        <MenuItem Header="Bring _forward" Command="{Binding BringForwardCommand}" />
        <MenuItem Header="Send _backward" Command="{Binding SendBackwardCommand}" />
        <MenuItem Header="Send to bac_k" Command="{Binding SendToBackCommand}" />
        <Separator />
        <MenuItem Header="Align left" Command="{Binding AlignLeftCommand}" />
        <MenuItem Header="Align top" Command="{Binding AlignTopCommand}" />
        <MenuItem Header="Center horizontally on label" Command="{Binding CenterHorizontalCommand}" />
        <MenuItem Header="Center vertically on label" Command="{Binding CenterVerticalCommand}" />
      </MenuItem>
      <MenuItem Header="_Data">
        <MenuItem Header="_Import CSV / Excel…" Command="{Binding ImportDataCommand}" />
        <MenuItem Header="_Clear data source" Command="{Binding ClearDataCommand}" />
        <Separator />
        <MenuItem Header="Manage _sequences…" Command="{Binding SequencesCommand}" />
        <MenuItem Header="Duplicate _check…" Command="{Binding DuplicateCheckCommand}" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Bulk Barcode Generator…" Command="{Binding BulkBarcodeCommand}" />
        <MenuItem Header="Barcode _image…" Command="{Binding BarcodeImageCommand}" />
        <MenuItem Header="_Preflight check…" Command="{Binding PreflightCommand}" />
        <MenuItem Header="_Formtec template manager…" Command="{Binding TemplateManagerCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Zoom in" Command="{Binding ZoomInCommand}" />
        <MenuItem Header="Zoom out" Command="{Binding ZoomOutCommand}" />
        <MenuItem Header="Fit label" Command="{Binding ZoomFitCommand}" />
        <MenuItem Header="Actual size (100%)" Command="{Binding ZoomActualCommand}" />
        <Separator />
        <MenuItem Header="Show grid" IsCheckable="True" IsChecked="{Binding ShowGrid}" />
        <MenuItem Header="Snap to grid" IsCheckable="True" IsChecked="{Binding SnapToGrid}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About Label Maker" Command="{Binding AboutCommand}" />
      </MenuItem>
    </Menu>

    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <Button Content="New" Style="{StaticResource ToolButton}" Command="{Binding NewCommand}" />
        <Button Content="Open" Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}" />
        <Button Content="Save" Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}" />
        <Separator />
        <Button Content="Undo" Style="{StaticResource ToolButton}" Command="{Binding UndoCommand}" />
        <Button Content="Redo" Style="{StaticResource ToolButton}" Command="{Binding RedoCommand}" />
        <Separator />
        <Button Content="Text" Style="{StaticResource ToolButton}" Command="{Binding AddTextCommand}" />
        <Button Content="Barcode" Style="{StaticResource ToolButton}" Command="{Binding AddBarcodeCommand}" />
        <Button Content="Image" Style="{StaticResource ToolButton}" Command="{Binding AddImageCommand}" />
        <Button Content="Rect" Style="{StaticResource ToolButton}" Command="{Binding AddRectangleCommand}" />
        <Button Content="Ellipse" Style="{StaticResource ToolButton}" Command="{Binding AddEllipseCommand}" />
        <Button Content="Line" Style="{StaticResource ToolButton}" Command="{Binding AddLineCommand}" />
        <Separator />
        <Button Content="Import data" Style="{StaticResource ToolButton}" Command="{Binding ImportDataCommand}" />
        <Button Content="Bulk barcodes" Style="{StaticResource ToolButton}" Command="{Binding BulkBarcodeCommand}" />
        <Button Content="Preflight" Style="{StaticResource ToolButton}" Command="{Binding PreflightCommand}" />
        <Separator />
        <Button Content="Print" Style="{StaticResource ToolButton}" Command="{Binding PrintCommand}" />
      </ToolBar>
    </ToolBarTray>

    <!-- Status bar -->
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem><TextBlock Text="{Binding StatusText}" /></StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock Text="{Binding SelectionInfo}" /></StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource Br.Bg}" BorderBrush="{StaticResource Br.Border}" BorderThickness="1" CornerRadius="6" Padding="2">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Record" Margin="6,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource Br.TextMuted}" />
              <Button Content="⏮" Command="{Binding FirstRecordCommand}" Style="{StaticResource ToolButton}" MinWidth="26" Padding="4,2" />
              <Button Content="◀" Command="{Binding PrevRecordCommand}" Style="{StaticResource ToolButton}" MinWidth="26" Padding="4,2" />
              <TextBlock Text="{Binding RecordText}" Margin="8,0" VerticalAlignment="Center" MinWidth="56" TextAlignment="Center" />
              <Button Content="▶" Command="{Binding NextRecordCommand}" Style="{StaticResource ToolButton}" MinWidth="26" Padding="4,2" />
              <Button Content="⏭" Command="{Binding LastRecordCommand}" Style="{StaticResource ToolButton}" MinWidth="26" Padding="4,2" />
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Br.Bg}" BorderBrush="{StaticResource Br.Border}" BorderThickness="1" CornerRadius="6" Padding="2" Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal">
              <Button Content="−" Command="{Binding ZoomOutCommand}" Style="{StaticResource ToolButton}" MinWidth="26" Padding="4,2" />
              <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" MinWidth="46" TextAlignment="Center" />
              <Button Content="+" Command="{Binding ZoomInCommand}" Style="{StaticResource ToolButton}" MinWidth="26" Padding="4,2" />
              <Button Content="Fit" Command="{Binding ZoomFitCommand}" Style="{StaticResource ToolButton}" Padding="8,2" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StatusBarItem>
    </StatusBar>

    <!-- Main body -->
    <Grid Background="{StaticResource Br.Surface}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" MinWidth="190" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="312" MinWidth="248" />
      </Grid.ColumnDefinitions>

      <!-- Left: pages + objects -->
      <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
        <DockPanel Margin="10,10,10,8">
          <TextBlock DockPanel.Dock="Top" Text="LABEL SHEET" FontWeight="SemiBold" FontSize="11" Margin="2,0,0,4" Foreground="{StaticResource Br.TextMuted}" />
          <Border DockPanel.Dock="Top" Background="{StaticResource Br.Bg}" BorderBrush="{StaticResource Br.Border}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
            <TextBlock Text="{Binding TemplateSummary}" TextWrapping="Wrap" Foreground="{StaticResource Br.Text}" FontSize="12" />
          </Border>
          <TextBlock DockPanel.Dock="Top" Text="SEARCH" FontWeight="SemiBold" FontSize="11" Margin="2,0,0,4" Foreground="{StaticResource Br.TextMuted}" />
          <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
          <ListBox DockPanel.Dock="Top" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}"
                   Height="150" DisplayMemberPath="Display" Margin="0,0,0,10" />
          <TextBlock DockPanel.Dock="Top" Text="OBJECTS" FontWeight="SemiBold" FontSize="11" Margin="2,0,0,4" Foreground="{StaticResource Br.TextMuted}" />
          <ListBox ItemsSource="{Binding ObjectList}" SelectedItem="{Binding SelectedObjectItem}" DisplayMemberPath="Display" />
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

      <!-- Center: designer canvas host -->
      <Border Grid.Column="2" Margin="8" CornerRadius="10" ClipToBounds="True"
              BorderBrush="{StaticResource Br.Border}" BorderThickness="1">
        <Border x:Name="CanvasHost" Background="{StaticResource CanvasBackground}" ClipToBounds="True" />
      </Border>

      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" />

      <!-- Right: properties -->
      <Border Grid.Column="4" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10" DataContext="{Binding Properties}">
            <TextBlock Text="PROPERTIES" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Br.TextMuted}" Margin="2,0,0,6" />
            <TextBlock Text="Select an object on the canvas to edit its exact size and position, or use the mouse wheel to zoom and drag empty space to pan."
                       TextWrapping="Wrap" Foreground="{StaticResource Br.TextMuted}" Margin="2" FontSize="12"
                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBool}}" />

            <GroupBox Header="Position &amp; size (mm)" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Style="{StaticResource FieldLabel}" />
                <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding X, StringFormat=0.00, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" Style="{StaticResource FieldLabel}" Margin="8,0,6,0" />
                <TextBox   Grid.Row="0" Grid.Column="3" Style="{StaticResource NumberBox}" Text="{Binding Y, StringFormat=0.00, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="W" Style="{StaticResource FieldLabel}" />
                <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding Width, StringFormat=0.00, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="H" Style="{StaticResource FieldLabel}" Margin="8,0,6,0" />
                <TextBox   Grid.Row="1" Grid.Column="3" Style="{StaticResource NumberBox}" Text="{Binding Height, StringFormat=0.00, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Rot°" Style="{StaticResource FieldLabel}" />
                <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding RotationDegrees, StringFormat=0.0, UpdateSourceTrigger=LostFocus}" />
              </Grid>
            </GroupBox>

            <GroupBox Header="Object" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Name" Style="{StaticResource FieldLabel}" Width="40" /><TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                <CheckBox Content="Locked" IsChecked="{Binding Locked}" Margin="0,3" />
                <CheckBox Content="Visible" IsChecked="{Binding Visible}" Margin="0,3" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Text" Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBox Text="{Binding TextContent, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="52" TextWrapping="Wrap" />
                <DockPanel Margin="0,4"><TextBlock Text="Font" Style="{StaticResource FieldLabel}" Width="40" /><TextBox Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Size" Style="{StaticResource FieldLabel}" Width="40" /><TextBox Style="{StaticResource NumberBox}" Text="{Binding FontSizePt, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                  <CheckBox Content="Bold" IsChecked="{Binding Bold}" Margin="0,0,10,0" />
                  <CheckBox Content="Italic" IsChecked="{Binding Italic}" />
                </StackPanel>
                <TextBlock Text="Use {Field} tokens for variable data." Foreground="#808080" TextWrapping="Wrap" Margin="0,2" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Barcode" Visibility="{Binding IsBarcode, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Type" Style="{StaticResource FieldLabel}" Width="52" /><ComboBox ItemsSource="{Binding Symbologies}" SelectedItem="{Binding Symbology}" /></DockPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Value" Style="{StaticResource FieldLabel}" Width="52" /><TextBox Text="{Binding BarcodeData, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Module" Style="{StaticResource FieldLabel}" Width="52" /><TextBox Style="{StaticResource NumberBox}" Text="{Binding ModuleWidthMm, StringFormat=0.###, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Bar ht" Style="{StaticResource FieldLabel}" Width="52" /><TextBox Style="{StaticResource NumberBox}" Text="{Binding BarHeightMm, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                <CheckBox Content="Auto-size to symbol" IsChecked="{Binding BarcodeAutoSize}" Margin="0,3" />
                <TextBlock Text="{Binding BarcodeValidationMessage}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,2" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Shape" Visibility="{Binding IsShape, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Fill" Style="{StaticResource FieldLabel}" Width="60" /><TextBox Text="{Binding FillHex, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Stroke" Style="{StaticResource FieldLabel}" Width="60" /><TextBox Text="{Binding StrokeHex, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Stroke mm" Style="{StaticResource FieldLabel}" Width="60" /><TextBox Style="{StaticResource NumberBox}" Text="{Binding StrokeWidthMm, StringFormat=0.###, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Corner mm" Style="{StaticResource FieldLabel}" Width="60" /><TextBox Style="{StaticResource NumberBox}" Text="{Binding CornerRadiusMm, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" /></DockPanel>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
