<Window x:Class="LabelMaker.App.Views.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Project — choose a label sheet" Height="560" Width="720"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="10">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="Search (product code, name, category):" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="SearchBox" />
    </DockPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Create" IsDefault="True" Padding="20,5" Click="OnCreate" />
      <Button Content="Cancel" IsCancel="True" Padding="20,5" Margin="8,0,0,0" />
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="1.4*" />
      </Grid.ColumnDefinitions>

      <ListView x:Name="TemplateList" Grid.Column="0" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnCreate">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Product" Width="90" DisplayMemberBinding="{Binding ProductCode}" />
            <GridViewColumn Header="Brand" Width="70" DisplayMemberBinding="{Binding Brand}" />
            <GridViewColumn Header="Grid" Width="60" DisplayMemberBinding="{Binding GridText}" />
            <GridViewColumn Header="Label mm" Width="90" DisplayMemberBinding="{Binding LabelText}" />
            <GridViewColumn Header="Name" Width="230" DisplayMemberBinding="{Binding Name}" />
          </GridView>
        </ListView.View>
      </ListView>

      <Border Grid.Column="2" BorderBrush="#CCC" BorderThickness="1" Background="#FAFAFA">
        <DockPanel Margin="8">
          <TextBlock x:Name="PreviewTitle" DockPanel.Dock="Top" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock x:Name="PreviewDetail" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#555" />
          <Border Margin="0,10,0,0" Background="White" BorderBrush="#DDD" BorderThickness="1">
            <Canvas x:Name="PreviewCanvas" ClipToBounds="True" />
          </Border>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
