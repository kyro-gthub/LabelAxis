<Window x:Class="LabelMaker.App.Views.NewProjectWindow"
        xmlns:helpsvc="clr-namespace:LabelMaker.App.Services"
        xmlns:views="clr-namespace:LabelMaker.App.Views"
        helpsvc:HelpGuide.Topic="label-sheets"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="New Project" Height="780" Width="1180" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <!-- Two ways to start: a finished design, or an empty label on a sheet of your choice. -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Br.Bg}" BorderBrush="{DynamicResource Br.Border}"
            BorderThickness="0,0,0,1" Padding="18,14,18,0">
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="DesignsTab" GroupName="newtab" Style="{StaticResource PanelTab}" IsChecked="True" Margin="0,0,24,0"
                     Content="Ready-made designs" Click="OnTab" AutomationProperties.AutomationId="NewProject.DesignsTab" />
        <RadioButton x:Name="SheetsTab" GroupName="newtab" Style="{StaticResource PanelTab}"
                     Content="Blank label sheet" Click="OnTab" AutomationProperties.AutomationId="NewProject.SheetsTab" />
      </StackPanel>
    </Border>

    <Grid>
      <views:DesignGalleryView x:Name="Gallery" />
      <!-- On the gallery's bottom strip, beside the fill choice. -->
          <StackPanel x:Name="DesignButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,14">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="DesignCreateButton" Content="Use this design" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="OnCreateFromDesign" AutomationProperties.AutomationId="NewProject.UseDesign" />
          </StackPanel>

  <DockPanel x:Name="SheetsPanel" Margin="10" Visibility="Collapsed">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="Search (product code, name, category):" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="SearchBox" />
    </DockPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="SheetCreateButton" Content="Create" Padding="20,5" Click="OnCreate" AutomationProperties.AutomationId="NewProject.Create" />
        <Button Content="Cancel" IsCancel="True" Padding="20,5" Margin="8,0,0,0" />
      </StackPanel>
      <!-- Any size, not only the sheets in the list. -->
      <Button x:Name="CustomSizeButton" Content="Custom size…" Padding="14,5" HorizontalAlignment="Left" Click="OnCustomSize"
              AutomationProperties.AutomationId="NewProject.CustomSize"
              ToolTip="Make a label of any width and height, on A4 or any paper, with your own margins and gaps" />
    </DockPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="1.4*" />
      </Grid.ColumnDefinitions>

      <ListView x:Name="TemplateList" Grid.Column="0" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnCreate">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Product" Width="90" DisplayMemberBinding="{Binding ProductCode}" />
            <GridViewColumn Header="Brand" Width="70" DisplayMemberBinding="{Binding Brand}" />
            <GridViewColumn Header="Grid" Width="60" DisplayMemberBinding="{Binding GridText}" />
            <GridViewColumn Header="Label mm" Width="100" DisplayMemberBinding="{Binding LabelText}" />
            <GridViewColumn Header="Name" Width="230" DisplayMemberBinding="{Binding Name}" />
          </GridView>
        </ListView.View>
      </ListView>
      <TextBlock x:Name="NoMatches" Grid.Column="0" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                 Foreground="{DynamicResource Br.TextMuted}" />

      <Border Grid.Column="2" BorderBrush="{DynamicResource Br.Border}" BorderThickness="1" CornerRadius="8"
              Background="{DynamicResource Br.Bg}">
        <DockPanel Margin="10">
          <TextBlock x:Name="PreviewTitle" DockPanel.Dock="Top" FontFamily="{StaticResource Font.UiSemiBold}" TextWrapping="Wrap" />
          <TextBlock x:Name="PreviewDetail" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,6,0,0"
                     Foreground="{DynamicResource Br.TextMuted}" />
          <Border Margin="0,10,0,0" Background="{DynamicResource CanvasBackground}" BorderBrush="{DynamicResource Br.Border}" BorderThickness="1">
            <Canvas x:Name="PreviewCanvas" ClipToBounds="True" />
          </Border>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
    </Grid>
  </DockPanel>
</Window>
