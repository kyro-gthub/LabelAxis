<Window x:Class="LabelMaker.App.Views.PrintWindow"
        xmlns:helpsvc="clr-namespace:LabelMaker.App.Services"
        helpsvc:HelpGuide.Topic="printing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="Print" Height="760" Width="820" MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterOwner">
  <DockPanel>

    <!-- header -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Br.Bg}"
            BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,0,0,1" Padding="18,14">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0"
                Background="{DynamicResource Br.AccentSoft}">
          <Image Source="{StaticResource Icon.Print}" Width="18" Height="18" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Print" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="15" />
          <TextBlock x:Name="HeaderSubtitle" FontSize="12" Foreground="{DynamicResource Br.TextMuted}" Margin="0,2,0,0"
                     TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- footer -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Br.Bg}"
            BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,1,0,0" Padding="18,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
          <Button x:Name="PrintButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnPrint">
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource Icon.PrintWhite}" Width="15" Height="15" Margin="0,0,7,0" />
              <TextBlock x:Name="PrintButtonText" Text="Print" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Content="Preview…" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnPreview" />
          <Button Content="History…" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnHistory"
                  ToolTip="Earlier print jobs; reprint or finish one that stopped" />
          <Button Content="Advanced…" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnAdvanced" />
          <Button Content="Windows dialog…" Style="{StaticResource GhostButton}" Click="OnSystemDialog"
                  ToolTip="Opens the printer driver's own dialog for duplex, tray and paper options" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The form stops at a comfortable reading width; the sheet picture takes the rest, so a
         maximized window shows a big sheet instead of a stretched form. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="460" MaxWidth="700" />
        <ColumnDefinition Width="3*" MinWidth="290" />
      </Grid.ColumnDefinitions>

    <!-- sheet thumbnail -->
    <Border Grid.Column="1" Background="{DynamicResource Br.Bg}"
            BorderBrush="{DynamicResource Br.Border}" BorderThickness="1,0,0,0">
      <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="FIRST SHEET" Style="{StaticResource PanelSectionHeader}" />
        <TextBlock DockPanel.Dock="Bottom" x:Name="ThumbCaption" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource Br.TextMuted}" Margin="0,10,0,0" />
        <Border Background="{DynamicResource CanvasBackground}" BorderBrush="{DynamicResource Br.Border}"
                BorderThickness="1" CornerRadius="8" Padding="14">
          <Grid x:Name="ThumbHost" SizeChanged="OnThumbHostSizeChanged" />
        </Border>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="18,16">
      <StackPanel>

        <TextBlock Text="PRINTER" Style="{StaticResource PanelSectionHeader}" />
        <Border Style="{StaticResource InsetPanel}" Padding="14,12" Margin="0,0,0,16">
          <StackPanel>
            <ComboBox x:Name="PrinterBox" SelectionChanged="OnPrinterChanged" />
            <TextBlock x:Name="PrinterStatus" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Br.TextMuted}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Calibration wizard…" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnCalibration" />
              <Button x:Name="NetworkPrintersButton" Content="Wi-Fi printers…" Style="{StaticResource GhostButton}" Click="OnNetworkPrinters"
                      ToolTip="Find a printer on your Wi-Fi or office network and print to it directly, with no driver to install" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="WHAT TO PRINT" Style="{StaticResource PanelSectionHeader}" />
        <Border Style="{StaticResource InsetPanel}" Padding="14,12" Margin="0,0,0,16">
          <StackPanel>
            <RadioButton x:Name="ContentFillBox" GroupName="content" Margin="0,3" Click="OnFieldChanged"
                         Content="Fill the sheet with the master label" />
            <RadioButton x:Name="ContentRecordsBox" GroupName="content" Margin="0,3" Click="OnFieldChanged"
                         Content="One label per data record" />
            <RadioButton x:Name="ContentPagesBox" GroupName="content" Margin="0,3" Click="OnFieldChanged"
                         Content="Pages: several pages on one sheet, one after another" />
            <StackPanel x:Name="PageChoicePanel" Margin="22,6,0,2">
              <RadioButton x:Name="PagesAllBox" GroupName="pages" Margin="0,3" Click="OnFieldChanged"
                           Content="All pages" />
              <RadioButton x:Name="PagesCurrentBox" GroupName="pages" Margin="0,3" Click="OnFieldChanged"
                           Content="Current page" ToolTip="The page that was on screen when you pressed Print" />
              <RadioButton x:Name="PagesChosenBox" GroupName="pages" Margin="0,3" Click="OnFieldChanged"
                           Content="Selected pages" ToolTip="Tick the pages to print below" />
              <Border x:Name="PageListFrame" Margin="22,4,0,0" MaxHeight="220" HorizontalAlignment="Left" MinWidth="340"
                      BorderBrush="{DynamicResource Br.Border}" BorderThickness="1" CornerRadius="6"
                      Background="{DynamicResource Br.Surface}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
                  <StackPanel x:Name="PageList" />
                </ScrollViewer>
              </Border>
              <StackPanel x:Name="PageListButtons" Orientation="Horizontal" Margin="22,6,0,0">
                <Button Content="Tick all" Style="{StaticResource GhostButton}" Padding="10,3" Margin="0,0,6,0" Click="OnTickAllPages" />
                <Button Content="Untick all" Style="{StaticResource GhostButton}" Padding="10,3" Click="OnUntickAllPages" />
              </StackPanel>
            </StackPanel>
            <DockPanel x:Name="CopiesPerPageRow" Margin="22,6,0,4">
              <TextBlock Text="Copies of every page" Style="{StaticResource FieldLabel}" Width="130" />
              <TextBox x:Name="CopiesPerPageBox" Style="{StaticResource NumberBox}" Width="64" HorizontalAlignment="Left" TextChanged="OnCopiesPerPageChanged"
                       ToolTip="Sets every page in the list above to this many copies. Change a page's own box to give it a different number." />
            </DockPanel>
            <TextBlock x:Name="ContentText" TextWrapping="Wrap" FontSize="12.5" Margin="0,8,0,0" />
            <TextBlock x:Name="PositionText" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource Br.Text2}" Margin="0,6,0,0" />
            <Button Content="Start position and page range…" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnAdvanced" />
          </StackPanel>
        </Border>

        <TextBlock Text="COPIES &amp; ORIENTATION" Style="{StaticResource PanelSectionHeader}" />
        <Border Style="{StaticResource InsetPanel}" Padding="14,12" Margin="0,0,0,16">
          <StackPanel>
            <DockPanel Margin="0,3">
              <TextBlock Text="Copies" Style="{StaticResource FieldLabel}" Width="120" />
              <TextBox x:Name="CopiesBox" Style="{StaticResource NumberBox}" Text="1" Width="80"
                       HorizontalAlignment="Left" TextChanged="OnFieldChanged" />
            </DockPanel>
            <DockPanel Margin="0,6,0,3">
              <TextBlock Text="Scale" Style="{StaticResource FieldLabel}" Width="120" />
              <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" FontSize="11.5"
                         Foreground="{DynamicResource Br.TextMuted}" Text="{Binding Text, ElementName=ScaleBox, StringFormat={}{0}%}" />
              <TextBox x:Name="ScaleBox" Style="{StaticResource NumberBox}" Text="100" Width="80"
                       HorizontalAlignment="Left" TextChanged="OnFieldChanged"
                       ToolTip="100% is physical size. Only change this to correct a printer that is off." />
            </DockPanel>
            <DockPanel Margin="0,6,0,3">
              <TextBlock Text="Sheets" Style="{StaticResource FieldLabel}" Width="120" />
              <TextBox x:Name="FirstSheetBox" Style="{StaticResource NumberBox}" Width="64" TextChanged="OnFieldChanged"
                       ToolTip="First sheet to print. Leave both boxes empty to print every sheet." />
              <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource Br.TextMuted}" />
              <TextBox x:Name="LastSheetBox" Style="{StaticResource NumberBox}" Width="64" TextChanged="OnFieldChanged"
                       ToolTip="Last sheet to print. Use this to reprint a jammed sheet or finish a job that stopped." />
              <TextBlock x:Name="SheetRangeHint" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11.5"
                         Foreground="{DynamicResource Br.TextMuted}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="PAPER &amp; MARGINS" Style="{StaticResource PanelSectionHeader}" />
        <Border Style="{StaticResource InsetPanel}" Padding="14,12" Margin="0,0,0,16">
          <StackPanel>
            <DockPanel Margin="0,3">
              <TextBlock Text="Paper size" Style="{StaticResource FieldLabel}" Width="120" />
              <ComboBox x:Name="PaperBox" Width="280" HorizontalAlignment="Left" SelectionChanged="OnPaperChanged" />
            </DockPanel>
            <DockPanel x:Name="CustomPaperRow" Margin="120,6,0,3" Visibility="Collapsed">
              <TextBox x:Name="PaperWidthBox" Style="{StaticResource NumberBox}" Width="64" TextChanged="OnFieldChanged" ToolTip="Paper width in millimetres" />
              <TextBlock Text="×" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource Br.TextMuted}" />
              <TextBox x:Name="PaperHeightBox" Style="{StaticResource NumberBox}" Width="64" TextChanged="OnFieldChanged" ToolTip="Paper height in millimetres" />
              <TextBlock Text="mm" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Br.TextMuted}" />
            </DockPanel>
            <CheckBox x:Name="LandscapeBox" Content="Landscape orientation" Margin="0,8,0,4" Click="OnFieldChanged" />

            <RadioButton x:Name="TemplateMarginsBox" GroupName="margins" Margin="0,8,0,3" Click="OnFieldChanged"
                         Content="Put labels where the sheet template says" />
            <RadioButton x:Name="CustomMarginsBox" GroupName="margins" Margin="0,3" Click="OnFieldChanged"
                         Content="Use my own margins and gaps (fits as many as possible on the paper)" />
            <Grid x:Name="MarginsGrid" Margin="22,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="Top" Style="{StaticResource FieldLabel}" Width="80" />
              <TextBox x:Name="MarginTopBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="64" Margin="0,2,18,2" TextChanged="OnFieldChanged" ToolTip="Paper's top edge to the first row, mm" />
              <TextBlock Grid.Column="2" Text="Bottom" Style="{StaticResource FieldLabel}" Width="80" />
              <TextBox x:Name="MarginBottomBox" Grid.Column="3" Style="{StaticResource NumberBox}" Width="64" Margin="0,2" TextChanged="OnFieldChanged" ToolTip="Space kept clear at the bottom, mm" />
              <TextBlock Grid.Row="1" Text="Left" Style="{StaticResource FieldLabel}" Width="80" />
              <TextBox x:Name="MarginLeftBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}" Width="64" Margin="0,2,18,2" TextChanged="OnFieldChanged" ToolTip="Paper's left edge to the first column, mm" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="Right" Style="{StaticResource FieldLabel}" Width="80" />
              <TextBox x:Name="MarginRightBox" Grid.Row="1" Grid.Column="3" Style="{StaticResource NumberBox}" Width="64" Margin="0,2" TextChanged="OnFieldChanged" ToolTip="Space kept clear on the right, mm" />
              <TextBlock Grid.Row="2" Text="Gap across" Style="{StaticResource FieldLabel}" Width="80" />
              <TextBox x:Name="HGapBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource NumberBox}" Width="64" Margin="0,2,18,2" TextChanged="OnFieldChanged" ToolTip="Space between labels side by side, mm" />
              <TextBlock Grid.Row="2" Grid.Column="2" Text="Gap down" Style="{StaticResource FieldLabel}" Width="80" />
              <TextBox x:Name="VGapBox" Grid.Row="2" Grid.Column="3" Style="{StaticResource NumberBox}" Width="64" Margin="0,2" TextChanged="OnFieldChanged" ToolTip="Space between rows, mm" />
            </Grid>
            <CheckBox x:Name="CenterBox" Content="Centre the labels on the paper" Margin="22,8,0,0" Click="OnFieldChanged" />
            <TextBlock x:Name="LayoutText" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                       Foreground="{DynamicResource Br.Text2}" />
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource Br.AccentSoft}" CornerRadius="10" Padding="14,12">
          <DockPanel>
            <Image DockPanel.Dock="Left" Source="{StaticResource Icon.Check}" Width="16" Height="16"
                   Margin="0,1,10,0" VerticalAlignment="Top" />
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap"
                       FontFamily="{StaticResource Font.UiSemiBold}" FontSize="12.5"
                       Foreground="{DynamicResource Br.Accent}" />
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
