<Window x:Class="LabelMaker.App.Views.SettingsWindow"
        xmlns:helpsvc="clr-namespace:LabelMaker.App.Services"
        xmlns:loc="clr-namespace:LabelMaker.App.Localization"
        helpsvc:HelpGuide.Topic="files"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="Settings" Height="700" Width="520" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
    <StackPanel>
      <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" Foreground="{DynamicResource Br.TextMuted}" />
      <GroupBox>
        <StackPanel>
          <TextBlock Text="Language" Style="{StaticResource FieldLabel}" Margin="0,2,0,4" />
          <ComboBox x:Name="LanguageBox" loc:Localizer.Off="True" DisplayMemberPath="Display" HorizontalAlignment="Left" MinWidth="260"
                    AutomationProperties.AutomationId="Settings.Language" />
          <TextBlock Text="Menus, windows and messages. Technical names such as PDF, QR Code and Wi-Fi stay in English. Used after LabelAxis restarts."
                     TextWrapping="Wrap" Foreground="{DynamicResource Br.TextMuted}" FontSize="11.5" Margin="0,4,0,4" />
          <Separator Margin="0,6" />
          <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" Margin="0,2,0,4" />
          <ListBox x:Name="ThemeList" ItemTemplate="{StaticResource ThemeRow}" Margin="0,0,0,6"
                   AutomationProperties.AutomationId="Settings.Theme" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
          <Button Content="Make your own theme…" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,6"
                  Click="OnCustomTheme" AutomationProperties.AutomationId="Settings.CustomTheme"
                  ToolTip="Your own colours and glow, starting from one of these themes" />
          <TextBlock Text="Changes as soon as you save." TextWrapping="Wrap"
                     Foreground="{DynamicResource Br.TextMuted}" FontSize="11.5" Margin="0,0,0,4" />
          <Separator Margin="0,6" />
          <CheckBox x:Name="ReduceMotionBox" Content="Reduce hover effects (e.g. the top menu's highlight/underline)" Margin="0,4" />
          <TextBlock Text="Turns off the fade/underline that appears while hovering File, Edit, etc. in the menu bar."
                     TextWrapping="Wrap" Foreground="{DynamicResource Br.TextMuted}" FontSize="11.5" Margin="20,2,0,4" />
        </StackPanel>
      </GroupBox>

      <TextBlock Text="Canvas &amp; snapping" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,8" Foreground="{DynamicResource Br.TextMuted}" />
      <GroupBox>
        <StackPanel>
          <DockPanel Margin="0,3">
            <TextBlock Text="Snap tolerance (screen px)" Style="{StaticResource FieldLabel}" Width="190" />
            <TextBox x:Name="SnapPixelsBox" Width="70" HorizontalAlignment="Left" HorizontalContentAlignment="Right" />
          </DockPanel>
          <DockPanel Margin="0,3">
            <TextBlock Text="Grid size (mm)" Style="{StaticResource FieldLabel}" Width="190" />
            <TextBox x:Name="GridSizeBox" Width="70" HorizontalAlignment="Left" HorizontalContentAlignment="Right" />
          </DockPanel>
        </StackPanel>
      </GroupBox>

      <TextBlock Text="Editing" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,8" Foreground="{DynamicResource Br.TextMuted}" />
      <GroupBox>
        <StackPanel>
          <CheckBox x:Name="ConfirmDestructiveBox" Content="Confirm before removing a page or clearing the data source" Margin="0,4" />
        </StackPanel>
      </GroupBox>

      <TextBlock Text="Startup" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,8" Foreground="{DynamicResource Br.TextMuted}" />
      <GroupBox>
        <StackPanel>
          <CheckBox x:Name="ReopenLastProjectBox" Content="Reopen the last project automatically" Margin="0,4" />
          <CheckBox x:Name="ShowWelcomeBox" Content="Show the welcome window when LabelAxis starts" Margin="0,4" />
        </StackPanel>
      </GroupBox>

      <TextBlock Text="Auto-save &amp; recovery" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,8" Foreground="{DynamicResource Br.TextMuted}" />
      <GroupBox>
        <StackPanel>
          <CheckBox x:Name="AutoSaveEnabledBox" Content="Auto-save a recovery snapshot" Margin="0,4" />
          <DockPanel Margin="0,3">
            <TextBlock Text="Interval (seconds, min. 30)" Style="{StaticResource FieldLabel}" Width="190" />
            <TextBox x:Name="AutoSaveSecondsBox" Width="70" HorizontalAlignment="Left" HorizontalContentAlignment="Right" />
          </DockPanel>
        </StackPanel>
      </GroupBox>

      <TextBlock Text="Files" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,8" Foreground="{DynamicResource Br.TextMuted}" />
      <GroupBox>
        <StackPanel>
          <DockPanel Margin="0,3">
            <TextBlock Text="Remembered recent projects" Style="{StaticResource FieldLabel}" Width="190" />
            <TextBox x:Name="MaxRecentBox" Width="70" HorizontalAlignment="Left" HorizontalContentAlignment="Right" />
          </DockPanel>
        </StackPanel>
      </GroupBox>

      <TextBlock Text="Fonts" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,8" Foreground="{DynamicResource Br.TextMuted}" />
      <GroupBox>
        <StackPanel>
          <TextBlock Text="Fonts added from font files, without installing them in Windows. They are in every font list, and a project that uses one keeps a copy inside it."
                     TextWrapping="Wrap" Foreground="{DynamicResource Br.TextMuted}" FontSize="11.5" Margin="0,0,0,6" />
          <ListBox x:Name="FontList" loc:Localizer.Off="True" Height="96" Margin="0,0,0,6" SelectionChanged="OnFontSelected" />
          <StackPanel Orientation="Horizontal">
            <Button Content="Add font…" Padding="12,4" Margin="0,0,8,0" Click="OnAddFont" AutomationProperties.AutomationId="Settings.AddFont" />
            <Button x:Name="RemoveFontButton" Content="Remove" Padding="12,4" IsEnabled="False" Click="OnRemoveFont" />
          </StackPanel>
        </StackPanel>
      </GroupBox>

      <TextBlock Text="Updates" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,8" Foreground="{DynamicResource Br.TextMuted}" />
      <GroupBox>
        <StackPanel>
          <CheckBox x:Name="CheckForUpdatesBox" Content="Check for updates automatically (about once a day)" Margin="0,4"
                    AutomationProperties.AutomationId="Settings.CheckForUpdates" />
          <TextBlock Text="Update address" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
          <TextBox x:Name="UpdateAddressBox" Tag="https://… or \\server\share\LabelAxis" FlowDirection="LeftToRight"
                   AutomationProperties.AutomationId="Settings.UpdateAddress" />
          <TextBlock x:Name="UpdateAddressHint" TextWrapping="Wrap" Foreground="{DynamicResource Br.TextMuted}" FontSize="11.5" Margin="0,4,0,4" />
        </StackPanel>
      </GroupBox>

      <TextBlock Text="About" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,8" Foreground="{DynamicResource Br.TextMuted}" />
      <GroupBox>
        <StackPanel>
          <TextBlock x:Name="AboutTitle" Text="LabelAxis" FontFamily="{StaticResource Font.UiSemiBold}" FontSize="13" Margin="0,2" />
          <TextBlock Text="Label design and printing software. Label sheets, thermal and network printers, barcodes and variable data."
                     TextWrapping="Wrap" Foreground="{DynamicResource Br.TextMuted}" FontSize="11.5" Margin="0,2" />
        </StackPanel>
      </GroupBox>

      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource Br.TextMuted}" Margin="0,10,0,0" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0" AutomationProperties.AutomationId="Settings.Cancel" />
        <Button Content="Save" Style="{StaticResource AccentButton}" IsDefault="True" Padding="20,6" Click="OnSave" AutomationProperties.AutomationId="Settings.Save" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
