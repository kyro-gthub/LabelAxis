<Window x:Class="LabelMaker.App.Views.AddPagesWindow"
        xmlns:helpsvc="clr-namespace:LabelMaker.App.Services"
        helpsvc:HelpGuide.Topic="pages"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Br.Surface}" TextElement.Foreground="{DynamicResource Br.Text}"
        Title="Add pages" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="18">
    <TextBlock Text="WHAT KIND OF PAGES" Style="{StaticResource PanelSectionHeader}" />
    <Border Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,0,0,14">
      <StackPanel>
        <RadioButton x:Name="BlankBox" GroupName="kind" IsChecked="True" Margin="0,3" Click="OnChanged"
                     Content="Blank pages" AutomationProperties.AutomationId="AddPages.Blank" />
        <RadioButton x:Name="CopyBox" GroupName="kind" Margin="0,6,0,3" Click="OnChanged"
                     Content="Copies of a page" AutomationProperties.AutomationId="AddPages.Copy" />
        <ComboBox x:Name="SourceBox" Margin="24,4,0,3" HorizontalAlignment="Stretch" SelectionChanged="OnChanged"
                  DisplayMemberPath="Display" AutomationProperties.AutomationId="AddPages.Source" />
        <CheckBox x:Name="CountUpBox" Margin="24,8,0,3" Click="OnChanged"
                  Content="Count the barcodes up on each copy (BOX-0007, BOX-0008…)"
                  AutomationProperties.AutomationId="AddPages.CountUp" />
      </StackPanel>
    </Border>

    <TextBlock Text="HOW MANY" Style="{StaticResource PanelSectionHeader}" />
    <Border Style="{StaticResource InsetPanel}" Padding="12,10" Margin="0,0,0,14">
      <DockPanel>
        <TextBox x:Name="CountBox" Style="{StaticResource NumberBox}" Width="80" Text="1" TextChanged="OnCountChanged"
                 AutomationProperties.AutomationId="AddPages.Count" />
        <TextBlock x:Name="CountHint" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource Br.TextMuted}" />
      </DockPanel>
    </Border>

    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="AddButton" Content="Add" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnAdd"
                AutomationProperties.AutomationId="AddPages.Add" />
      </StackPanel>
      <TextBlock x:Name="SummaryText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                 FontFamily="{StaticResource Font.UiSemiBold}" FontSize="12.5" Foreground="{DynamicResource Br.Accent}" />
    </DockPanel>
  </StackPanel>
</Window>
