<Window x:Class="LabelMaker.App.Views.SequenceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sequences" Height="420" Width="620" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Add" Padding="14,4" Click="OnAdd" />
      <Button Content="Remove" Padding="14,4" Margin="8,0,0,0" Click="OnRemove" />
      <Button Content="Close" Padding="14,4" Margin="8,0,0,0" IsDefault="True" IsCancel="True" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" x:Name="PreviewText" Foreground="#555" Margin="0,8,0,0" TextWrapping="Wrap" />
    <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
              SelectionChanged="OnSelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120" />
        <DataGridTextColumn Header="Prefix" Binding="{Binding Prefix}" Width="80" />
        <DataGridTextColumn Header="Suffix" Binding="{Binding Suffix}" Width="80" />
        <DataGridTextColumn Header="Start" Binding="{Binding Start}" Width="70" />
        <DataGridTextColumn Header="End" Binding="{Binding End}" Width="70" />
        <DataGridTextColumn Header="Step" Binding="{Binding Step}" Width="55" />
        <DataGridTextColumn Header="Pad" Binding="{Binding Padding}" Width="45" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
