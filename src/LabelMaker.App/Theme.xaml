  <!-- ============================ GridSplitter ============================ -->
  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridSplitter">
