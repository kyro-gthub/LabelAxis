<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ============================ palette (LabelAxis design tokens) ============================ -->
  <!-- surface: white cards/panels/fields · app-bg: workspace behind the artboard · panel-bg: ribbon/status/inset fields -->
  <Color x:Key="Clr.Bg">#FFFFFFFF</Color>
  <Color x:Key="Clr.Surface">#FFF3F5F9</Color>
  <Color x:Key="Clr.Surface2">#FFF8FAFC</Color>
  <Color x:Key="Clr.Border">#14263043</Color>
  <Color x:Key="Clr.BorderStrong">#26263043</Color>
  <Color x:Key="Clr.Text">#FF1D2432</Color>
  <Color x:Key="Clr.TextMuted">#FF8A93A6</Color>
  <Color x:Key="Clr.Text2">#FF5B667C</Color>
  <Color x:Key="Clr.Accent">#FF2C6FE8</Color>
  <Color x:Key="Clr.AccentHover">#FF1F5AC6</Color>
  <Color x:Key="Clr.AccentSoft">#FFE8F1FE</Color>
  <Color x:Key="Clr.Hover">#FFF1F5FA</Color>
  <Color x:Key="Clr.Danger">#FFE0555F</Color>
  <Color x:Key="Clr.Ok">#FF22B268</Color>
  <Color x:Key="Clr.SelectionBlue">#FF2C6FE8</Color>
  <Color x:Key="Clr.HeaderA">#FF3E86F5</Color>
  <Color x:Key="Clr.HeaderB">#FF2C6FE8</Color>
  <Color x:Key="Clr.TitleBarA">#FFFFFFFF</Color>
  <Color x:Key="Clr.TitleBarB">#FFE8F3EE</Color>

  <SolidColorBrush x:Key="Br.Bg"            Color="{DynamicResource Clr.Bg}" />
  <SolidColorBrush x:Key="Br.Surface"       Color="{DynamicResource Clr.Surface}" />
  <SolidColorBrush x:Key="Br.Surface2"      Color="{DynamicResource Clr.Surface2}" />
  <SolidColorBrush x:Key="Br.Border"        Color="{DynamicResource Clr.Border}" />
  <SolidColorBrush x:Key="Br.BorderStrong"  Color="{DynamicResource Clr.BorderStrong}" />
  <SolidColorBrush x:Key="Br.Text"          Color="{DynamicResource Clr.Text}" />
  <SolidColorBrush x:Key="Br.TextMuted"     Color="{DynamicResource Clr.TextMuted}" />
  <SolidColorBrush x:Key="Br.Text2"         Color="{DynamicResource Clr.Text2}" />
  <SolidColorBrush x:Key="Br.Accent"        Color="{DynamicResource Clr.Accent}" />
  <SolidColorBrush x:Key="Br.AccentHover"   Color="{DynamicResource Clr.AccentHover}" />
  <SolidColorBrush x:Key="Br.AccentSoft"    Color="{DynamicResource Clr.AccentSoft}" />
  <SolidColorBrush x:Key="Br.Hover"         Color="{DynamicResource Clr.Hover}" />
  <SolidColorBrush x:Key="Br.Danger"        Color="{DynamicResource Clr.Danger}" />
  <SolidColorBrush x:Key="Br.Ok"            Color="{DynamicResource Clr.Ok}" />
  <SolidColorBrush x:Key="Br.SelectionBlue" Color="{DynamicResource Clr.SelectionBlue}" />
  <SolidColorBrush x:Key="Br.GhostWhite"    Color="#33FFFFFF" />
  <SolidColorBrush x:Key="Br.GhostWhiteHi"  Color="#55FFFFFF" />
  <SolidColorBrush x:Key="Br.GhostBorder"   Color="#40FFFFFF" />

  <!-- brand-grad: the ONE bold accent — active tab pill, primary buttons, badges, "Import Data" icon fill.
       Most chrome stays light; purple is used sparingly, as in the reference. -->
  <LinearGradientBrush x:Key="Br.HeaderGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{DynamicResource Clr.HeaderA}" Offset="0" />
    <GradientStop Color="{DynamicResource Clr.HeaderB}" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Br.AccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{DynamicResource Clr.HeaderA}" Offset="0" />
    <GradientStop Color="{DynamicResource Clr.Accent}" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Br.TitleBarGradient" StartPoint="0,0" EndPoint="1,0.4">
    <GradientStop Color="{DynamicResource Clr.TitleBarA}" Offset="0" />
    <GradientStop Color="#FFF2F7FE" Offset="0.55" />
    <GradientStop Color="#FFE9F2FB" Offset="0.78" />
    <GradientStop Color="{DynamicResource Clr.TitleBarB}" Offset="1" />
  </LinearGradientBrush>

  <!--
    The UI runs on Segoe UI, not an embedded webfont. Embedded OpenType faces are
    hinted for the browser's renderer, so at WPF's UI sizes (11-13px) their stems
    land between pixels and the text reads soft/blurry no matter what ClearType
    settings are applied. Segoe UI ships with Windows, is hinted for exactly these
    sizes, and is what every other Windows app draws with.
  -->
  <FontFamily x:Key="Font.Ui">Segoe UI</FontFamily>
  <FontFamily x:Key="Font.UiMedium">Segoe UI</FontFamily>
  <FontFamily x:Key="Font.UiSemiBold">Segoe UI Semibold, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.UiExtraBold">Segoe UI Black, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Consolas, Courier New</FontFamily>
  <FontFamily x:Key="Font.MonoMedium">Consolas, Courier New</FontFamily>
  <sys:Double x:Key="Font.Size">13</sys:Double>

  <BooleanToVisibilityConverter x:Key="BoolVisConv" />

  <!-- Reusable soft card -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Br.Bg}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="24" ShadowDepth="3" Direction="270" Opacity="0.12" Color="#3B2E9C" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Window ============================ -->
  <!--
    An implicit style is keyed by the EXACT type, so "TargetType=Window" never
    reaches SettingsWindow, PrintSettingsWindow or any other derived class,
    which is why the dialogs used to miss the ClearType / Display-formatting
    setters and looked blurry next to the shell. Every dialog therefore carries
    Style="{StaticResource AppWindow}" explicitly.
  -->
  <Style x:Key="AppWindow" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Br.Bg}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Br.Text}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style TargetType="Window" BasedOn="{StaticResource AppWindow}" />

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
  </Style>

  <!-- ============================ Button ============================ -->
  <Style TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size}" />
    <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
    <Setter Property="Background" Value="{DynamicResource Br.Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Br.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="14" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.Hover}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.AccentSoft}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Br.AccentGradient}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="18,8" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Br.AccentHover}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Ghost pill button for the purple header toolbar -->
  <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{DynamicResource Br.GhostWhite}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Br.GhostBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.GhostWhiteHi}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#59FFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ ToggleButton ============================ -->
  <Style TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Br.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.AccentSoft}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ TextBox ============================ -->
  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size}" />
    <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
    <Setter Property="Background" Value="{DynamicResource Br.Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Br.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="CaretBrush" Value="{DynamicResource Br.Accent}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Br.Accent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
              <Setter TargetName="bd" Property="BorderThickness" Value="1.4" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.Surface}" />
              <Setter Property="Foreground" Value="{DynamicResource Br.TextMuted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Multi-line text (queries, notes): content starts at the top instead of centring. -->
  <Style x:Key="MultiLineTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
              <Setter TargetName="bd" Property="BorderThickness" Value="1.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ PasswordBox ============================ -->
  <Style TargetType="PasswordBox">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size}" />
    <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
    <Setter Property="Background" Value="{DynamicResource Br.Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Br.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="CaretBrush" Value="{DynamicResource Br.Accent}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Br.Accent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
              <Setter TargetName="bd" Property="BorderThickness" Value="1.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- ============================ CheckBox ============================ -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="box" Width="17" Height="17" CornerRadius="4" VerticalAlignment="Center"
                    Background="{DynamicResource Br.Bg}" BorderBrush="{DynamicResource Br.BorderStrong}" BorderThickness="1.3">
              <Path x:Name="tick" Data="M 2,6 L 6,10 L 13,2" Stroke="White" StrokeThickness="2"
                    StrokeEndLineCap="Round" StrokeStartLineCap="Round" Visibility="Collapsed" Margin="1" Stretch="Uniform" />
            </Border>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource Br.Accent}" />
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
              <Setter TargetName="tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ ComboBox ============================ -->
  <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
    <Border x:Name="bd" CornerRadius="6" Background="{DynamicResource Br.Bg}"
            BorderBrush="{DynamicResource Br.BorderStrong}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="22" />
        </Grid.ColumnDefinitions>
        <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
              Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource Br.TextMuted}" />
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size}" />
    <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" Template="{StaticResource ComboToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter x:Name="cp" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                              HorizontalAlignment="Left" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <!--
              Style="{x:Null}": the app-wide TextBox style adds its own padding and
              minimum height, which pushed an editable combo's text below its 28px
              box and clipped it ("Segoe UI" read as "Seaoe UI"). The right margin
              keeps typed text clear of the drop-down arrow.
            -->
            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Margin="6,0,24,0" Padding="2,0"
                     VerticalAlignment="Center" VerticalContentAlignment="Center" MinHeight="0"
                     Visibility="Collapsed" Focusable="True" Background="Transparent" BorderThickness="0"
                     FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                     Foreground="{DynamicResource Br.Text}" CaretBrush="{DynamicResource Br.Text}"
                     SelectionBrush="{DynamicResource Br.Accent}" />
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
              <Border Background="{DynamicResource Br.Bg}" BorderBrush="{DynamicResource Br.BorderStrong}"
                      BorderThickness="1" CornerRadius="6" Margin="0,4,0,0"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" />
                </Border.Effect>
                <ScrollViewer>
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="cp" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}" Background="Transparent">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.AccentSoft}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.AccentSoft}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ GroupBox ============================ -->
  <Style TargetType="GroupBox">
    <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Border Background="{DynamicResource Br.Bg}" BorderBrush="{DynamicResource Br.Border}"
                  BorderThickness="1" CornerRadius="14">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#3B2E9C" />
            </Border.Effect>
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Margin="14,10,14,2" FontWeight="SemiBold" FontSize="12"
                         Foreground="{DynamicResource Br.TextMuted}"
                         Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Menu (styled as the ribbon tab strip) ============================ -->
  <Style TargetType="Menu">
    <Setter Property="Background" Value="{DynamicResource Br.Surface2}" />
    <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UiSemiBold}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="16,0,16,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Menu">
          <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,0,0,1">
            <ItemsPresenter Margin="{TemplateBinding Padding}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Br.Text2}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bd" CornerRadius="10,10,0,0" Padding="9,5" Margin="1,4,1,0" Background="Transparent"
                  BorderBrush="Transparent" BorderThickness="0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="chk" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Path x:Name="check" Grid.Column="0" Width="12" Data="M 0,5 L 4,9 L 11,0" Stroke="{DynamicResource Br.Accent}"
                    StrokeThickness="2" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0"
                         Foreground="{DynamicResource Br.TextMuted}" VerticalAlignment="Center" FontFamily="{StaticResource Font.Ui}" />
              <Path x:Name="arrow" Grid.Column="3" Data="M 0,0 L 4,4 L 0,8 Z" Fill="{DynamicResource Br.TextMuted}"
                    Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
              <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-9" VerticalOffset="2" AllowsTransparency="True"
                     Focusable="False" IsOpen="{TemplateBinding IsSubmenuOpen}" PopupAnimation="Fade">
                <Border Background="{DynamicResource Br.Bg}" BorderBrush="{DynamicResource Br.BorderStrong}"
                        BorderThickness="1" CornerRadius="10" Padding="4"
                        Grid.IsSharedSizeScope="True" MinWidth="190">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#2A1E7A" />
                  </Border.Effect>
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
              <Setter TargetName="arrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.Hover}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.AccentSoft}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
              <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
              <Setter Property="FontFamily" Value="{StaticResource Font.UiSemiBold}" />
              <Setter TargetName="bd" Property="Padding" Value="16,9" />
              <Setter TargetName="bd" Property="BorderThickness" Value="0,0,0,2.5" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Role" Value="TopLevelHeader" />
                <Condition Property="IsHighlighted" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.AccentSoft}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Role" Value="TopLevelHeader" />
                <Condition Property="IsSubmenuOpen" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.Bg}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
            <!-- "Reduce hover effects" (Settings > Appearance): mute the highlight/underline entirely. -->
            <DataTrigger Binding="{Binding ReduceMotion}" Value="True">
              <Setter TargetName="bd" Property="Background" Value="Transparent" />
              <Setter TargetName="bd" Property="BorderBrush" Value="Transparent" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ ContextMenu ============================ -->
  <Style TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size}" />
    <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
