            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.AccentSoft}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource Br.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== panels ==================== -->

  <Style x:Key="PanelTab" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UiSemiBold}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Br.TextMuted}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" BorderThickness="0,0,0,2.5" BorderBrush="Transparent" Padding="0,0,0,9">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource Br.Accent}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="False" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PanelSectionHeader" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.UiSemiBold}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource Br.TextMuted}" />
    <Setter Property="Margin" Value="2,0,0,6" />
  </Style>

  <Style x:Key="InsetPanel" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Br.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Br.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style x:Key="SearchField" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Br.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Br.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <Style x:Key="PlainTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Br.TextMuted}"
                       FontSize="12.5" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value="" />
                <Condition Property="IsFocused" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="ph" Property="Visibility" Value="Visible" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PromoCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Br.AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Br.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Padding" Value="13" />
  </Style>

  <Style x:Key="DocumentTab" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Br.Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Br.Border}" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="CornerRadius" Value="9,9,0,0" />
    <Setter Property="Padding" Value="14,8" />
  </Style>

  <Style x:Key="SidebarList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style x:Key="SidebarItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}"
                  BorderThickness="0">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.AccentSoft}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Collapsible right-panel section: header toggles the body underneath it. -->
  <Style x:Key="SectionHeader" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UiSemiBold}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" CornerRadius="10" Background="Transparent" Padding="10,9">
            <DockPanel>
              <Path x:Name="chev" DockPanel.Dock="Right" Data="M 0,0 L 5,5 L 0,10" Stroke="{DynamicResource Br.TextMuted}"
                    StrokeThickness="1.6" VerticalAlignment="Center" Margin="8,0,2,0"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform Angle="0" />
                </Path.RenderTransform>
              </Path>
              <ContentPresenter VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="chev" Property="RenderTransform">
                <Setter.Value>
                  <RotateTransform Angle="90" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Body of a collapsible section. The view binds its Visibility to the header above it. -->
  <Style x:Key="SectionBody" TargetType="StackPanel">
    <Setter Property="Margin" Value="10,2,4,10" />
  </Style>

  <Style x:Key="StatusText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Br.Text2}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="StatusDivider" TargetType="Rectangle">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Fill" Value="{DynamicResource Br.Border}" />
    <Setter Property="Margin" Value="0,0,16,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
