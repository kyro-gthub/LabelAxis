  <!-- ============================ ToolBar (the ribbon strip: light, one white card inside) ============================ -->
  <Style TargetType="ToolBarTray">
    <Setter Property="Background" Value="{DynamicResource Br.Surface2}" />
  </Style>

  <Style TargetType="ToolBar">
    <Setter Property="Background" Value="{DynamicResource Br.Surface2}" />
    <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
    <Setter Property="OverflowMode" Value="AsNeeded" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolBar">
          <Border Background="{TemplateBinding Background}" Padding="12,8" BorderBrush="{DynamicResource Br.Border}" BorderThickness="0,0,0,1">
            <Border Background="{DynamicResource Br.Bg}" BorderBrush="{DynamicResource Br.Border}" BorderThickness="1" CornerRadius="14" Padding="4,6,4,2">
              <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.06" Color="#232656" />
              </Border.Effect>
              <DockPanel>
                <ToggleButton x:Name="OverflowButton" DockPanel.Dock="Right" Focusable="False" MinWidth="18" Margin="4,0"
                              IsChecked="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              IsEnabled="{TemplateBinding HasOverflowItems}"
                              Visibility="{TemplateBinding HasOverflowItems, Converter={StaticResource BoolVisConv}}">
                  <Path Data="M 0,0 L 7,0 L 3.5,4 Z" Fill="{DynamicResource Br.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ToggleButton>
                <Popup x:Name="OverflowPopup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False"
                       Focusable="False" PopupAnimation="Fade"
                       IsOpen="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}}">
                  <Border Background="{DynamicResource Br.Bg}" BorderBrush="{DynamicResource Br.BorderStrong}" BorderThickness="1" CornerRadius="8" Padding="4">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.2" /></Border.Effect>
                    <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel" WrapWidth="220" Focusable="True"
                                          KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" />
                  </Border>
                </Popup>
                <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True" Margin="0" />
              </DockPanel>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
