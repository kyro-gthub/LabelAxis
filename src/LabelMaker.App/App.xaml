<Application x:Class="LabelMaker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LabelMaker.App.Mvvm"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
      <conv:InverseBoolToVisibilityConverter x:Key="InverseBool" />

      <!-- Aliases kept for MainWindow.xaml -->
      <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource Clr.Surface}" />
      <SolidColorBrush x:Key="PanelBorder" Color="{StaticResource Clr.Border}" />
      <SolidColorBrush x:Key="CanvasBackground" Color="#E9EBF5" />

      <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Foreground" Value="{StaticResource Br.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
      </Style>

      <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
      </Style>

      <!-- Small neutral pill for the (white) status bar -->
      <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Br.Text}" />
        <Setter Property="MinWidth" Value="26" />
      </Style>

      <!-- White ghost pill for the purple header toolbar -->
      <Style x:Key="HeaderPillButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
