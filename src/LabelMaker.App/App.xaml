<Application x:Class="LabelMaker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LabelMaker.App.Mvvm"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
      <conv:InverseBoolToVisibilityConverter x:Key="InverseBool" />
      <SolidColorBrush x:Key="PanelBackground" Color="#F3F3F3" />
      <SolidColorBrush x:Key="PanelBorder" Color="#D0D0D0" />
      <SolidColorBrush x:Key="CanvasBackground" Color="#3A3D41" />

      <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="4" />
      </Style>

      <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Foreground" Value="#404040" />
      </Style>

      <Style x:Key="NumberBox" TargetType="TextBox">
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
      </Style>

      <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinWidth" Value="30" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
