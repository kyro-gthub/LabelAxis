<!--
  Every style, brush, converter and icon the app's windows share. App.xaml merges this one
  dictionary; keeping it separate lets other hosts (tools, previews) load the look of the app
  without starting the app itself.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:LabelMaker.App.Mvvm">
  <ResourceDictionary.MergedDictionaries>
    <!-- The glass theme tokens (LA.*; ThemeManager swaps them) and the glass control styles. -->
    <ResourceDictionary Source="Themes/Theme.Frost.xaml" />
    <ResourceDictionary Source="Themes/LabelAxis.Styles.xaml" />
    <ResourceDictionary Source="Theme.xaml" />
    <ResourceDictionary Source="Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
  <conv:InverseBoolToVisibilityConverter x:Key="InverseBool" />
  <conv:IntEqualsConverter x:Key="IntEquals" />
  <conv:IntEqualsVisibilityConverter x:Key="IntEqualsVis" />
  <conv:NotNullConverter x:Key="NotNullVis" />
  <conv:LockIconConverter x:Key="LockIcon" />
  <conv:IconLookupConverter x:Key="IconLookup" />
  <conv:HexBrushConverter x:Key="HexBrush" />

  <!-- A theme as the pickers show it: a swatch of its background with its three accent colours, its name and Dark / Light. -->
  <DataTemplate x:Key="ThemeRow">
    <DockPanel Height="38">
      <Border DockPanel.Dock="Left" Width="34" Height="24" CornerRadius="7" Background="{Binding BackgroundBrush}"
              BorderBrush="{DynamicResource Br.BorderStrong}" BorderThickness="1" ClipToBounds="True" Margin="0,0,10,0">
        <Canvas>
          <Ellipse Canvas.Left="3" Canvas.Top="3" Width="12" Height="12" Fill="{Binding AccentBrush}" />
          <Ellipse Canvas.Left="11" Canvas.Top="7" Width="12" Height="12" Fill="{Binding AccentSecondaryBrush}" />
          <Ellipse Canvas.Left="19" Canvas.Top="3" Width="9" Height="9" Fill="{Binding AccentTertiaryBrush}" />
        </Canvas>
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Name}" FontSize="12.5" />
        <TextBlock Text="{Binding Mode}" FontSize="10.5" Foreground="{DynamicResource Br.TextMuted}" />
      </StackPanel>
    </DockPanel>
  </DataTemplate>

  <!-- Aliases kept for MainWindow.xaml -->
  <SolidColorBrush x:Key="PanelBackground" Color="{DynamicResource Clr.Bg}" />
  <SolidColorBrush x:Key="PanelBorder" Color="{DynamicResource Clr.Border}" />
  <SolidColorBrush x:Key="CanvasBackground" Color="{DynamicResource Clr.Surface}" />

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Foreground" Value="{DynamicResource Br.TextMuted}" />
    <Setter Property="FontSize" Value="12" />
    <!-- Labels have a set width so the boxes beside them line up; a longer translation goes onto
         a second line instead of being cut off. -->
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
  </Style>

  <!-- Small neutral pill for the (white) status bar -->
  <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
    <Setter Property="MinWidth" Value="26" />
  </Style>

  <!-- White ghost pill (kept for any dark-background surface, e.g. dialogs) -->
  <Style x:Key="HeaderPillButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}" />

  <!-- Segmented toggle strip item, e.g. Templates|Pages, Design|Sheet Preview, General|Style|Position|Data -->
  <Style x:Key="SegmentTab" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UiSemiBold}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Br.Text2}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.AccentGradient}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="False" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Br.Bg}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Underline-style sub-tab, e.g. the Templates / Pages label row -->
  <Style x:Key="UnderlineTab" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UiSemiBold}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Br.TextMuted}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" BorderThickness="0,0,0,2.5" BorderBrush="Transparent" Padding="0,0,0,8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Br.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource Br.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
