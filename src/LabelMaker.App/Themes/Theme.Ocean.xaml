<!-- LabelAxis theme: Ocean (light). Generated from labelaxis-themes.json. Consume brushes with {DynamicResource ...}. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <sys:String x:Key="LA.ThemeId">ocean</sys:String>
  <sys:String x:Key="LA.ThemeName">Ocean</sys:String>
  <sys:Boolean x:Key="LA.IsDark">False</sys:Boolean>
  <sys:Double x:Key="LA.OrbOpacity">0.38</sys:Double>
  <sys:Double x:Key="LA.OrbOpacitySoft">0.18</sys:Double>

  <!-- Colors -->
  <Color x:Key="LA.Color.Background">#FFE6F1F2</Color>
  <Color x:Key="LA.Color.TextPrimary">#FF10262B</Color>
  <Color x:Key="LA.Color.TextSecondary">#FF3E5960</Color>
  <Color x:Key="LA.Color.TextTertiary">#FF5D777E</Color>
  <Color x:Key="LA.Color.Accent">#FF0E7F7B</Color>
  <Color x:Key="LA.Color.AccentSecondary">#FF2F6FD6</Color>
  <Color x:Key="LA.Color.AccentTertiary">#FF5CC8B4</Color>
  <Color x:Key="LA.Color.OnAccent">#FFFFFFFF</Color>
  <Color x:Key="LA.Color.Success">#FF2E8B5A</Color>
  <Color x:Key="LA.Color.Danger">#FFC8393A</Color>
  <Color x:Key="LA.Color.GlassFill">#75FFFFFF</Color>
  <Color x:Key="LA.Color.GlassFillHover">#BFFFFFFF</Color>
  <Color x:Key="LA.Color.GlassBorder">#1710262B</Color>
  <Color x:Key="LA.Color.GlassBorderStrong">#3810262B</Color>
  <Color x:Key="LA.Color.GlassHighlight">#E6FFFFFF</Color>
  <Color x:Key="LA.Color.FieldFill">#8CFFFFFF</Color>
  <Color x:Key="LA.Color.CanvasWell">#1210262B</Color>
  <Color x:Key="LA.Color.GridDot">#1A10262B</Color>
  <Color x:Key="LA.Color.PopupFill">#E0FFFFFF</Color>
  <Color x:Key="LA.Color.Shadow">#4010262B</Color>
  <Color x:Key="LA.Color.AccentSubtle">#240E7F7B</Color>
  <Color x:Key="LA.Color.AccentBorder">#590E7F7B</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="LA.Brush.AccentSubtle" Color="{StaticResource LA.Color.AccentSubtle}"/>
  <SolidColorBrush x:Key="LA.Brush.AccentBorder" Color="{StaticResource LA.Color.AccentBorder}"/>
  <SolidColorBrush x:Key="LA.Brush.Background" Color="{StaticResource LA.Color.Background}"/>
  <SolidColorBrush x:Key="LA.Brush.TextPrimary" Color="{StaticResource LA.Color.TextPrimary}"/>
  <SolidColorBrush x:Key="LA.Brush.TextSecondary" Color="{StaticResource LA.Color.TextSecondary}"/>
  <SolidColorBrush x:Key="LA.Brush.TextTertiary" Color="{StaticResource LA.Color.TextTertiary}"/>
  <SolidColorBrush x:Key="LA.Brush.Accent" Color="{StaticResource LA.Color.Accent}"/>
  <SolidColorBrush x:Key="LA.Brush.AccentSecondary" Color="{StaticResource LA.Color.AccentSecondary}"/>
  <SolidColorBrush x:Key="LA.Brush.AccentTertiary" Color="{StaticResource LA.Color.AccentTertiary}"/>
  <SolidColorBrush x:Key="LA.Brush.OnAccent" Color="{StaticResource LA.Color.OnAccent}"/>
  <SolidColorBrush x:Key="LA.Brush.Success" Color="{StaticResource LA.Color.Success}"/>
  <SolidColorBrush x:Key="LA.Brush.Danger" Color="{StaticResource LA.Color.Danger}"/>
  <SolidColorBrush x:Key="LA.Brush.GlassFill" Color="{StaticResource LA.Color.GlassFill}"/>
  <SolidColorBrush x:Key="LA.Brush.GlassFillHover" Color="{StaticResource LA.Color.GlassFillHover}"/>
  <SolidColorBrush x:Key="LA.Brush.GlassBorder" Color="{StaticResource LA.Color.GlassBorder}"/>
  <SolidColorBrush x:Key="LA.Brush.GlassBorderStrong" Color="{StaticResource LA.Color.GlassBorderStrong}"/>
  <SolidColorBrush x:Key="LA.Brush.GlassHighlight" Color="{StaticResource LA.Color.GlassHighlight}"/>
  <SolidColorBrush x:Key="LA.Brush.FieldFill" Color="{StaticResource LA.Color.FieldFill}"/>
  <SolidColorBrush x:Key="LA.Brush.CanvasWell" Color="{StaticResource LA.Color.CanvasWell}"/>
  <SolidColorBrush x:Key="LA.Brush.GridDot" Color="{StaticResource LA.Color.GridDot}"/>
  <SolidColorBrush x:Key="LA.Brush.PopupFill" Color="{StaticResource LA.Color.PopupFill}"/>
  <SolidColorBrush x:Key="LA.Brush.Shadow" Color="{StaticResource LA.Color.Shadow}"/>

  <LinearGradientBrush x:Key="LA.Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource LA.Color.Accent}" Offset="0"/>
    <GradientStop Color="{StaticResource LA.Color.AccentSecondary}" Offset="1"/>
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="LA.Brush.Orb1">
    <GradientStop Color="#FF0E7F7B" Offset="0"/>
    <GradientStop Color="#000E7F7B" Offset="0.66"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="LA.Brush.Orb2">
    <GradientStop Color="#FF2F6FD6" Offset="0"/>
    <GradientStop Color="#002F6FD6" Offset="0.66"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="LA.Brush.Orb3">
    <GradientStop Color="#FF5CC8B4" Offset="0"/>
    <GradientStop Color="#005CC8B4" Offset="0.66"/>
  </RadialGradientBrush>
</ResourceDictionary>
