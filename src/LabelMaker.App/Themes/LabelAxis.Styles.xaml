<!-- LabelAxis glass control styles. Theme-independent: every color comes from the active Theme.*.xaml via DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <FontFamily x:Key="LA.Font.Sans">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="LA.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <CornerRadius x:Key="LA.Radius.Panel">18</CornerRadius>
  <CornerRadius x:Key="LA.Radius.Card">13</CornerRadius>
  <CornerRadius x:Key="LA.Radius.Control">9</CornerRadius>
  <CornerRadius x:Key="LA.Radius.Chip">8</CornerRadius>

  <DropShadowEffect x:Key="LA.Effect.PanelShadow" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.28" Color="#000000"/>

  <!-- Large frosted panel: sidebars, ribbon, properties -->
  <Style x:Key="LA.GlassPanel" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource LA.Brush.GlassFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LA.Brush.GlassBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource LA.Radius.Panel}"/>
    <Setter Property="Padding" Value="10"/>
    <Setter Property="Effect" Value="{StaticResource LA.Effect.PanelShadow}"/>
  </Style>

  <!-- 1px inner top highlight; place as first child inside a GlassPanel Grid -->
  <Style x:Key="LA.GlassHighlight" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Margin" Value="14,0"/>
    <Setter Property="Background" Value="{DynamicResource LA.Brush.GlassHighlight}"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>

  <!-- Accordion / list card inside panels -->
  <Style x:Key="LA.GlassCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource LA.Brush.GlassFillHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LA.Brush.GlassBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource LA.Radius.Card}"/>
    <Setter Property="Padding" Value="12"/>
  </Style>

  <Style x:Key="LA.Text.Base" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource LA.Font.Sans}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource LA.Brush.TextPrimary}"/>
  </Style>
  <Style x:Key="LA.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource LA.Text.Base}">
    <Setter Property="Foreground" Value="{DynamicResource LA.Brush.TextSecondary}"/>
  </Style>
  <Style x:Key="LA.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource LA.Text.Base}">
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="Foreground" Value="{DynamicResource LA.Brush.TextTertiary}"/>
  </Style>
  <Style x:Key="LA.Text.Section" TargetType="TextBlock" BasedOn="{StaticResource LA.Text.Base}">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="LA.Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource LA.Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource LA.Font.Mono}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- Primary action (Print) -->
  <Style x:Key="LA.Button.Primary" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource LA.Brush.OnAccent}"/>
    <Setter Property="Background" Value="{DynamicResource LA.Brush.Accent}"/>
    <Setter Property="FontFamily" Value="{StaticResource LA.Font.Sans}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="18,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.92"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.82"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Secondary action (Preview, Import) -->
  <Style x:Key="LA.Button.Glass" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource LA.Brush.TextPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource LA.Brush.GlassFillHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LA.Brush.GlassBorder}"/>
    <Setter Property="FontFamily" Value="{StaticResource LA.Font.Sans}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LA.Brush.GlassBorderStrong}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Ribbon tool (Select, Text, Barcode...). Use RadioButton with a shared GroupName; Content = StackPanel(icon, label) -->
  <Style x:Key="LA.RibbonTool" TargetType="RadioButton">
    <Setter Property="Width" Value="62"/>
    <Setter Property="Height" Value="52"/>
    <Setter Property="Foreground" Value="{DynamicResource LA.Brush.TextSecondary}"/>
    <Setter Property="FontFamily" Value="{StaticResource LA.Font.Sans}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource LA.Brush.GlassFillHover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LA.Brush.GlassFillHover}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LA.Brush.GlassBorder}"/>
              <Setter Property="Foreground" Value="{DynamicResource LA.Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented tabs (Pages | Data, Properties | Layers | Page). Wrap RadioButtons in a Border with LA.Segmented.Track -->
  <Style x:Key="LA.Segmented.Track" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource LA.Brush.FieldFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LA.Brush.GlassBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="3"/>
  </Style>
  <Style x:Key="LA.Segmented.Item" TargetType="RadioButton">
    <Setter Property="Height" Value="28"/>
    <Setter Property="Foreground" Value="{DynamicResource LA.Brush.TextTertiary}"/>
    <Setter Property="FontFamily" Value="{StaticResource LA.Font.Sans}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LA.Brush.GlassFillHover}"/>
              <Setter Property="Foreground" Value="{DynamicResource LA.Brush.TextPrimary}"/>
              <Setter Property="FontWeight" Value="Medium"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Canvas toolbar chips (Rulers, Guides, Grid, Snap to ...) -->
  <Style x:Key="LA.Chip" TargetType="ToggleButton">
    <Setter Property="Height" Value="26"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Foreground" Value="{DynamicResource LA.Brush.TextSecondary}"/>
    <Setter Property="FontFamily" Value="{StaticResource LA.Font.Sans}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LA.Brush.AccentSubtle}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LA.Brush.AccentBorder}"/>
              <Setter Property="Foreground" Value="{DynamicResource LA.Brush.Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Inputs (X/Y/W/H, font size, data binding) -->
  <Style x:Key="LA.TextBox.Field" TargetType="TextBox">
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource LA.Brush.TextPrimary}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource LA.Brush.Accent}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource LA.Brush.Accent}"/>
    <Setter Property="FontFamily" Value="{StaticResource LA.Font.Mono}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{DynamicResource LA.Brush.FieldFill}" BorderBrush="{DynamicResource LA.Brush.GlassBorder}" BorderThickness="1" CornerRadius="9">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LA.Brush.Accent}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
